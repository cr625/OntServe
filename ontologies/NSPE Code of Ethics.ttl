@prefix dct: <http://purl.org/dc/terms/> .
@prefix nspe: <http://proethica.org/ontology/nspe#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix proeth-core: <http://proethica.org/ontology/core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://proethica.org/ontology/nspe> a owl:Ontology ;
    rdfs:label "NSPE Code of Ethics Ontology"@en ;
    dct:created "2026-05-26"^^xsd:date ;
    dct:description "Ontology representation of the NSPE Code of Ethics (rev. July 2019, Pub. #1102). Provisions are CodeProvision information content entities that establish the Principles, Obligations, and Constraints (directive information entities) derived from them, following the proeth-core CodeProvision extension and the BFO/IAO alignment in dissertation chapter 3.6.4."@en ;
    dct:source <https://www.nspe.org/resources/ethics/code-ethics> ;
    dct:title "National Society of Professional Engineers Code of Ethics"@en ;
    owl:imports <http://proethica.org/ontology/intermediate> .

nspe:III_1_a a proeth-core:CodeProvision,
        owl:NamedIndividual ;
    rdfs:label "Professional Obligations III.1.a"@en ;
    proeth-core:establishes <http://proethica.org/ontology/constraints#Non_Deception>,
        <http://proethica.org/ontology/obligations#Error_Acknowledgment>,
        <http://proethica.org/ontology/principles#Intellectual_Honesty> ;
    proeth-core:partOfGuideline nspe:NSPECodeOfEthics ;
    dct:identifier "III.1.a" ;
    dct:isPartOf nspe:III_1 ;
    skos:definition "Engineers shall acknowledge their errors and shall not distort or alter the facts."@en .

nspe:III_1_b a proeth-core:CodeProvision,
        owl:NamedIndividual ;
    rdfs:label "Professional Obligations III.1.b"@en ;
    proeth-core:establishes <http://proethica.org/ontology/obligations#Disclosure>,
        <http://proethica.org/ontology/obligations#Faithful_Agency>,
        <http://proethica.org/ontology/principles#Honesty> ;
    proeth-core:partOfGuideline nspe:NSPECodeOfEthics ;
    dct:identifier "III.1.b" ;
    dct:isPartOf nspe:III_1 ;
    skos:definition "Engineers shall advise their clients or employers when they believe a project will not be successful."@en .

nspe:III_1_c a proeth-core:CodeProvision,
        owl:NamedIndividual ;
    rdfs:label "Professional Obligations III.1.c"@en ;
    proeth-core:establishes <http://proethica.org/ontology/constraints#Conflict_of_Interest_Avoidance>,
        <http://proethica.org/ontology/obligations#Disclosure>,
        <http://proethica.org/ontology/obligations#Faithful_Agency>,
        <http://proethica.org/ontology/principles#Loyalty> ;
    proeth-core:partOfGuideline nspe:NSPECodeOfEthics ;
    dct:identifier "III.1.c" ;
    dct:isPartOf nspe:III_1 ;
    skos:definition "Engineers shall not accept outside employment to the detriment of their regular work or interest. Before accepting any outside engineering employment, they will notify their employers."@en .

nspe:III_1_d a proeth-core:CodeProvision,
        owl:NamedIndividual ;
    rdfs:label "Professional Obligations III.1.d"@en ;
    proeth-core:establishes <http://proethica.org/ontology/constraints#Non_Deception>,
        <http://proethica.org/ontology/constraints#Non_Solicitation>,
        <http://proethica.org/ontology/principles#Honesty> ;
    proeth-core:partOfGuideline nspe:NSPECodeOfEthics ;
    dct:identifier "III.1.d" ;
    dct:isPartOf nspe:III_1 ;
    skos:definition "Engineers shall not attempt to attract an engineer from another employer by false or misleading pretenses."@en .

nspe:III_1_e a proeth-core:CodeProvision,
        owl:NamedIndividual ;
    rdfs:label "Professional Obligations III.1.e"@en ;
    proeth-core:establishes <http://proethica.org/ontology/constraints#Conflict_of_Interest_Avoidance>,
        <http://proethica.org/ontology/principles#Integrity>,
        <http://proethica.org/ontology/principles#Professional_Dignity> ;
    proeth-core:partOfGuideline nspe:NSPECodeOfEthics ;
    dct:identifier "III.1.e" ;
    dct:isPartOf nspe:III_1 ;
    skos:definition "Engineers shall not promote their own interest at the expense of the dignity and integrity of the profession."@en .

nspe:III_1_f a proeth-core:CodeProvision,
        owl:NamedIndividual ;
    rdfs:label "Professional Obligations III.1.f"@en ;
    proeth-core:establishes <http://proethica.org/ontology/constraints#Non_Discrimination>,
        <http://proethica.org/ontology/obligations#Ethical_Conduct>,
        <http://proethica.org/ontology/principles#Professional_Dignity> ;
    proeth-core:partOfGuideline nspe:NSPECodeOfEthics ;
    dct:identifier "III.1.f" ;
    dct:isPartOf nspe:III_1 ;
    skos:definition "Engineers shall treat all persons with dignity, respect, fairness, and without discrimination."@en .

nspe:III_2_a a proeth-core:CodeProvision,
        owl:NamedIndividual ;
    rdfs:label "Professional Obligations III.2.a"@en ;
    proeth-core:establishes <http://proethica.org/ontology/obligations#Civic_Engagement>,
        <http://proethica.org/ontology/principles#Public_Safety>,
        <http://proethica.org/ontology/principles#Public_Welfare> ;
    proeth-core:partOfGuideline nspe:NSPECodeOfEthics ;
    dct:identifier "III.2.a" ;
    dct:isPartOf nspe:III_2 ;
    skos:definition "Engineers are encouraged to participate in civic affairs; career guidance for youths; and work for the advancement of the safety, health, and well-being of their community."@en .

nspe:III_2_b a proeth-core:CodeProvision,
        owl:NamedIndividual ;
    rdfs:label "Professional Obligations III.2.b"@en ;
    proeth-core:establishes <http://proethica.org/ontology/constraints#Scope_of_Practice>,
        <http://proethica.org/ontology/obligations#Duty_to_Report>,
        <http://proethica.org/ontology/obligations#Standards_Compliance> ;
    proeth-core:partOfGuideline nspe:NSPECodeOfEthics ;
    dct:identifier "III.2.b" ;
    dct:isPartOf nspe:III_2 ;
    skos:definition "Engineers shall not complete, sign, or seal plans and/or specifications that are not in conformity with applicable engineering standards. If the client or employer insists on such unprofessional conduct, they shall notify the proper authorities and withdraw from further service on the project."@en .

nspe:III_2_c a proeth-core:CodeProvision,
        owl:NamedIndividual ;
    rdfs:label "Professional Obligations III.2.c"@en ;
    proeth-core:establishes <http://proethica.org/ontology/obligations#Civic_Engagement>,
        <http://proethica.org/ontology/principles#Public_Welfare> ;
    proeth-core:partOfGuideline nspe:NSPECodeOfEthics ;
    dct:identifier "III.2.c" ;
    dct:isPartOf nspe:III_2 ;
    skos:definition "Engineers are encouraged to extend public knowledge and appreciation of engineering and its achievements."@en .

nspe:III_2_d a proeth-core:CodeProvision,
        owl:NamedIndividual ;
    rdfs:label "Professional Obligations III.2.d"@en ;
    proeth-core:establishes <http://proethica.org/ontology/principles#Public_Welfare>,
        <http://proethica.org/ontology/principles#Sustainability> ;
    proeth-core:partOfGuideline nspe:NSPECodeOfEthics ;
    dct:identifier "III.2.d" ;
    dct:isPartOf nspe:III_2 ;
    skos:definition "Engineers are encouraged to adhere to the principles of sustainable development in order to protect the environment for future generations."@en .

nspe:III_2_e a proeth-core:CodeProvision,
        owl:NamedIndividual ;
    rdfs:label "Professional Obligations III.2.e"@en ;
    proeth-core:establishes <http://proethica.org/ontology/obligations#Continuing_Education>,
        <http://proethica.org/ontology/principles#Professional_Competence> ;
    proeth-core:partOfGuideline nspe:NSPECodeOfEthics ;
    dct:identifier "III.2.e" ;
    dct:isPartOf nspe:III_2 ;
    skos:definition "Engineers shall continue their professional development throughout their careers and should keep current in their specialty fields by engaging in professional practice, participating in continuing education courses, reading in the technical literature, and attending professional meetings and seminar."@en .

nspe:III_3_a a proeth-core:CodeProvision,
        owl:NamedIndividual ;
    rdfs:label "Professional Obligations III.3.a"@en ;
    proeth-core:establishes <http://proethica.org/ontology/constraints#Non_Deception>,
        <http://proethica.org/ontology/obligations#Disclosure>,
        <http://proethica.org/ontology/principles#Truthfulness> ;
    proeth-core:partOfGuideline nspe:NSPECodeOfEthics ;
    dct:identifier "III.3.a" ;
    dct:isPartOf nspe:III_3 ;
    skos:definition "Engineers shall avoid the use of statements containing a material misrepresentation of fact or omitting a material fact."@en .

nspe:III_3_b a proeth-core:CodeProvision,
        owl:NamedIndividual ;
    rdfs:label "Professional Obligations III.3.b"@en ;
    proeth-core:establishes <http://proethica.org/ontology/constraints#Non_Solicitation> ;
    proeth-core:partOfGuideline nspe:NSPECodeOfEthics ;
    dct:identifier "III.3.b" ;
    dct:isPartOf nspe:III_3 ;
    skos:definition "Consistent with the foregoing, engineers may advertise for recruitment of personnel."@en .

nspe:III_3_c a proeth-core:CodeProvision,
        owl:NamedIndividual ;
    rdfs:label "Professional Obligations III.3.c"@en ;
    proeth-core:establishes <http://proethica.org/ontology/constraints#Credit_Attribution>,
        <http://proethica.org/ontology/constraints#Non_Deception>,
        <http://proethica.org/ontology/principles#Honesty> ;
    proeth-core:partOfGuideline nspe:NSPECodeOfEthics ;
    dct:identifier "III.3.c" ;
    dct:isPartOf nspe:III_3 ;
    skos:definition "Consistent with the foregoing, engineers may prepare articles for the lay or technical press, but such articles shall not imply credit to the author for work performed by others."@en .

nspe:III_4_a a proeth-core:CodeProvision,
        owl:NamedIndividual ;
    rdfs:label "Professional Obligations III.4.a"@en ;
    proeth-core:establishes <http://proethica.org/ontology/constraints#Conflict_of_Interest_Avoidance>,
        <http://proethica.org/ontology/obligations#Faithful_Agency>,
        <http://proethica.org/ontology/principles#Confidentiality> ;
    proeth-core:partOfGuideline nspe:NSPECodeOfEthics ;
    dct:identifier "III.4.a" ;
    dct:isPartOf nspe:III_4 ;
    skos:definition "Engineers shall not, without the consent of all interested parties, promote or arrange for new employment or practice in connection with a specific project for which the engineer has gained particular and specialized knowledge."@en .

nspe:III_4_b a proeth-core:CodeProvision,
        owl:NamedIndividual ;
    rdfs:label "Professional Obligations III.4.b"@en ;
    proeth-core:establishes <http://proethica.org/ontology/constraints#Conflict_of_Interest_Avoidance>,
        <http://proethica.org/ontology/obligations#Confidentiality>,
        <http://proethica.org/ontology/obligations#Faithful_Agency> ;
    proeth-core:partOfGuideline nspe:NSPECodeOfEthics ;
    dct:identifier "III.4.b" ;
    dct:isPartOf nspe:III_4 ;
    skos:definition "Engineers shall not, without the consent of all interested parties, participate in or represent an adversary interest in connection with a specific project or proceeding in which the engineer has gained particular specialized knowledge on behalf of a former client or employer."@en .

nspe:III_5_a a proeth-core:CodeProvision,
        owl:NamedIndividual ;
    rdfs:label "Professional Obligations III.5.a"@en ;
    proeth-core:establishes <http://proethica.org/ontology/constraints#Conflict_of_Interest_Avoidance>,
        <http://proethica.org/ontology/principles#Integrity>,
        <http://proethica.org/ontology/principles#Objectivity> ;
    proeth-core:partOfGuideline nspe:NSPECodeOfEthics ;
    dct:identifier "III.5.a" ;
    dct:isPartOf nspe:III_5 ;
    skos:definition "Engineers shall not accept financial or other considerations, including free engineering designs, from material or equipment suppliers for specifying their product."@en .

nspe:III_5_b a proeth-core:CodeProvision,
        owl:NamedIndividual ;
    rdfs:label "Professional Obligations III.5.b"@en ;
    proeth-core:establishes <http://proethica.org/ontology/constraints#Anti_Corruption>,
        <http://proethica.org/ontology/constraints#Conflict_of_Interest_Avoidance>,
        <http://proethica.org/ontology/obligations#Faithful_Agency> ;
    proeth-core:partOfGuideline nspe:NSPECodeOfEthics ;
    dct:identifier "III.5.b" ;
    dct:isPartOf nspe:III_5 ;
    skos:definition "Engineers shall not accept commissions or allowances, directly or indirectly, from contractors or other parties dealing with clients or employers of the engineer in connection with work for which the engineer is responsible."@en .

nspe:III_6_a a proeth-core:CodeProvision,
        owl:NamedIndividual ;
    rdfs:label "Professional Obligations III.6.a"@en ;
    proeth-core:establishes <http://proethica.org/ontology/constraints#Anti_Corruption>,
        <http://proethica.org/ontology/constraints#Conflict_of_Interest_Avoidance>,
        <http://proethica.org/ontology/principles#Objectivity> ;
    proeth-core:partOfGuideline nspe:NSPECodeOfEthics ;
    dct:identifier "III.6.a" ;
    dct:isPartOf nspe:III_6 ;
    skos:definition "Engineers shall not request, propose, or accept a commission on a contingent basis under circumstances in which their judgment may be compromised."@en .

nspe:III_6_b a proeth-core:CodeProvision,
        owl:NamedIndividual ;
    rdfs:label "Professional Obligations III.6.b"@en ;
    proeth-core:establishes <http://proethica.org/ontology/constraints#Conflict_of_Interest_Avoidance>,
        <http://proethica.org/ontology/obligations#Ethical_Conduct>,
        <http://proethica.org/ontology/principles#Loyal_Agency> ;
    proeth-core:partOfGuideline nspe:NSPECodeOfEthics ;
    dct:identifier "III.6.b" ;
    dct:isPartOf nspe:III_6 ;
    skos:definition "Engineers in salaried positions shall accept part-time engineering work only to the extent consistent with policies of the employer and in accordance with ethical considerations."@en .

nspe:III_6_c a proeth-core:CodeProvision,
        owl:NamedIndividual ;
    rdfs:label "Professional Obligations III.6.c"@en ;
    proeth-core:establishes <http://proethica.org/ontology/constraints#Conflict_of_Interest_Avoidance>,
        <http://proethica.org/ontology/obligations#Faithful_Agency>,
        <http://proethica.org/ontology/principles#Loyal_Agency> ;
    proeth-core:partOfGuideline nspe:NSPECodeOfEthics ;
    dct:identifier "III.6.c" ;
    dct:isPartOf nspe:III_6 ;
    skos:definition "Engineers shall not, without consent, use equipment, supplies, laboratory, or office facilities of an employer to carry on outside private practice."@en .

nspe:III_7_a a proeth-core:CodeProvision,
        owl:NamedIndividual ;
    rdfs:label "Professional Obligations III.7.a"@en ;
    proeth-core:establishes <http://proethica.org/ontology/constraints#Conflict_of_Interest_Avoidance>,
        <http://proethica.org/ontology/constraints#Peer_Review_Transparency>,
        <http://proethica.org/ontology/principles#Professional_Dignity> ;
    proeth-core:partOfGuideline nspe:NSPECodeOfEthics ;
    dct:identifier "III.7.a" ;
    dct:isPartOf nspe:III_7 ;
    skos:definition "Engineers in private practice shall not review the work of another engineer for the same client, except with the knowledge of such engineer, or unless the connection of such engineer with the work has been terminated."@en .

nspe:III_7_b a proeth-core:CodeProvision,
        owl:NamedIndividual ;
    rdfs:label "Professional Obligations III.7.b"@en ;
    proeth-core:establishes <http://proethica.org/ontology/obligations#Peer_Review_Authority>,
        <http://proethica.org/ontology/principles#Professional_Accountability> ;
    proeth-core:partOfGuideline nspe:NSPECodeOfEthics ;
    dct:identifier "III.7.b" ;
    dct:isPartOf nspe:III_7 ;
    skos:definition "Engineers in governmental, industrial, or educational employ are entitled to review and evaluate the work of other engineers when so required by their employment duties."@en .

nspe:III_7_c a proeth-core:CodeProvision,
        owl:NamedIndividual ;
    rdfs:label "Professional Obligations III.7.c"@en ;
    proeth-core:establishes <http://proethica.org/ontology/obligations#Comparative_Analysis_Authority>,
        <http://proethica.org/ontology/principles#Professional_Competence>,
        <http://proethica.org/ontology/principles#Truthfulness> ;
    proeth-core:partOfGuideline nspe:NSPECodeOfEthics ;
    dct:identifier "III.7.c" ;
    dct:isPartOf nspe:III_7 ;
    skos:definition "Engineers in sales or industrial employ are entitled to make engineering comparisons of represented products with products of other suppliers."@en .

nspe:III_8_a a proeth-core:CodeProvision,
        owl:NamedIndividual ;
    rdfs:label "Professional Obligations III.8.a"@en ;
    proeth-core:establishes <http://proethica.org/ontology/constraints#Scope_of_Practice>,
        <http://proethica.org/ontology/obligations#Standards_Compliance> ;
    proeth-core:partOfGuideline nspe:NSPECodeOfEthics ;
    dct:identifier "III.8.a" ;
    dct:isPartOf nspe:III_8 ;
    skos:definition "Engineers shall conform with state registration laws in the practice of engineering."@en .

nspe:III_8_b a proeth-core:CodeProvision,
        owl:NamedIndividual ;
    rdfs:label "Professional Obligations III.8.b"@en ;
    proeth-core:establishes <http://proethica.org/ontology/constraints#Non_Deception>,
        <http://proethica.org/ontology/obligations#Ethical_Conduct>,
        <http://proethica.org/ontology/principles#Integrity> ;
    proeth-core:partOfGuideline nspe:NSPECodeOfEthics ;
    dct:identifier "III.8.b" ;
    dct:isPartOf nspe:III_8 ;
    skos:definition "Engineers shall not use association with a nonengineer, a corporation, or partnership as a \"cloak\" for unethical acts."@en .

nspe:III_9_a a proeth-core:CodeProvision,
        owl:NamedIndividual ;
    rdfs:label "Professional Obligations III.9.a"@en ;
    proeth-core:establishes <http://proethica.org/ontology/constraints#Credit_Attribution>,
        <http://proethica.org/ontology/principles#Honesty>,
        <http://proethica.org/ontology/principles#Professional_Dignity> ;
    proeth-core:partOfGuideline nspe:NSPECodeOfEthics ;
    dct:identifier "III.9.a" ;
    dct:isPartOf nspe:III_9 ;
    skos:definition "Engineers shall, whenever possible, name the person or persons who may be individually responsible for designs, inventions, writings, or other accomplishments."@en .

nspe:III_9_b a proeth-core:CodeProvision,
        owl:NamedIndividual ;
    rdfs:label "Professional Obligations III.9.b"@en ;
    proeth-core:establishes <http://proethica.org/ontology/constraints#Intellectual_Property_Protection>,
        <http://proethica.org/ontology/obligations#Client_Privacy>,
        <http://proethica.org/ontology/obligations#Faithful_Agency> ;
    proeth-core:partOfGuideline nspe:NSPECodeOfEthics ;
    dct:identifier "III.9.b" ;
    dct:isPartOf nspe:III_9 ;
    skos:definition "Engineers using designs supplied by a client recognize that the designs remain the property of the client and may not be duplicated by the engineer for others without express permission."@en .

nspe:III_9_c a proeth-core:CodeProvision,
        owl:NamedIndividual ;
    rdfs:label "Professional Obligations III.9.c"@en ;
    proeth-core:establishes <http://proethica.org/ontology/constraints#Intellectual_Property_Protection>,
        <http://proethica.org/ontology/obligations#Disclosure>,
        <http://proethica.org/ontology/obligations#Ownership_Agreement> ;
    proeth-core:partOfGuideline nspe:NSPECodeOfEthics ;
    dct:identifier "III.9.c" ;
    dct:isPartOf nspe:III_9 ;
    skos:definition "Engineers, before undertaking work for others in connection with which the engineer may make improvements, plans, designs, inventions, or other records that may justify copyrights or patents, should enter into a positive agreement regarding ownership."@en .

nspe:III_9_d a proeth-core:CodeProvision,
        owl:NamedIndividual ;
    rdfs:label "Professional Obligations III.9.d"@en ;
    proeth-core:establishes <http://proethica.org/ontology/constraints#Intellectual_Property_Protection>,
        <http://proethica.org/ontology/obligations#Employer_Indemnification>,
        <http://proethica.org/ontology/obligations#Faithful_Agency> ;
    proeth-core:partOfGuideline nspe:NSPECodeOfEthics ;
    dct:identifier "III.9.d" ;
    dct:isPartOf nspe:III_9 ;
    skos:definition "Engineers' designs, data, records, and notes referring exclusively to an employer's work are the employer's property. The employer should indemnify the engineer for use of the information for any purpose other than the original purpose."@en .

nspe:II_1_a a proeth-core:CodeProvision,
        owl:NamedIndividual ;
    rdfs:label "Rules of Practice II.1.a"@en ;
    proeth-core:establishes <http://proethica.org/ontology/obligations#Disclosure>,
        <http://proethica.org/ontology/obligations#Duty_to_Report>,
        <http://proethica.org/ontology/principles#Public_Safety> ;
    proeth-core:partOfGuideline nspe:NSPECodeOfEthics ;
    dct:identifier "II.1.a" ;
    dct:isPartOf nspe:II_1 ;
    skos:definition "If engineers' judgment is overruled under circumstances that endanger life or property, they shall notify their employer or client and such other authority as may be appropriate."@en .

nspe:II_1_b a proeth-core:CodeProvision,
        owl:NamedIndividual ;
    rdfs:label "Rules of Practice II.1.b"@en ;
    proeth-core:establishes <http://proethica.org/ontology/constraints#Scope_of_Practice>,
        <http://proethica.org/ontology/obligations#Standards_Compliance>,
        <http://proethica.org/ontology/principles#Professional_Competence> ;
    proeth-core:partOfGuideline nspe:NSPECodeOfEthics ;
    dct:identifier "II.1.b" ;
    dct:isPartOf nspe:II_1 ;
    skos:definition "Engineers shall approve only those engineering documents that are in conformity with applicable standards."@en .

nspe:II_1_c a proeth-core:CodeProvision,
        owl:NamedIndividual ;
    rdfs:label "Rules of Practice II.1.c"@en ;
    proeth-core:establishes <http://proethica.org/ontology/obligations#Client_Privacy>,
        <http://proethica.org/ontology/principles#Confidentiality> ;
    proeth-core:partOfGuideline nspe:NSPECodeOfEthics ;
    dct:identifier "II.1.c" ;
    dct:isPartOf nspe:II_1 ;
    skos:definition "Engineers shall not reveal facts, data, or information without the prior consent of the client or employer except as authorized or required by law or this Code."@en .

nspe:II_1_d a proeth-core:CodeProvision,
        owl:NamedIndividual ;
    rdfs:label "Rules of Practice II.1.d"@en ;
    proeth-core:establishes <http://proethica.org/ontology/constraints#Conflict_of_Interest_Avoidance>,
        <http://proethica.org/ontology/constraints#Non_Deception>,
        <http://proethica.org/ontology/principles#Integrity> ;
    proeth-core:partOfGuideline nspe:NSPECodeOfEthics ;
    dct:identifier "II.1.d" ;
    dct:isPartOf nspe:II_1 ;
    skos:definition "Engineers shall not permit the use of their name or associate in business ventures with any person or firm that they believe is engaged in fraudulent or dishonest enterprise."@en .

nspe:II_1_e a proeth-core:CodeProvision,
        owl:NamedIndividual ;
    rdfs:label "Rules of Practice II.1.e"@en ;
    proeth-core:establishes <http://proethica.org/ontology/constraints#Scope_of_Practice>,
        <http://proethica.org/ontology/obligations#Ethical_Conduct>,
        <http://proethica.org/ontology/principles#Integrity> ;
    proeth-core:partOfGuideline nspe:NSPECodeOfEthics ;
    dct:identifier "II.1.e" ;
    dct:isPartOf nspe:II_1 ;
    skos:definition "Engineers shall not aid or abet the unlawful practice of engineering by a person or firm."@en .

nspe:II_1_f a proeth-core:CodeProvision,
        owl:NamedIndividual ;
    rdfs:label "Rules of Practice II.1.f"@en ;
    proeth-core:establishes <http://proethica.org/ontology/obligations#Duty_to_Report>,
        <http://proethica.org/ontology/obligations#Reporting>,
        <http://proethica.org/ontology/principles#Professional_Accountability> ;
    proeth-core:partOfGuideline nspe:NSPECodeOfEthics ;
    dct:identifier "II.1.f" ;
    dct:isPartOf nspe:II_1 ;
    skos:definition "Engineers having knowledge of any alleged violation of this Code shall report thereon to appropriate professional bodies and, when relevant, also to public authorities, and cooperate with the proper authorities in furnishing such information or assistance as may be required."@en .

nspe:II_2_a a proeth-core:CodeProvision,
        owl:NamedIndividual ;
    rdfs:label "Rules of Practice II.2.a"@en ;
    proeth-core:establishes <http://proethica.org/ontology/constraints#Scope_of_Practice>,
        <http://proethica.org/ontology/obligations#Competence>,
        <http://proethica.org/ontology/principles#Professional_Competence> ;
    proeth-core:partOfGuideline nspe:NSPECodeOfEthics ;
    dct:identifier "II.2.a" ;
    dct:isPartOf nspe:II_2 ;
    skos:definition "Engineers shall undertake assignments only when qualified by education or experience in the specific technical fields involved."@en .

nspe:II_2_b a proeth-core:CodeProvision,
        owl:NamedIndividual ;
    rdfs:label "Rules of Practice II.2.b"@en ;
    proeth-core:establishes <http://proethica.org/ontology/constraints#Scope_of_Practice>,
        <http://proethica.org/ontology/constraints#Supervisory_Control>,
        <http://proethica.org/ontology/principles#Professional_Competence> ;
    proeth-core:partOfGuideline nspe:NSPECodeOfEthics ;
    dct:identifier "II.2.b" ;
    dct:isPartOf nspe:II_2 ;
    skos:definition "Engineers shall not affix their signatures to any plans or documents dealing with subject matter in which they lack competence, nor to any plan or document not prepared under their direction and control."@en .

nspe:II_2_c a proeth-core:CodeProvision,
        owl:NamedIndividual ;
    rdfs:label "Rules of Practice II.2.c"@en ;
    proeth-core:establishes <http://proethica.org/ontology/constraints#Credit_Attribution>,
        <http://proethica.org/ontology/constraints#Scope_of_Practice>,
        <http://proethica.org/ontology/principles#Professional_Competence> ;
    proeth-core:partOfGuideline nspe:NSPECodeOfEthics ;
    dct:identifier "II.2.c" ;
    dct:isPartOf nspe:II_2 ;
    skos:definition "Engineers may accept assignments and assume responsibility for coordination of an entire project and sign and seal the engineering documents for the entire project, provided that each technical segment is signed and sealed only by the qualified engineers who prepared the segment."@en .

nspe:II_3_a a proeth-core:CodeProvision,
        owl:NamedIndividual ;
    rdfs:label "Rules of Practice II.3.a"@en ;
    proeth-core:establishes <http://proethica.org/ontology/constraints#Non_Deception>,
        <http://proethica.org/ontology/obligations#Disclosure>,
        <http://proethica.org/ontology/principles#Objectivity>,
        <http://proethica.org/ontology/principles#Truthfulness> ;
    proeth-core:partOfGuideline nspe:NSPECodeOfEthics ;
    dct:identifier "II.3.a" ;
    dct:isPartOf nspe:II_3 ;
    skos:definition "Engineers shall be objective and truthful in professional reports, statements, or testimony. They shall include all relevant and pertinent information in such reports, statements, or testimony, which should bear the date indicating when it was current."@en .

nspe:II_3_b a proeth-core:CodeProvision,
        owl:NamedIndividual ;
    rdfs:label "Rules of Practice II.3.b"@en ;
    proeth-core:establishes <http://proethica.org/ontology/constraints#Scope_of_Practice>,
        <http://proethica.org/ontology/principles#Intellectual_Honesty>,
        <http://proethica.org/ontology/principles#Professional_Competence> ;
    proeth-core:partOfGuideline nspe:NSPECodeOfEthics ;
    dct:identifier "II.3.b" ;
    dct:isPartOf nspe:II_3 ;
    skos:definition "Engineers may express publicly technical opinions that are founded upon knowledge of the facts and competence in the subject matter."@en .

nspe:II_3_c a proeth-core:CodeProvision,
        owl:NamedIndividual ;
    rdfs:label "Rules of Practice II.3.c"@en ;
    proeth-core:establishes <http://proethica.org/ontology/constraints#Non_Deception>,
        <http://proethica.org/ontology/obligations#Conflict_Disclosure>,
        <http://proethica.org/ontology/principles#Transparency> ;
    proeth-core:partOfGuideline nspe:NSPECodeOfEthics ;
    dct:identifier "II.3.c" ;
    dct:isPartOf nspe:II_3 ;
    skos:definition "Engineers shall issue no statements, criticisms, or arguments on technical matters that are inspired or paid for by interested parties, unless they have prefaced their comments by explicitly identifying the interested parties on whose behalf they are speaking, and by revealing the existence of any interest the engineers may have in the matters."@en .

nspe:II_4_a a proeth-core:CodeProvision,
        owl:NamedIndividual ;
    rdfs:label "Rules of Practice II.4.a"@en ;
    proeth-core:establishes <http://proethica.org/ontology/constraints#Conflict_of_Interest_Avoidance>,
        <http://proethica.org/ontology/obligations#Conflict_Disclosure>,
        <http://proethica.org/ontology/principles#Transparency> ;
    proeth-core:partOfGuideline nspe:NSPECodeOfEthics ;
    dct:identifier "II.4.a" ;
    dct:isPartOf nspe:II_4 ;
    skos:definition "Engineers shall disclose all known or potential conflicts of interest that could influence or appear to influence their judgment or the quality of their services."@en .

nspe:II_4_b a proeth-core:CodeProvision,
        owl:NamedIndividual ;
    rdfs:label "Rules of Practice II.4.b"@en ;
    proeth-core:establishes <http://proethica.org/ontology/constraints#Conflict_of_Interest_Avoidance>,
        <http://proethica.org/ontology/obligations#Conflict_Disclosure>,
        <http://proethica.org/ontology/principles#Transparency> ;
    proeth-core:partOfGuideline nspe:NSPECodeOfEthics ;
    dct:identifier "II.4.b" ;
    dct:isPartOf nspe:II_4 ;
    skos:definition "Engineers shall not accept compensation, financial or otherwise, from more than one party for services on the same project, or for services pertaining to the same project, unless the circumstances are fully disclosed and agreed to by all interested parties."@en .

nspe:II_4_c a proeth-core:CodeProvision,
        owl:NamedIndividual ;
    rdfs:label "Rules of Practice II.4.c"@en ;
    proeth-core:establishes <http://proethica.org/ontology/constraints#Conflict_of_Interest_Avoidance>,
        <http://proethica.org/ontology/obligations#Faithful_Agency>,
        <http://proethica.org/ontology/principles#Integrity> ;
    proeth-core:partOfGuideline nspe:NSPECodeOfEthics ;
    dct:identifier "II.4.c" ;
    dct:isPartOf nspe:II_4 ;
    skos:definition "Engineers shall not solicit or accept financial or other valuable consideration, directly or indirectly, from outside agents in connection with the work for which they are responsible."@en .

nspe:II_4_d a proeth-core:CodeProvision,
        owl:NamedIndividual ;
    rdfs:label "Rules of Practice II.4.d"@en ;
    proeth-core:establishes <http://proethica.org/ontology/constraints#Conflict_of_Interest_Avoidance>,
        <http://proethica.org/ontology/principles#Integrity>,
        <http://proethica.org/ontology/principles#Public_Welfare> ;
    proeth-core:partOfGuideline nspe:NSPECodeOfEthics ;
    dct:identifier "II.4.d" ;
    dct:isPartOf nspe:II_4 ;
    skos:definition "Engineers in public service as members, advisors, or employees of a governmental or quasi-governmental body or department shall not participate in decisions with respect to services solicited or provided by them or their organizations in private or public engineering practice."@en .

nspe:II_4_e a proeth-core:CodeProvision,
        owl:NamedIndividual ;
    rdfs:label "Rules of Practice II.4.e"@en ;
    proeth-core:establishes <http://proethica.org/ontology/constraints#Conflict_of_Interest_Avoidance>,
        <http://proethica.org/ontology/principles#Integrity>,
        <http://proethica.org/ontology/principles#Public_Welfare> ;
    proeth-core:partOfGuideline nspe:NSPECodeOfEthics ;
    dct:identifier "II.4.e" ;
    dct:isPartOf nspe:II_4 ;
    skos:definition "Engineers shall not solicit or accept a contract from a governmental body on which a principal or officer of their organization serves as a member."@en .

nspe:II_5_a a proeth-core:CodeProvision,
        owl:NamedIndividual ;
    rdfs:label "Rules of Practice II.5.a"@en ;
    proeth-core:establishes <http://proethica.org/ontology/constraints#Non_Deception>,
        <http://proethica.org/ontology/principles#Integrity>,
        <http://proethica.org/ontology/principles#Truthfulness> ;
    proeth-core:partOfGuideline nspe:NSPECodeOfEthics ;
    dct:identifier "II.5.a" ;
    dct:isPartOf nspe:II_5 ;
    skos:definition "Engineers shall not falsify their qualifications or permit misrepresentation of their or their associates' qualifications. They shall not misrepresent or exaggerate their responsibility in or for the subject matter of prior assignments. Brochures or other presentations incident to the solicitation of employment shall not misrepresent pertinent facts concerning employers, employees, associates, joint venturers, or past accomplishments."@en .

nspe:II_5_b a proeth-core:CodeProvision,
        owl:NamedIndividual ;
    rdfs:label "Rules of Practice II.5.b"@en ;
    proeth-core:establishes <http://proethica.org/ontology/constraints#Anti_Corruption>,
        <http://proethica.org/ontology/constraints#Non_Deception>,
        <http://proethica.org/ontology/principles#Integrity> ;
    proeth-core:partOfGuideline nspe:NSPECodeOfEthics ;
    dct:identifier "II.5.b" ;
    dct:isPartOf nspe:II_5 ;
    skos:definition "Engineers shall not offer, give, solicit, or receive, either directly or indirectly, any contribution to influence the award of a contract by public authority, or which may be reasonably construed by the public as having the effect or intent of influencing the awarding of a contract. They shall not offer any gift or other valuable consideration in order to secure work. They shall not pay a commission, percentage, or brokerage fee in order to secure work, except to a bona fide employee or bona fide established commercial or marketing agencies retained by them."@en .

nspe:I_1 a proeth-core:CodeProvision,
        owl:NamedIndividual ;
    rdfs:label "Fundamental Canon I.1"@en ;
    proeth-core:establishes <http://proethica.org/ontology/obligations#Duty_of_Care>,
        <http://proethica.org/ontology/principles#Public_Safety>,
        <http://proethica.org/ontology/principles#Public_Welfare> ;
    proeth-core:partOfGuideline nspe:NSPECodeOfEthics ;
    dct:identifier "I.1" ;
    dct:isPartOf nspe:I ;
    skos:definition "Hold paramount the safety, health, and welfare of the public."@en .

nspe:I_2 a proeth-core:CodeProvision,
        owl:NamedIndividual ;
    rdfs:label "Fundamental Canon I.2"@en ;
    proeth-core:establishes <http://proethica.org/ontology/constraints#Scope_of_Practice>,
        <http://proethica.org/ontology/obligations#Competence>,
        <http://proethica.org/ontology/principles#Professional_Competence> ;
    proeth-core:partOfGuideline nspe:NSPECodeOfEthics ;
    dct:identifier "I.2" ;
    dct:isPartOf nspe:I ;
    skos:definition "Perform services only in areas of their competence."@en .

nspe:I_3 a proeth-core:CodeProvision,
        owl:NamedIndividual ;
    rdfs:label "Fundamental Canon I.3"@en ;
    proeth-core:establishes <http://proethica.org/ontology/constraints#Non_Deception>,
        <http://proethica.org/ontology/principles#Objectivity>,
        <http://proethica.org/ontology/principles#Truthfulness> ;
    proeth-core:partOfGuideline nspe:NSPECodeOfEthics ;
    dct:identifier "I.3" ;
    dct:isPartOf nspe:I ;
    skos:definition "Issue public statements only in an objective and truthful manner."@en .

nspe:I_4 a proeth-core:CodeProvision,
        owl:NamedIndividual ;
    rdfs:label "Fundamental Canon I.4"@en ;
    proeth-core:establishes <http://proethica.org/ontology/obligations#Faithful_Agency>,
        <http://proethica.org/ontology/obligations#Fiduciary_Duty>,
        <http://proethica.org/ontology/principles#Loyalty> ;
    proeth-core:partOfGuideline nspe:NSPECodeOfEthics ;
    dct:identifier "I.4" ;
    dct:isPartOf nspe:I ;
    skos:definition "Act for each employer or client as faithful agents or trustees."@en .

nspe:I_5 a proeth-core:CodeProvision,
        owl:NamedIndividual ;
    rdfs:label "Fundamental Canon I.5"@en ;
    proeth-core:establishes <http://proethica.org/ontology/constraints#Non_Deception>,
        <http://proethica.org/ontology/principles#Honesty> ;
    proeth-core:partOfGuideline nspe:NSPECodeOfEthics ;
    dct:identifier "I.5" ;
    dct:isPartOf nspe:I ;
    skos:definition "Avoid deceptive acts."@en .

nspe:I_6 a proeth-core:CodeProvision,
        owl:NamedIndividual ;
    rdfs:label "Fundamental Canon I.6"@en ;
    proeth-core:establishes <http://proethica.org/ontology/obligations#Ethical_Conduct>,
        <http://proethica.org/ontology/principles#Integrity>,
        <http://proethica.org/ontology/principles#Professional_Dignity> ;
    proeth-core:partOfGuideline nspe:NSPECodeOfEthics ;
    dct:identifier "I.6" ;
    dct:isPartOf nspe:I ;
    skos:definition "Conduct themselves honorably, responsibly, ethically, and lawfully so as to enhance the honor, reputation, and usefulness of the profession."@en .

nspe:Preamble a proeth-core:CodeProvision,
        owl:NamedIndividual ;
    rdfs:label "Preamble"@en ;
    proeth-core:establishes <http://proethica.org/ontology/principles#Honesty>,
        <http://proethica.org/ontology/principles#Integrity>,
        <http://proethica.org/ontology/principles#Public_Safety>,
        <http://proethica.org/ontology/principles#Public_Welfare> ;
    proeth-core:partOfGuideline nspe:NSPECodeOfEthics ;
    dct:identifier "Preamble" ;
    dct:isPartOf nspe:NSPECodeOfEthics ;
    skos:definition "Engineering is an important and learned profession. As members of this profession, engineers are expected to exhibit the highest standards of honesty and integrity. Engineering has a direct and vital impact on the quality of life for all people. Accordingly, the services provided by engineers require honesty, impartiality, fairness, and equity, and must be dedicated to the protection of the public health, safety, and welfare. Engineers must perform under a standard of professional behavior that requires adherence to the highest principles of ethical conduct."@en .

