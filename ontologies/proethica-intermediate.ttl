@prefix : <http://proethica.org/ontology/intermediate#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix iao: <http://purl.obolibrary.org/obo/IAO_> .
@prefix proeth: <http://proethica.org/ontology/intermediate#> .
@prefix proeth-core: <http://proethica.org/ontology/core#> .
@prefix proeth-cases: <http://proethica.org/ontology/cases#> .
@prefix ifcrole: <http://proethica.org/vocab/ifc-roles#> .
@prefix bfo: <http://purl.obolibrary.org/obo/> .
@prefix time: <http://www.w3.org/2006/time#> .
@base <http://proethica.org/ontology/intermediate> .

<http://proethica.org/ontology/intermediate> rdf:type owl:Ontology ;
    owl:imports <http://purl.obolibrary.org/obo/bfo.owl> ,
                <http://proethica.org/ontology/core> ;
    rdfs:label "ProEthica Intermediate Ontology"@en ;
    rdfs:comment "A mid-level ontology bridging BFO to domain-specific ethical frameworks"@en ;
    dc:creator "ProEthica AI"@en ;
    dc:date "2025-05-31"^^xsd:date .

#################################################################
#    Core Ethical Modeling Concepts                              
#################################################################

# Declare key types needed by the OntologyMCPServer for entity extraction
:EntityType rdf:type owl:Class ;
    rdfs:label "Entity Type"@en ;
    rdfs:comment "Meta-class for entity types recognized by the ProEthica system"@en .

# New supertype for guideline concept extraction
:GuidelineConceptType rdf:type owl:Class ;
    rdfs:subClassOf :EntityType ;
    rdfs:label "Guideline Concept Type"@en ;
    rdfs:comment "A type of entity specifically extracted from ethical guidelines and standards. These are the eight core categories used for concept extraction from guideline documents."@en .

# The 8 Guideline Concept Types

# Role is imported from proethica-core, not redefined here

# Principle is imported from proethica-core, not redefined here


# ====================================================================
# PRINCIPLE SUBCLASSES BASED ON CHAPTER 2.2.2 LITERATURE
# ====================================================================

# Core Principle Categories from Chapter 2.2.2 Analysis
:FundamentalEthicalPrinciple rdf:type owl:Class ;
    rdf:type :EntityType ;
    rdfs:subClassOf proeth-core:Principle ;
    rdfs:label "Fundamental Ethical Principle"@en ;
    iao:0000115 "A universal moral foundation that serves as the highest-level abstraction in professional ethics, requiring extensive interpretation through concrete cases (BFO: generically dependent continuant)"@en ;
    skos:definition "According to McLaren (2003), fundamental principles like public welfare and respect for persons cannot be applied through formal deduction alone but require extensional definition through landmark ethics cases and professional code applications. These principles function as constitutional-like foundations (Taddeo et al. 2024) that mediate moral ideals into professional practice (Hallamaa & Kalliokoski 2022)."@en ;
    dcterms:source <https://doi.org/10.1016/S0004-3702(03)00135-8> , # McLaren 2003
                   <https://doi.org/10.1007/s13347-024-00710-6> , # Taddeo et al. 2024
                   <https://doi.org/10.3389/fcomp.2022.776837> ; # Hallamaa & Kalliokoski 2022
    rdfs:comment "Examples: Public Welfare Paramount, Respect for Persons, Justice, Beneficence. These require extensive interpretation and balancing in specific contexts."@en .

:ProfessionalVirtuePrinciple rdf:type owl:Class ;
    rdf:type :EntityType ;
    rdfs:subClassOf proeth-core:Principle ;
    rdfs:label "Professional Virtue Principle"@en ;
    iao:0000115 "A character-based principle defining professional excellence and ethical sensitivities specific to professional identity (BFO: generically dependent continuant)"@en ;
    skos:definition "Professional virtue principles guide professional identity formation and ethical sensitivities (Oakley & Cocking 2001). These principles are learned through expert examples (Anderson & Anderson 2018) and exemplified through model professional behavior cases, creating role-generated moral demands that shape professional character."@en ;
    dcterms:source <https://doi.org/10.1017/CBO9780511487118> , # Oakley & Cocking 2001
                   <https://doi.org/10.1515/pjbr-2018-0024> ; # Anderson & Anderson 2018
    rdfs:comment "Examples: Integrity, Competence, Honesty, Professional Courage, Accountability. These shape professional character and decision-making."@en .

:RelationalPrinciple rdf:type owl:Class ;
    rdf:type :EntityType ;
    rdfs:subClassOf proeth-core:Principle ;
    rdfs:label "Relational Principle"@en ;
    iao:0000115 "A principle governing professional relationships and establishing frameworks for trust and stakeholder interactions (BFO: generically dependent continuant)"@en ;
    skos:definition "Relational principles establish frameworks for managing professional relationships and stakeholder trust. Following McLaren's extensional approach, these principles gain meaning through precedents from client-professional disputes and resolutions, defining how professionals navigate competing interests and maintain trustworthy relationships."@en ;
    dcterms:source <https://doi.org/10.1016/S0004-3702(03)00135-8> , # McLaren 2003
                   <https://doi.org/10.1016/j.robot.2015.11.012> ; # Dennis et al. 2016
    rdfs:comment "Examples: Confidentiality, Loyalty, Fairness, Transparency, Respect for Autonomy. These govern interpersonal professional dynamics."@en .

:DomainSpecificPrinciple rdf:type owl:Class ;
    rdf:type :EntityType ;
    rdfs:subClassOf proeth-core:Principle ;
    rdfs:label "Domain-Specific Principle"@en ;
    iao:0000115 "A principle particular to professional domain contexts that bridges general ethics to specific technical practices (BFO: generically dependent continuant)"@en ;
    skos:definition "Domain-specific principles bridge general ethical guidance to particular professional contexts. As identified by Prem (2023), these principles face inherent challenges in operationalization but remain essential for contextual guidance. They are grounded through industry-specific cases and technical standards applications."@en ;
    dcterms:source <https://doi.org/10.1007/s43681-023-00258-9> , # Prem 2023
                   <https://doi.org/10.1007/s10676-020-09570-y> ; # Segun 2021
    rdfs:comment "Examples: Environmental Stewardship (engineering), Patient Autonomy (medicine), Academic Freedom (education). These address domain-specific ethical challenges."@en .

# Specific Principle Instances commonly found in Professional Codes
:PublicWelfarePrinciple rdf:type owl:Class ;
    rdf:type :EntityType ;
    rdfs:subClassOf :FundamentalEthicalPrinciple ;
    rdfs:label "Public Welfare Principle"@en ;
    iao:0000115 "The fundamental principle that public safety, health, and welfare must be held paramount in professional practice (BFO: generically dependent continuant)"@en ;
    skos:definition "The public welfare principle, as articulated in NSPE Fundamental Canon 1, requires professionals to hold paramount the safety, health, and welfare of the public. This principle exemplifies McLaren's challenge of operationalizing abstract guidance - 'hold paramount' gains meaning only through NSPE case applications and precedents like the Challenger disaster."@en ;
    dcterms:source <https://doi.org/10.1016/S0004-3702(03)00135-8> , # McLaren 2003
                   "NSPE Code of Ethics Fundamental Canon 1" ;
    proeth:nspeReference "Fundamental Canon 1" ;
    proeth:extensionalCases "NSPE BER Case 92-6", "Challenger Disaster", "Hyatt Regency Walkway Collapse" ;
    rdfs:comment "Requires contextual interpretation to balance against client confidentiality and employer loyalty when public safety is at risk."@en .

:IntegrityPrinciple rdf:type owl:Class ;
    rdf:type :EntityType ;
    rdfs:subClassOf :ProfessionalVirtuePrinciple ;
    rdfs:label "Integrity Principle"@en ;
    iao:0000115 "The professional virtue principle of maintaining honesty, truthfulness, and ethical consistency in professional practice (BFO: generically dependent continuant)"@en ;
    skos:definition "Professional integrity requires contextual interpretation through cases (Kong et al. 2020) and manifests differently across professional contexts. It encompasses honesty in professional communications, truthfulness in representations, and consistency between professional values and actions."@en ;
    dcterms:source <https://doi.org/10.1558/jalpp.39771> , # Kong et al. 2020
                   "NSPE Code of Ethics III.1" ;
    proeth:nspeReference "Professional Obligation III.1" ;
    rdfs:comment "Central to professional identity formation and trust maintenance in professional relationships."@en .

:CompetencePrinciple rdf:type owl:Class ;
    rdf:type :EntityType ;
    rdfs:subClassOf :ProfessionalVirtuePrinciple ;
    rdfs:label "Competence Principle"@en ;
    iao:0000115 "The professional virtue principle requiring maintenance and application of professional knowledge and skill within areas of competence (BFO: generically dependent continuant)"@en ;
    skos:definition "The competence principle requires professionals to perform services only in areas of their competence and to maintain professional knowledge through continuous learning. This principle generates obligations for professional development and honest self-assessment of capabilities."@en ;
    dcterms:source "NSPE Code of Ethics II.2" ,
                   <https://doi.org/10.1017/CBO9780511487118> ; # Oakley & Cocking 2001
    proeth:nspeReference "Rule of Practice II.2" ;
    rdfs:comment "Balances professional autonomy with recognition of limitations and need for collaboration."@en .

:ConfidentialityPrinciple rdf:type owl:Class ;
    rdf:type :EntityType ;
    rdfs:subClassOf :RelationalPrinciple ;
    rdfs:label "Confidentiality Principle"@en ;
    iao:0000115 "The relational principle protecting client information and maintaining trust in professional relationships (BFO: generically dependent continuant)"@en ;
    skos:definition "Confidentiality establishes trust frameworks in professional relationships by protecting client information from unauthorized disclosure. This principle requires balancing through precedents when it conflicts with public welfare or legal obligations."@en ;
    dcterms:source "NSPE Code of Ethics II.1.c" ,
                   <https://doi.org/10.1016/S0004-3702(03)00135-8> ; # McLaren 2003
    proeth:nspeReference "Rule of Practice II.1.c" ;
    rdfs:comment "Must be balanced against public safety obligations and legal disclosure requirements."@en .

:TransparencyPrinciple rdf:type owl:Class ;
    rdf:type :EntityType ;
    rdfs:subClassOf :RelationalPrinciple ;
    rdfs:label "Transparency Principle"@en ;
    iao:0000115 "The relational principle requiring openness and disclosure in professional communications and decision-making (BFO: generically dependent continuant)"@en ;
    skos:definition "Transparency requires professionals to be open about conflicts of interest, limitations, and decision-making processes. This principle supports accountability and enables informed consent from stakeholders."@en ;
    dcterms:source "NSPE Code of Ethics II.3.a" ,
                   <https://doi.org/10.1016/j.robot.2015.11.012> ; # Dennis et al. 2016
    proeth:nspeReference "Rule of Practice II.3.a (composite disclosure value; also II.4.a / III.1.a)" ;
    rdfs:comment "Essential for maintaining trust and enabling stakeholder participation in professional decisions."@en .

:EnvironmentalStewardshipPrinciple rdf:type owl:Class ;
    rdf:type :EntityType ;
    rdfs:subClassOf :DomainSpecificPrinciple ;
    rdfs:label "Environmental Stewardship Principle"@en ;
    iao:0000115 "The domain-specific principle in engineering requiring consideration of environmental impact and sustainability (BFO: generically dependent continuant)"@en ;
    skos:definition "Environmental stewardship in engineering requires balancing technical solutions with environmental protection and sustainable development. This principle has evolved through cases addressing pollution, resource depletion, and climate change impacts."@en ;
    dcterms:source "NSPE Code of Ethics III.2.d" ,
                   <https://doi.org/10.1007/s43681-023-00258-9> ; # Prem 2023
    proeth:nspeReference "Professional Obligation III.2.d" ;
    rdfs:comment "Bridges engineering practice with broader environmental and societal responsibilities."@en .

# Corpus-actual principles promoted from the canonicalization reference sheet 2026-06-26
# (parented to their kind; specializationAxis = kind; per-principle NSPE-canon grounding still TODO).
:PeerReviewCooperationPrinciple rdf:type owl:Class ; rdfs:subClassOf :DomainSpecificPrinciple ;
    rdfs:label "Peer Review Cooperation Principle"@en ;
    proeth:nspeReference "Professional Obligation III.7.a" ;
    dcterms:source <https://doi.org/10.1016/S0004-3702(03)00135-8> , "NSPE Code of Ethics Professional Obligation III.7.a" ;
    skos:altLabel "confidential peer review cooperation principle"@en, "peer review notification principle"@en ;
    rdfs:comment "The value that an engineer cooperates with the peer review of another's work; the confidentiality of the reviewed material is a State context, not part of the value."@en .

:LoyaltyPrinciple rdf:type owl:Class ; rdfs:subClassOf :RelationalPrinciple ;
    rdfs:label "Loyalty Principle"@en ;
    proeth:nspeReference "Rule of Practice II.4" ;
    dcterms:source <https://doi.org/10.1016/S0004-3702(03)00135-8> , "NSPE Code of Ethics Rule of Practice II.4" ;
    skos:altLabel "faithful agent loyalty principle"@en, "loyalty"@en ;
    rdfs:comment "The value that a professional acts as a faithful agent or trustee for the client or employer in professional matters."@en .

:ObjectivityPrinciple rdf:type owl:Class ; rdfs:subClassOf :ProfessionalVirtuePrinciple ;
    rdfs:label "Objectivity Principle"@en ;
    proeth:nspeReference "Rule of Practice II.3.a" ;
    dcterms:source <https://doi.org/10.1016/S0004-3702(03)00135-8> , "NSPE Code of Ethics Rule of Practice II.3.a" ;
    skos:altLabel "adversarial context objectivity principle"@en, "adversarial engagement objectivity principle"@en, "dual role objectivity principle"@en, "report language fairness principle"@en ;
    rdfs:comment "The value that professional judgments and opinions are issued objectively and truthfully, free from bias or undue influence."@en .

:HonestyPrinciple rdf:type owl:Class ; rdfs:subClassOf :ProfessionalVirtuePrinciple ;
    rdfs:label "Honesty Principle"@en ;
    proeth:nspeReference "Fundamental Canon 5" ;
    dcterms:source <https://doi.org/10.1016/S0004-3702(03)00135-8> , "NSPE Code of Ethics Fundamental Canon 5" ;
    skos:altLabel "fact-based opinion principle"@en, "scope of engagement honesty principle"@en, "deceptive submission prohibition principle"@en, "credential misrepresentation prohibition principle"@en ;
    rdfs:comment "The value that a professional is truthful and avoids deception or misrepresentation in professional dealings."@en .

:ConflictOfInterestDisclosurePrinciple rdf:type owl:Class ; rdfs:subClassOf :RelationalPrinciple ;
    rdfs:label "Conflict of Interest Disclosure Principle"@en ;
    proeth:nspeReference "Rule of Practice II.4.a" ;
    dcterms:source <https://doi.org/10.1016/S0004-3702(03)00135-8> , "NSPE Code of Ethics Rule of Practice II.4.a" ;
    skos:altLabel "advisory self-interest disclosure principle"@en, "divided loyalty prohibition principle"@en, "client consent conflict waiver principle"@en ;
    rdfs:comment "The value that a professional discloses, and where required avoids, conflicts of interest affecting professional judgment."@en .

:ResponsibleChargePrinciple rdf:type owl:Class ; rdfs:subClassOf :DomainSpecificPrinciple ;
    rdfs:label "Responsible Charge Principle"@en ;
    proeth:nspeReference "Rule of Practice II.2.b" ;
    dcterms:source <https://doi.org/10.1016/S0004-3702(03)00135-8> , "NSPE Code of Ethics Rule of Practice II.2.b" ;
    skos:altLabel "responsible charge active engagement principle"@en, "supervisory control adequacy principle"@en, "professional sealing responsibility principle"@en ;
    rdfs:comment "The value that an engineer in responsible charge exercises actual direct control and personal supervision over the work for which responsibility is taken."@en .

:ReviewAdequacyPrinciple rdf:type owl:Class ; rdfs:subClassOf :DomainSpecificPrinciple ;
    rdfs:label "Review Adequacy Principle"@en ;
    proeth:groundingStatus "ProEthica-derived: no NSPE code provision; ground extensionally (McLaren) by the BER or AI-era cases that instantiate it." ;
    skos:altLabel "ai review adequacy principle"@en, "detailed review adequacy principle"@en ;
    rdfs:comment "The value that a professional reviews work in sufficient depth to take responsibility for its correctness before relying on or adopting it."@en .

:SelfCertificationProhibitionPrinciple rdf:type owl:Class ; rdfs:subClassOf :DomainSpecificPrinciple ;
    rdfs:label "Independent Review Principle"@en ;
    skos:altLabel "self-certification prohibition principle"@en ;
    proeth:groundingStatus "ProEthica-derived: no NSPE code provision; ground extensionally (McLaren) by the BER or AI-era cases that instantiate it." ;
    rdfs:comment "The value that a professional does not certify or approve their own work in a capacity meant to provide independent oversight."@en ;
    skos:changeNote "2026-07-02: relabeled from Self-Certification Prohibition Principle to the positive value the comment states; the prohibition statement itself homes as a core:Constraint per the v2.9.0 boundary sentence. URI unchanged; old label retained as altLabel."@en .

:ToolSubstitutionProhibitionPrinciple rdf:type owl:Class ; rdfs:subClassOf :DomainSpecificPrinciple ;
    rdfs:label "Professional Judgment Primacy Principle"@en ;
    proeth:groundingStatus "ProEthica-derived: no NSPE code provision; ground extensionally (McLaren) by the BER or AI-era cases that instantiate it." ;
    skos:altLabel "technology replacement prohibition principle"@en, "tool substitution prohibition principle"@en ;
    rdfs:comment "The value that a tool or technology does not substitute for the professional judgment and competence the work requires."@en ;
    skos:changeNote "2026-07-02: relabeled from Tool Substitution Prohibition Principle to the positive value the comment states; the prohibition statement itself homes as a core:Constraint per the v2.9.0 boundary sentence. URI unchanged; old label retained as altLabel."@en .

:ProfessionalAccountabilityPrinciple rdf:type owl:Class ; rdfs:subClassOf :ProfessionalVirtuePrinciple ;
    rdfs:label "Professional Accountability Principle"@en ;
    proeth:nspeReference "Professional Obligation III.8" ;
    dcterms:source <https://doi.org/10.1016/S0004-3702(03)00135-8> , "NSPE Code of Ethics Professional Obligation III.8" ;
    skos:altLabel "error acknowledgment principle"@en, "professional accountability"@en ;
    rdfs:comment "The value that a professional takes personal responsibility for, and acknowledges error in, work performed under their authority."@en .

:CorrectiveActionMonitoringPrinciple rdf:type owl:Class ; rdfs:subClassOf :DomainSpecificPrinciple ;
    rdfs:label "Corrective Action Monitoring Principle"@en ;
    proeth:nspeReference "Rule of Practice II.1.a" ;
    dcterms:source <https://doi.org/10.1016/S0004-3702(03)00135-8> , "NSPE Code of Ethics Rule of Practice II.1.a" ;
    skos:altLabel "post-engagement observation duty principle"@en ;
    rdfs:comment "The value that a professional monitors a hazardous or deficient condition through to the completion of corrective action."@en .

:ExpertiseCalibratedDisclosurePrinciple rdf:type owl:Class ; rdfs:subClassOf :FundamentalEthicalPrinciple ;
    rdfs:label "Expertise-Calibrated Disclosure Principle"@en ;
    proeth:nspeReference "Rule of Practice II.3.b" ;
    dcterms:source <https://doi.org/10.1016/S0004-3702(03)00135-8> , "NSPE Code of Ethics Rule of Practice II.3.b" ;
    rdfs:comment "The value that the scope and certainty of professional statements is calibrated to the professional's actual expertise in the matter."@en .

:NonEngineeringExpertServicesPrinciple rdf:type owl:Class ; rdfs:subClassOf :DomainSpecificPrinciple ;
    rdfs:label "Non-Engineering Expert Services Principle"@en ;
    proeth:groundingStatus "ProEthica-derived: no NSPE code provision; ground extensionally (McLaren) by the BER or AI-era cases that instantiate it." ;
    rdfs:comment "The value governing an engineer who provides expert services outside engineering, that such services not trade on engineering authority they do not warrant."@en .

:JurisdictionalLicensureCompliancePrinciple rdf:type owl:Class ; rdfs:subClassOf :DomainSpecificPrinciple ;
    rdfs:label "Jurisdictional Licensure Compliance Principle"@en ;
    proeth:nspeReference "Professional Obligation III.8.a" ;
    dcterms:source <https://doi.org/10.1016/S0004-3702(03)00135-8> , "NSPE Code of Ethics Professional Obligation III.8.a" ;
    skos:altLabel "engineering title invocation principle"@en ;
    rdfs:comment "The value that a professional practices only within the jurisdictions and license scope for which the professional is authorized."@en .

:SelectiveReportingProhibitionPrinciple rdf:type owl:Class ; rdfs:subClassOf :ProfessionalVirtuePrinciple ;
    rdfs:label "Complete Reporting Principle"@en ;
    proeth:nspeReference "Rule of Practice II.3.a" ;
    dcterms:source <https://doi.org/10.1016/S0004-3702(03)00135-8> , "NSPE Code of Ethics Rule of Practice II.3.a" ;
    skos:altLabel "technical completeness principle"@en, "client disservice by incompleteness principle"@en, "expert fact gathering diligence principle"@en, "selective reporting prohibition principle"@en ;
    rdfs:comment "The value that a professional reports findings completely and does not omit material facts that qualify or contradict a favored conclusion."@en ;
    skos:changeNote "2026-07-02: relabeled from Selective Reporting Prohibition Principle to the positive value the comment states; the prohibition statement itself homes as a core:Constraint per the v2.9.0 boundary sentence. URI unchanged; old label retained as altLabel."@en .

# U.S. Supreme Court decision recording the revision (rescission) of an NSPE provision.
:NSPEvUnitedStates1978 rdf:type owl:NamedIndividual ;
    rdfs:label "National Society of Professional Engineers v. United States (1978)"@en ;
    dcterms:source <https://supreme.justia.com/cases/federal/us/435/679/> ;
    rdfs:comment "U.S. Supreme Court, 435 U.S. 679 (1978): held the NSPE Code ban on competitive bidding an unreasonable restraint of trade under the Sherman Act; the provision was rescinded by court order. Basis for the rescinded grounding of FreeServicesProhibitionPrinciple."@en .

:FreeServicesProhibitionPrinciple rdf:type owl:Class ; rdfs:subClassOf :RelationalPrinciple ;
    rdfs:label "Free Services Prohibition Principle"@en ;
    owl:deprecated true ;
    skos:changeNote "2026-07-02: deprecated as a live extraction reuse target; the underlying provision was rescinded by NSPE v. United States (1978), so a current case does not instantiate it. The class, its rescission metadata, and :NSPEvUnitedStates1978 remain as the McLaren Principle Revision exemplar."@en ;
    proeth:revisionStatus "rescinded" ;
    proeth:rescindedBy :NSPEvUnitedStates1978 ;
    proeth:rescindedDate "1978" ;
    proeth:groundingStatus "Rescinded NSPE basis: derived from the Code former competitive-bidding prohibition, struck down as an antitrust restraint of trade (see :NSPEvUnitedStates1978); retained as a historical/contested norm, not a current code duty. Realizes McLaren Principle Revision." ;
    dcterms:source <https://supreme.justia.com/cases/federal/us/435/679/> ;
    rdfs:comment "The value that a professional does not offer or provide services without compensation in a manner that undermines fair competition or professional independence."@en .

:SchedulePressureResistancePrinciple rdf:type owl:Class ; rdfs:subClassOf :ProfessionalVirtuePrinciple ;
    rdfs:label "Schedule Pressure Resistance Principle"@en ;
    proeth:groundingStatus "ProEthica-derived: no NSPE code provision; ground extensionally (McLaren) by the BER or AI-era cases that instantiate it." ;
    rdfs:comment "The value that a professional does not compromise technical or ethical standards in response to schedule or commercial pressure."@en .

:WhistleblowerPersonalConsciencePrinciple rdf:type owl:Class ; rdfs:subClassOf :ProfessionalVirtuePrinciple ;
    rdfs:label "Whistleblower Personal Conscience Principle"@en ;
    proeth:nspeReference "Rule of Practice II.1.f" ;
    dcterms:source <https://doi.org/10.1016/S0004-3702(03)00135-8> , "NSPE Code of Ethics Rule of Practice II.1.f" ;
    proeth:groundingStatus "Partially derived: the reporting duty grounds to NSPE II.1.f / II.1.a; the personal-conscience surplus beyond what the rules compel is extensional/derived." ;
    rdfs:comment "The value that a professional may act on personal conscience to disclose conduct that endangers the public, beyond the minimum the rules compel."@en .

:EvolvingStandardsResponsivenessPrinciple rdf:type owl:Class ; rdfs:subClassOf :FundamentalEthicalPrinciple ;
    rdfs:label "Evolving Standards Responsiveness Principle"@en ;
    proeth:nspeReference "Professional Obligation III.2.e" ;
    dcterms:source <https://doi.org/10.1016/S0004-3702(03)00135-8> , "NSPE Code of Ethics Professional Obligation III.2.e" ;
    rdfs:comment "The value that a professional keeps current with and applies evolving technical and ethical standards of practice."@en .

:MentorDependencyTransitionPrinciple rdf:type owl:Class ; rdfs:subClassOf :ProfessionalVirtuePrinciple ;
    rdfs:label "Mentor Dependency Transition Principle"@en ;
    proeth:groundingStatus "ProEthica-derived: no NSPE code provision; ground extensionally (McLaren) by the BER or AI-era cases that instantiate it." ;
    rdfs:comment "The value that an engineer develops independent competence and does not remain indefinitely dependent on a mentor for professional judgment."@en .


