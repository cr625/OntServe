@base <http://proethica.org/ontology/intermediate> .

<http://proethica.org/ontology/intermediate> rdf:type owl:Ontology ;
    owl:imports <http://purl.obolibrary.org/obo/bfo.owl> ,
                <http://proethica.org/ontology/core> ;
    rdfs:label "ProEthica Intermediate Ontology"@en ;
    rdfs:comment "A mid-level ontology bridging BFO to domain-specific ethical frameworks"@en ;
    dc:creator "ProEthica AI"@en ;
    dc:date "2025-05-31"^^xsd:date ;
    skos:changeNote "2026-07-06 (third pass, same review): ProfessionalRole and ParticipantRole definitions rewritten. The ProfessionalRole text (2025-09-12 vintage, not dissertation-sourced) foregrounded licensure against Davis 1991 and the core Role v2.10.4 scope note and listed Public Official, an example with no declared class; the differentia is restated as code-codified obligation generation from the recognized ends of the profession, and the class gains the iao:0000116, iao:0000119, skos:scopeNote apparatus matching the core components. ParticipantRole gains a positive genus, declared-head examples, the code-governance exclusion, and a scope note stating the disjointness is class-level, not person-level. Bearer and professional shape descriptions normalized (American spelling, and-form citations, slash pairs resolved). No logical axioms changed."@en ;
    skos:changeNote "2026-07-06 (second pass, same review): governedByCode and pursuesEnd rdfs:domain narrowed from the universal proeth-core:Role to :ProfessionalRole (the owesDutyToward pattern), resolving the mismatch between the governedByCode axiom and its professional-only comment and shapes prose. Code-governance and teleological ends are professional-side relations on the verified sources (Davis 1991; Oakley and Cocking 2001); both properties are unused in the 12 gold-standard case TTLs and all emitters, so the narrowing is corpus-safe, and both correctly move from the core:Role entity page to the ProfessionalRole page. The optional ProfessionalRole subClassOf (pursuesEnd some End) restriction was considered and deferred to the Step-4 enrichment vocabulary decision."@en ;
    skos:changeNote "2026-07-06: Annotation pass on the R-component property layer from the Property Structure source review (companion to core v2.10.5); no logical axioms changed. The ProfessionalPeerRole definition no longer attributes peer review, professional development, knowledge sharing, and standard maintenance to Kong et al. (2020), whose actual professional-peer content is collegiality, cooperation, referral, and peer-to-peer communication; the ProviderClientRole duties are restated per the source (competence is coded under the Kong General category, not provider-to-client); the archetype block comment now documents which Kong categories are deliberately not operationalized as edges and why; EmployerRelationshipRole gains the Kong reference alongside Wendel; End and pursuesEnd gain the Oakley and Cocking grounding; spelling and punctuation normalized (operationalizes, terminal period on hasAgentRole)."@en .

#################################################################
#    Core Ethical Modeling Concepts                              
#################################################################

# Declare key types needed by the OntologyMCPServer for entity extraction
# New supertype for guideline concept extraction
:GuidelineConceptType rdf:type owl:Class ;
    rdfs:subClassOf :EntityType ;
    rdfs:label "Guideline Concept Type"@en ;
    iao:0000115 "A type of entity specifically extracted from ethical guidelines and standards. These are the eight core categories used for concept extraction from guideline documents."@en ;
    rdfs:comment "A type of entity specifically extracted from ethical guidelines and standards. These are the eight core categories used for concept extraction from guideline documents."@en .

# The 8 Guideline Concept Types

# Role is imported from proethica-core, not redefined here

# Principle is imported from proethica-core, not redefined here


# ====================================================================
# PRINCIPLE SUBCLASSES BASED ON CHAPTER 2.2.2 LITERATURE
# ====================================================================

# Core Principle Categories from Chapter 2.2.2 Analysis
:FundamentalEthicalPrinciple rdf:type owl:Class ;
    rdfs:subClassOf proeth-core:Principle ;
    rdfs:label "Fundamental Ethical Principle"@en ;
    iao:0000115 "A universal moral foundation that serves as the highest-level abstraction in professional ethics, requiring extensive interpretation through concrete cases (BFO: generically dependent continuant)"@en ;
    skos:definition "According to McLaren (2003), fundamental principles like public welfare and respect for persons cannot be applied through formal deduction alone but require extensional definition through landmark ethics cases and professional code applications. These principles function as constitutional-like foundations (Taddeo et al. 2024) that mediate moral ideals into professional practice (Hallamaa & Kalliokoski 2022)."@en ;
    dcterms:source <https://doi.org/10.1016/S0004-3702(03)00135-8> , # McLaren 2003
                   <https://doi.org/10.1007/s13347-024-00710-6> , # Taddeo et al. 2024
                   <https://doi.org/10.3389/fcomp.2022.776837> ; # Hallamaa & Kalliokoski 2022
    rdfs:comment "Examples: Public Welfare Paramount, Respect for Persons, Justice, Beneficence. These require extensive interpretation and balancing in specific contexts."@en .

:ProfessionalVirtuePrinciple rdf:type owl:Class ;
    rdfs:subClassOf proeth-core:Principle ;
    rdfs:label "Professional Virtue Principle"@en ;
    iao:0000115 "A character-based principle defining professional excellence and ethical sensitivities specific to professional identity (BFO: generically dependent continuant)"@en ;
    skos:definition "Professional virtue principles guide professional identity formation and ethical sensitivities (Oakley & Cocking 2001). These principles are learned through expert examples (Anderson & Anderson 2018) and exemplified through model professional behavior cases, creating role-generated moral demands that shape professional character."@en ;
    dcterms:source <https://doi.org/10.1017/CBO9780511487118> , # Oakley & Cocking 2001
                   <https://doi.org/10.1515/pjbr-2018-0024> ; # Anderson & Anderson 2018
    rdfs:comment "Examples: Integrity, Competence, Honesty, Professional Courage, Accountability. These shape professional character and decision-making."@en .

:RelationalPrinciple rdf:type owl:Class ;
    rdfs:subClassOf proeth-core:Principle ;
    rdfs:label "Relational Principle"@en ;
    iao:0000115 "A principle governing professional relationships and establishing frameworks for trust and stakeholder interactions (BFO: generically dependent continuant)"@en ;
    skos:definition "Relational principles establish frameworks for managing professional relationships and stakeholder trust. Following McLaren's extensional approach, these principles gain meaning through precedents from client-professional disputes and resolutions, defining how professionals navigate competing interests and maintain trustworthy relationships."@en ;
    dcterms:source <https://doi.org/10.1016/S0004-3702(03)00135-8> , # McLaren 2003
                   <https://doi.org/10.1016/j.robot.2015.11.012> ; # Dennis et al. 2016
    rdfs:comment "Examples: Confidentiality, Loyalty, Fairness, Transparency, Respect for Autonomy. These govern interpersonal professional dynamics."@en .

:DomainSpecificPrinciple rdf:type owl:Class ;
    rdfs:subClassOf proeth-core:Principle ;
    rdfs:label "Domain-Specific Principle"@en ;
    iao:0000115 "A principle particular to professional domain contexts that bridges general ethics to specific technical practices (BFO: generically dependent continuant)"@en ;
    skos:definition "Domain-specific principles bridge general ethical guidance to particular professional contexts. As identified by Prem (2023), these principles face inherent challenges in operationalization but remain essential for contextual guidance. They are grounded through industry-specific cases and technical standards applications."@en ;
    dcterms:source <https://doi.org/10.1007/s43681-023-00258-9> , # Prem 2023
                   <https://doi.org/10.1007/s10676-020-09570-y> ; # Segun 2021
    rdfs:comment "Examples: Environmental Stewardship (engineering), Patient Autonomy (medicine), Academic Freedom (education). These address domain-specific ethical challenges."@en .

# Specific Principle Instances commonly found in Professional Codes
:PublicWelfarePrinciple rdf:type owl:Class ;
    rdfs:subClassOf :FundamentalEthicalPrinciple ;
    rdfs:label "Public Welfare Principle"@en ;
    skos:altLabel "public safety principle"@en ;
    iao:0000115 "The fundamental principle that public safety, health, and welfare must be held paramount in professional practice (BFO: generically dependent continuant)"@en ;
    skos:definition "The public welfare principle, as articulated in NSPE Fundamental Canon 1, requires professionals to hold paramount the safety, health, and welfare of the public. This principle exemplifies McLaren's challenge of operationalizing abstract guidance - 'hold paramount' gains meaning only through NSPE case applications and precedents like the Challenger disaster."@en ;
    dcterms:source <https://doi.org/10.1016/S0004-3702(03)00135-8> , # McLaren 2003
                   "NSPE Code of Ethics Fundamental Canon 1" ;
    proeth:nspeReference "Fundamental Canon 1" ;
    proeth:extensionalCases "NSPE BER Case 92-6", "Challenger Disaster", "Hyatt Regency Walkway Collapse" ;
    rdfs:comment "Requires contextual interpretation to balance against client confidentiality and employer loyalty when public safety is at risk."@en .

:IntegrityPrinciple rdf:type owl:Class ;
    rdfs:subClassOf :ProfessionalVirtuePrinciple ;
    rdfs:label "Integrity Principle"@en ;
    iao:0000115 "The professional virtue principle of maintaining honesty, truthfulness, and ethical consistency in professional practice (BFO: generically dependent continuant)"@en ;
    skos:definition "Professional integrity requires contextual interpretation through cases (Kong et al. 2020) and manifests differently across professional contexts. It encompasses honesty in professional communications, truthfulness in representations, and consistency between professional values and actions."@en ;
    dcterms:source <https://doi.org/10.1558/jalpp.39771> , # Kong et al. 2020
                   "NSPE Code of Ethics III.1" ;
    proeth:nspeReference "Professional Obligation III.1" ;
    rdfs:comment "Central to professional identity formation and trust maintenance in professional relationships."@en .

:CompetencePrinciple rdf:type owl:Class ;
    rdfs:subClassOf :ProfessionalVirtuePrinciple ;
    rdfs:label "Competence Principle"@en ;
    iao:0000115 "The professional virtue principle requiring maintenance and application of professional knowledge and skill within areas of competence (BFO: generically dependent continuant)"@en ;
    skos:definition "The competence principle requires professionals to perform services only in areas of their competence and to maintain professional knowledge through continuous learning. This principle generates obligations for professional development and honest self-assessment of capabilities."@en ;
    dcterms:source "NSPE Code of Ethics II.2" ,
                   <https://doi.org/10.1017/CBO9780511487118> ; # Oakley & Cocking 2001
    proeth:nspeReference "Rule of Practice II.2" ;
    rdfs:comment "Balances professional autonomy with recognition of limitations and need for collaboration."@en .

:ConfidentialityPrinciple rdf:type owl:Class ;
    rdfs:subClassOf :RelationalPrinciple ;
    rdfs:label "Confidentiality Principle"@en ;
    iao:0000115 "The relational principle protecting client information and maintaining trust in professional relationships (BFO: generically dependent continuant)"@en ;
    skos:definition "Confidentiality establishes trust frameworks in professional relationships by protecting client information from unauthorized disclosure. This principle requires balancing through precedents when it conflicts with public welfare or legal obligations."@en ;
    dcterms:source "NSPE Code of Ethics II.1.c" ,
                   <https://doi.org/10.1016/S0004-3702(03)00135-8> ; # McLaren 2003
    proeth:nspeReference "Rule of Practice II.1.c" ;
    rdfs:comment "Must be balanced against public safety obligations and legal disclosure requirements."@en .

:TransparencyPrinciple rdf:type owl:Class ;
    rdfs:subClassOf :RelationalPrinciple ;
    rdfs:label "Transparency Principle"@en ;
    iao:0000115 "The relational principle requiring openness and disclosure in professional communications and decision-making (BFO: generically dependent continuant)"@en ;
    skos:definition "Transparency requires professionals to be open about conflicts of interest, limitations, and decision-making processes. This principle supports accountability and enables informed consent from stakeholders."@en ;
    dcterms:source "NSPE Code of Ethics II.3.a" ,
                   <https://doi.org/10.1016/j.robot.2015.11.012> ; # Dennis et al. 2016
    proeth:nspeReference "Rule of Practice II.3.a (composite disclosure value; also II.4.a / III.1.a)" ;
    iao:0000116 "II.3.a triplet boundary: Transparency is the RELATIONAL pole of the shared provision, the openness owed to affected parties about conflicts, limitations, and decision processes. The judgment-quality pole is ObjectivityPrinciple; the content-completeness pole is the Complete Reporting principle."@en ;
    rdfs:comment "Essential for maintaining trust and enabling stakeholder participation in professional decisions."@en .

:EnvironmentalStewardshipPrinciple rdf:type owl:Class ;
    rdfs:subClassOf :DomainSpecificPrinciple ;
    rdfs:label "Environmental Stewardship Principle"@en ;
    iao:0000115 "The domain-specific principle in engineering requiring consideration of environmental impact and sustainability (BFO: generically dependent continuant)"@en ;
    skos:definition "Environmental stewardship in engineering requires balancing technical solutions with environmental protection and sustainable development. This principle has evolved through cases addressing pollution, resource depletion, and climate change impacts."@en ;
    dcterms:source "NSPE Code of Ethics III.2.d" ,
                   <https://doi.org/10.1007/s43681-023-00258-9> ; # Prem 2023
    proeth:nspeReference "Professional Obligation III.2.d" ;
    rdfs:comment "Bridges engineering practice with broader environmental and societal responsibilities."@en .

# Corpus-actual principles promoted from the canonicalization reference sheet 2026-06-26
# (parented to their kind; specializationAxis = kind; per-principle NSPE-canon grounding still TODO).
:PeerReviewCooperationPrinciple rdf:type owl:Class ; rdfs:subClassOf :DomainSpecificPrinciple ;
    rdfs:label "Peer Review Cooperation Principle"@en ;
    iao:0000115 "The value that an engineer cooperates with the peer review of another's work; the confidentiality of the reviewed material is a State context, not part of the value."@en ;
    proeth:nspeReference "Professional Obligation III.7.a" ;
    dcterms:source <https://doi.org/10.1016/S0004-3702(03)00135-8> , "NSPE Code of Ethics Professional Obligation III.7.a" ;
    skos:altLabel "confidential peer review cooperation principle"@en, "peer review notification principle"@en ;
    rdfs:comment "The value that an engineer cooperates with the peer review of another's work; the confidentiality of the reviewed material is a State context, not part of the value."@en .

:LoyaltyPrinciple rdf:type owl:Class ; rdfs:subClassOf :RelationalPrinciple ;
    rdfs:label "Loyalty Principle"@en ;
    iao:0000115 "The value that a professional acts as a faithful agent or trustee for the client or employer in professional matters."@en ;
    proeth:nspeReference "Rule of Practice II.4" ;
    dcterms:source <https://doi.org/10.1016/S0004-3702(03)00135-8> , "NSPE Code of Ethics Rule of Practice II.4" ;
    skos:altLabel "faithful agent loyalty principle"@en, "loyalty"@en ;
    rdfs:comment "The value that a professional acts as a faithful agent or trustee for the client or employer in professional matters."@en .

:ObjectivityPrinciple rdf:type owl:Class ; rdfs:subClassOf :ProfessionalVirtuePrinciple ;
    rdfs:label "Objectivity Principle"@en ;
    iao:0000115 "The value that professional judgments and opinions are issued objectively and truthfully, free from bias or undue influence."@en ;
    proeth:nspeReference "Rule of Practice II.3.a" ;
    dcterms:source <https://doi.org/10.1016/S0004-3702(03)00135-8> , "NSPE Code of Ethics Rule of Practice II.3.a" ;
    skos:altLabel "adversarial context objectivity principle"@en, "adversarial engagement objectivity principle"@en, "dual role objectivity principle"@en, "report language fairness principle"@en ;
    iao:0000116 "II.3.a triplet boundary: Objectivity is the JUDGMENT-QUALITY pole of the shared provision, opinions issued unbiased and truthful. The openness-to-parties pole is TransparencyPrinciple; the no-material-omissions pole is the Complete Reporting principle."@en ;
    rdfs:comment "The value that professional judgments and opinions are issued objectively and truthfully, free from bias or undue influence."@en .

:HonestyPrinciple rdf:type owl:Class ; rdfs:subClassOf :ProfessionalVirtuePrinciple ;
    rdfs:label "Honesty Principle"@en ;
    iao:0000115 "The value that a professional is truthful and avoids deception or misrepresentation in professional dealings."@en ;
    proeth:nspeReference "Fundamental Canon 5" ;
    dcterms:source <https://doi.org/10.1016/S0004-3702(03)00135-8> , "NSPE Code of Ethics Fundamental Canon 5" ;
    skos:altLabel "fact-based opinion principle"@en, "scope of engagement honesty principle"@en, "deceptive submission prohibition principle"@en, "credential misrepresentation prohibition principle"@en ;
    rdfs:comment "The value that a professional is truthful and avoids deception or misrepresentation in professional dealings."@en .

:ConflictOfInterestDisclosurePrinciple rdf:type owl:Class ; rdfs:subClassOf :RelationalPrinciple ;
    rdfs:label "Conflict of Interest Disclosure Principle"@en ;
    iao:0000115 "The value that a professional discloses, and where required avoids, conflicts of interest affecting professional judgment."@en ;
    proeth:nspeReference "Rule of Practice II.4.a" ;
    dcterms:source <https://doi.org/10.1016/S0004-3702(03)00135-8> , "NSPE Code of Ethics Rule of Practice II.4.a" ;
    skos:altLabel "advisory self-interest disclosure principle"@en, "divided loyalty prohibition principle"@en, "client consent conflict waiver principle"@en ;
    rdfs:comment "The value that a professional discloses, and where required avoids, conflicts of interest affecting professional judgment."@en .

:ResponsibleChargePrinciple rdf:type owl:Class ; rdfs:subClassOf :DomainSpecificPrinciple ;
    rdfs:label "Responsible Charge Principle"@en ;
    iao:0000115 "The value that an engineer in responsible charge exercises actual direct control and personal supervision over the work for which responsibility is taken."@en ;
    proeth:nspeReference "Rule of Practice II.2.b" ;
    dcterms:source <https://doi.org/10.1016/S0004-3702(03)00135-8> , "NSPE Code of Ethics Rule of Practice II.2.b" ;
    skos:altLabel "responsible charge active engagement principle"@en, "supervisory control adequacy principle"@en, "professional sealing responsibility principle"@en ;
    rdfs:comment "The value that an engineer in responsible charge exercises actual direct control and personal supervision over the work for which responsibility is taken."@en .

:ReviewAdequacyPrinciple rdf:type owl:Class ; rdfs:subClassOf :DomainSpecificPrinciple ;
    rdfs:label "Review Adequacy Principle"@en ;
    iao:0000115 "The value that a professional reviews work in sufficient depth to take responsibility for its correctness before relying on or adopting it."@en ;
    proeth:groundingStatus "ProEthica-derived: no NSPE code provision; ground extensionally (McLaren) by the BER or AI-era cases that instantiate it." ;
    skos:altLabel "ai review adequacy principle"@en, "detailed review adequacy principle"@en ;
    rdfs:comment "The value that a professional reviews work in sufficient depth to take responsibility for its correctness before relying on or adopting it."@en .

:SelfCertificationProhibitionPrinciple rdf:type owl:Class ; rdfs:subClassOf :DomainSpecificPrinciple ;
    rdfs:label "Independent Review Principle"@en ;
    iao:0000115 "The value that a professional does not certify or approve their own work in a capacity meant to provide independent oversight."@en ;
    skos:altLabel "self-certification prohibition principle"@en ;
    proeth:groundingStatus "ProEthica-derived: no NSPE code provision; ground extensionally (McLaren) by the BER or AI-era cases that instantiate it." ;
    rdfs:comment "The value that a professional does not certify or approve their own work in a capacity meant to provide independent oversight."@en ;
    skos:changeNote "2026-07-02: relabeled from Self-Certification Prohibition Principle to the positive value the comment states; the prohibition statement itself homes as a core:Constraint per the v2.9.0 boundary sentence. URI unchanged; old label retained as altLabel."@en .

:ToolSubstitutionProhibitionPrinciple rdf:type owl:Class ; rdfs:subClassOf :DomainSpecificPrinciple ;
    rdfs:label "Professional Judgment Primacy Principle"@en ;
    iao:0000115 "The value that a tool or technology does not substitute for the professional judgment and competence the work requires."@en ;
    proeth:groundingStatus "ProEthica-derived: no NSPE code provision; ground extensionally (McLaren) by the BER or AI-era cases that instantiate it." ;
    skos:altLabel "technology replacement prohibition principle"@en, "tool substitution prohibition principle"@en ;
    rdfs:comment "The value that a tool or technology does not substitute for the professional judgment and competence the work requires."@en ;
    skos:changeNote "2026-07-02: relabeled from Tool Substitution Prohibition Principle to the positive value the comment states; the prohibition statement itself homes as a core:Constraint per the v2.9.0 boundary sentence. URI unchanged; old label retained as altLabel."@en .

:ProfessionalAccountabilityPrinciple rdf:type owl:Class ; rdfs:subClassOf :ProfessionalVirtuePrinciple ;
    rdfs:label "Professional Accountability Principle"@en ;
    iao:0000115 "The value that a professional takes personal responsibility for, and acknowledges error in, work performed under their authority."@en ;
    proeth:nspeReference "Professional Obligation III.8" ;
    dcterms:source <https://doi.org/10.1016/S0004-3702(03)00135-8> , "NSPE Code of Ethics Professional Obligation III.8" ;
    skos:altLabel "error acknowledgment principle"@en, "professional accountability"@en ;
    rdfs:comment "The value that a professional takes personal responsibility for, and acknowledges error in, work performed under their authority."@en .

:CorrectiveActionMonitoringPrinciple rdf:type owl:Class ; rdfs:subClassOf :DomainSpecificPrinciple ;
    rdfs:label "Corrective Action Monitoring Principle"@en ;
    iao:0000115 "The value that a professional monitors a hazardous or deficient condition through to the completion of corrective action."@en ;
    proeth:nspeReference "Rule of Practice II.1.a" ;
    dcterms:source <https://doi.org/10.1016/S0004-3702(03)00135-8> , "NSPE Code of Ethics Rule of Practice II.1.a" ;
    skos:altLabel "post-engagement observation duty principle"@en ;
    rdfs:comment "The value that a professional monitors a hazardous or deficient condition through to the completion of corrective action."@en .

:ExpertiseCalibratedDisclosurePrinciple rdf:type owl:Class ; rdfs:subClassOf :FundamentalEthicalPrinciple ;
    rdfs:label "Expertise-Calibrated Disclosure Principle"@en ;
    iao:0000115 "The value that the scope and certainty of professional statements is calibrated to the professional's actual expertise in the matter."@en ;
    proeth:nspeReference "Rule of Practice II.3.b" ;
    dcterms:source <https://doi.org/10.1016/S0004-3702(03)00135-8> , "NSPE Code of Ethics Rule of Practice II.3.b" ;
    rdfs:comment "The value that the scope and certainty of professional statements is calibrated to the professional's actual expertise in the matter."@en .

:NonEngineeringExpertServicesPrinciple rdf:type owl:Class ; rdfs:subClassOf :DomainSpecificPrinciple ;
    rdfs:label "Non-Engineering Expert Services Principle"@en ;
    iao:0000115 "The value governing an engineer who provides expert services outside engineering, that such services not trade on engineering authority they do not warrant."@en ;
    proeth:groundingStatus "ProEthica-derived: no NSPE code provision; ground extensionally (McLaren) by the BER or AI-era cases that instantiate it." ;
    rdfs:comment "The value governing an engineer who provides expert services outside engineering, that such services not trade on engineering authority they do not warrant."@en .

:JurisdictionalLicensureCompliancePrinciple rdf:type owl:Class ; rdfs:subClassOf :DomainSpecificPrinciple ;
    rdfs:label "Jurisdictional Licensure Compliance Principle"@en ;
    iao:0000115 "The value that a professional practices only within the jurisdictions and license scope for which the professional is authorized."@en ;
    proeth:nspeReference "Professional Obligation III.8.a" ;
    dcterms:source <https://doi.org/10.1016/S0004-3702(03)00135-8> , "NSPE Code of Ethics Professional Obligation III.8.a" ;
    skos:altLabel "engineering title invocation principle"@en ;
    rdfs:comment "The value that a professional practices only within the jurisdictions and license scope for which the professional is authorized."@en .

:SelectiveReportingProhibitionPrinciple rdf:type owl:Class ; rdfs:subClassOf :ProfessionalVirtuePrinciple ;
    rdfs:label "Complete Reporting Principle"@en ;
    iao:0000115 "The value that a professional reports findings completely and does not omit material facts that qualify or contradict a favored conclusion."@en ;
    proeth:nspeReference "Rule of Practice II.3.a" ;
    dcterms:source <https://doi.org/10.1016/S0004-3702(03)00135-8> , "NSPE Code of Ethics Rule of Practice II.3.a" ;
    skos:altLabel "technical completeness principle"@en, "client disservice by incompleteness principle"@en, "expert fact gathering diligence principle"@en, "selective reporting prohibition principle"@en ;
    iao:0000116 "II.3.a triplet boundary: Complete Reporting is the CONTENT-COMPLETENESS pole of the shared provision, no material facts omitted that qualify or contradict a favored conclusion. The judgment-quality pole is ObjectivityPrinciple; the openness-to-parties pole is TransparencyPrinciple."@en ;
    rdfs:comment "The value that a professional reports findings completely and does not omit material facts that qualify or contradict a favored conclusion."@en ;
    skos:changeNote "2026-07-02: relabeled from Selective Reporting Prohibition Principle to the positive value the comment states; the prohibition statement itself homes as a core:Constraint per the v2.9.0 boundary sentence. URI unchanged; old label retained as altLabel."@en .

# U.S. Supreme Court decision recording the revision (rescission) of an NSPE provision.
:NSPEvUnitedStates1978 rdf:type owl:NamedIndividual ;
    rdfs:label "National Society of Professional Engineers v. United States (1978)"@en ;
    dcterms:source <https://supreme.justia.com/cases/federal/us/435/679/> ;
    rdfs:comment "U.S. Supreme Court, 435 U.S. 679 (1978): held the NSPE Code ban on competitive bidding an unreasonable restraint of trade under the Sherman Act; the provision was rescinded by court order. Basis for the rescinded grounding of FreeServicesProhibitionPrinciple."@en .

:FreeServicesProhibitionPrinciple rdf:type owl:Class ; rdfs:subClassOf :RelationalPrinciple ;
    rdfs:label "Free Services Prohibition Principle"@en ;
    owl:deprecated true ;
    skos:changeNote "2026-07-02: deprecated as a live extraction reuse target; the underlying provision was rescinded by NSPE v. United States (1978), so a current case does not instantiate it. The class, its rescission metadata, and :NSPEvUnitedStates1978 remain as the McLaren Principle Revision exemplar."@en ;
    proeth:revisionStatus "rescinded" ;
    proeth:rescindedBy :NSPEvUnitedStates1978 ;
    proeth:rescindedDate "1978" ;
    proeth:groundingStatus "Rescinded NSPE basis: derived from the Code former competitive-bidding prohibition, struck down as an antitrust restraint of trade (see :NSPEvUnitedStates1978); retained as a historical/contested norm, not a current code duty. Realizes McLaren Principle Revision." ;
    dcterms:source <https://supreme.justia.com/cases/federal/us/435/679/> ;
    rdfs:comment "The value that a professional does not offer or provide services without compensation in a manner that undermines fair competition or professional independence."@en .

:SchedulePressureResistancePrinciple rdf:type owl:Class ; rdfs:subClassOf :ProfessionalVirtuePrinciple ;
    rdfs:label "Schedule Pressure Resistance Principle"@en ;
    iao:0000115 "The value that a professional does not compromise technical or ethical standards in response to schedule or commercial pressure."@en ;
    proeth:groundingStatus "ProEthica-derived: no NSPE code provision; ground extensionally (McLaren) by the BER or AI-era cases that instantiate it." ;
    rdfs:comment "The value that a professional does not compromise technical or ethical standards in response to schedule or commercial pressure."@en .

:WhistleblowerPersonalConsciencePrinciple rdf:type owl:Class ; rdfs:subClassOf :ProfessionalVirtuePrinciple ;
    rdfs:label "Whistleblower Personal Conscience Principle"@en ;
    iao:0000115 "The value that a professional may act on personal conscience to disclose conduct that endangers the public, beyond the minimum the rules compel."@en ;
    proeth:nspeReference "Rule of Practice II.1.f" ;
    dcterms:source <https://doi.org/10.1016/S0004-3702(03)00135-8> , "NSPE Code of Ethics Rule of Practice II.1.f" ;
    proeth:groundingStatus "Partially derived: the reporting duty grounds to NSPE II.1.f / II.1.a; the personal-conscience surplus beyond what the rules compel is extensional/derived." ;
    rdfs:comment "The value that a professional may act on personal conscience to disclose conduct that endangers the public, beyond the minimum the rules compel."@en .

:EvolvingStandardsResponsivenessPrinciple rdf:type owl:Class ; rdfs:subClassOf :FundamentalEthicalPrinciple ;
    rdfs:label "Evolving Standards Responsiveness Principle"@en ;
    iao:0000115 "The value that a professional keeps current with and applies evolving technical and ethical standards of practice."@en ;
    proeth:nspeReference "Professional Obligation III.2.e" ;
    dcterms:source <https://doi.org/10.1016/S0004-3702(03)00135-8> , "NSPE Code of Ethics Professional Obligation III.2.e" ;
    rdfs:comment "The value that a professional keeps current with and applies evolving technical and ethical standards of practice."@en .


# Obligation is imported from proethica-core, not redefined here

# State is imported from proethica-core, not redefined here

# Resource is imported from proethica-core, not redefined here

# Action is imported from proethica-core, not redefined here

# Event is imported from proethica-core, not redefined here

# Capability is imported from proethica-core, not redefined here

# Constraint is imported from proethica-core, not redefined here

# Meta-classes for subtypes (not GuidelineConceptTypes themselves)
:ResourceType rdf:type owl:Class ;
    rdfs:subClassOf :EntityType ;
    rdfs:label "Resource Type"@en ;
    iao:0000115 "Meta-class for specific resource types recognized by the ProEthica system"@en ;
    rdfs:comment "Meta-class for specific resource types recognized by the ProEthica system"@en .

:EventType rdf:type owl:Class ;
    rdfs:subClassOf :EntityType ;
    rdfs:label "Event Type"@en ;
    iao:0000115 "Meta-class for specific event types recognized by the ProEthica system"@en ;
    rdfs:comment "Meta-class for specific event types recognized by the ProEthica system"@en .

:ActionType rdf:type owl:Class ;
    rdfs:subClassOf :EntityType ;
    rdfs:label "Action Type"@en ;
    iao:0000115 "Meta-class for specific action types recognized by the ProEthica system"@en ;
    rdfs:comment "Meta-class for specific action types recognized by the ProEthica system"@en .

# :CapabilityType meta-class retired 2026-06-28 (ratified Ca spec): it had no members; the
# capability kind taxonomy is the canonical reuse list below, each subClassOf proeth-core:Capability.

#################################################################
# Action Categories from Chapter 2.2.6 Literature
# Based on professional decisions and volitional interventions
# RETIRED (ONT-4, 2026-07-01): all owl:deprecated; Action is bare (no subtype).
# See the ONT-4 deprecation block after the Event categories below.
#################################################################

#################################################################
# Event Categories from Chapter 2.2.7 Literature
# Based on temporal occurrences that trigger ethical consideration
# RETIRED (ONT-4, 2026-07-01): all owl:deprecated; an Event is typed only to one of
# the three core ORIGIN subclasses (AgentCausedEvent/ExogenousEvent/AutomaticEvent).
# See the ONT-4 deprecation block after this section.
#################################################################

# Event properties for temporal relationships
proeth:triggersObligation a owl:ObjectProperty ;
    rdfs:domain proeth-core:Event ;
    rdfs:range proeth-core:Obligation ;
    rdfs:label "triggers obligation"@en ;
    rdfs:comment "Relates an event to obligations it activates"@en .

proeth:causedByAction a owl:ObjectProperty ;
    rdfs:domain proeth-core:Event ;
    rdfs:range proeth-core:Action ;
    rdfs:label "caused by action"@en ;
    rdfs:comment "Links event to actions that caused it (Wright's NESS test)"@en ;
    dcterms:references <https://doi.org/10.1007/978-3-031-21203-1_15> . # Sarmiento et al. 2023

proeth:altersPriority a owl:ObjectProperty ;
    rdfs:domain proeth-core:Event ;
    rdfs:range proeth-core:Obligation ;
    rdfs:label "alters priority"@en ;
    rdfs:comment "Indicates how events change obligation priorities"@en .

# Causal-chain class + endpoint edges (Step-3 Stage-5 causal analysis; Sarmiento et al.
# 2023 NESS). cause/effect omit rdfs:range deliberately: their endpoints are Action OR
# Event, and the Action/Event union is enforced at edge materialization by the unified
# domain/range guard (rpo_edges._CAUSAL_EDGE_RANGE) rather than by a blank-node owl:unionOf.
proeth:CausalChain a owl:Class ;
    rdfs:label "Causal Chain"@en ;
    iao:0000115 "A cause-to-effect linkage in the case timeline carrying a NESS responsibility analysis (Sarmiento et al. 2023). Not one of the nine disjoint D-tuple categories."@en ;
    rdfs:comment "A cause-to-effect linkage in the case timeline carrying a NESS responsibility analysis (Sarmiento et al. 2023). Not one of the nine disjoint D-tuple categories."@en .

proeth:analyzesAction a owl:ObjectProperty ;
    rdfs:domain proeth:CausalChain ;
    rdfs:range proeth-core:Action ;
    rdfs:label "analyzes action"@en ;
    rdfs:comment "Links a synthesis causal-normative-link (reasoning) node to the committed Action it analyzes, so the reasoning is grounded in the graph and the action's obligation edges are reachable from it. Domain CausalChain (the non-D-tuple reasoning node), matching its sibling causal properties cause / effect / responsibleAgent, so there is no disjointness impact on the nine D-tuple categories; range Action."@en .

proeth:cause a owl:ObjectProperty ;
    rdfs:domain proeth:CausalChain ;
    rdfs:label "cause"@en ;
    rdfs:comment "Links a causal chain to the Action or Event that is its cause."@en .

proeth:effect a owl:ObjectProperty ;
    rdfs:domain proeth:CausalChain ;
    rdfs:label "effect"@en ;
    rdfs:comment "Links a causal chain to the Action or Event that is its effect or outcome."@en .

proeth:responsibleAgent a owl:ObjectProperty ;
    rdfs:domain proeth:CausalChain ;
    rdfs:range proeth-core:Agent ;
    rdfs:label "responsible agent"@en ;
    rdfs:comment "Links a causal chain to the agent(s) bearing responsibility for it (NESS causal responsibility, Sarmiento et al. 2023)."@en ;
    dcterms:references <https://doi.org/10.1007/s10458-023-09609-6> .

###############################################################
# OWL-Time Temporal Properties (Allen Interval Algebra)
# Maps to http://www.w3.org/2006/time# vocabulary
###############################################################

proeth:temporalMarker a owl:DatatypeProperty ;
    rdfs:domain [ a owl:Class ; owl:unionOf (proeth-core:Action proeth-core:Event) ] ;
    rdfs:range xsd:string ;
    rdfs:label "temporal marker"@en ;
    rdfs:comment "Narrative temporal marker indicating when an action or event occurred in case time (e.g. 'During preliminary design phase', 'Several months later'). Cases use narrative rather than calendar time."@en .

proeth:temporalSequence a owl:DatatypeProperty ;
    rdfs:domain [ a owl:Class ; owl:unionOf (proeth-core:Action proeth-core:Event) ] ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:label "temporal sequence"@en ;
    rdfs:comment "Chronological position of an action or event within its case, 1-based, no gaps. Populated by an LLM ordering pass over the case's actions and events; consumed by the validation Timeline view to render entries in chronological order. Free-text temporalMarker is the human-readable signal; temporalSequence is the sortable companion."@en .

proeth:TemporalRelation a owl:Class ;
    rdfs:label "Temporal Relation"@en ;
    iao:0000115 "A reified Allen interval algebra relation between two temporal entities (actions or events). Stores both the ProEthica relation name and the corresponding OWL-Time property URI."@en ;
    rdfs:comment "A reified Allen interval algebra relation between two temporal entities (actions or events). Stores both the ProEthica relation name and the corresponding OWL-Time property URI."@en .

proeth:hasTemporalRelation a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ; owl:unionOf (proeth-core:Action proeth-core:Event) ] ;
    rdfs:range proeth:TemporalRelation ;
    rdfs:label "has temporal relation"@en ;
    rdfs:comment "Links an action or event to a reified Allen interval relation instance."@en .

proeth:fromEntity a owl:ObjectProperty ;
    rdfs:domain proeth:TemporalRelation ;
    rdfs:range [ a owl:Class ; owl:unionOf (proeth-core:Action proeth-core:Event) ] ;
    rdfs:label "from entity"@en ;
    rdfs:comment "The source entity in a temporal relation (Entity1 [relation] Entity2)."@en .

proeth:toEntity a owl:ObjectProperty ;
    rdfs:domain proeth:TemporalRelation ;
    rdfs:range [ a owl:Class ; owl:unionOf (proeth-core:Action proeth-core:Event) ] ;
    rdfs:label "to entity"@en ;
    rdfs:comment "The target entity in a temporal relation (Entity1 [relation] Entity2)."@en .

proeth:allenRelation a owl:DatatypeProperty ;
    rdfs:domain proeth:TemporalRelation ;
    rdfs:range xsd:string ;
    rdfs:label "Allen relation"@en ;
    rdfs:comment "The Allen interval algebra relation name (before, after, meets, overlaps, during, starts, finishes, equals, and their inverses). Maps to OWL-Time properties via services/allen_owl_time_mapper.py."@en .

proeth:owlTimeProperty a owl:DatatypeProperty ;
    rdfs:domain proeth:TemporalRelation ;
    rdfs:range xsd:string ;
    rdfs:label "OWL-Time property"@en ;
    rdfs:comment "The corresponding OWL-Time property name (e.g. time:before, time:intervalMeets). See W3C OWL-Time ontology."@en .

:ProfessionalObligation rdf:type owl:Class ;
    # NOTE: bfo:BFO_0000017 (realizable entity / SDC) removed, it conflicts with proeth-core:Obligation
    # which is IAO:directive information entity (GDC). BFO GDC and SDC are mutually exclusive,
    # so having both superclasses would make this class unsatisfiable in a reasoning context.
    rdfs:subClassOf proeth-core:Obligation ;
    rdfs:label "Professional Obligation"@en ;
    iao:0000115 "The umbrella for duties that arise specifically from bearing a professional role or from professional standards, and the parent of role-derived duty kinds such as FaithfulAgentObligation. Distinguished from its parent proeth-core:Obligation, which covers any professional-ethics obligation regardless of how it arises. As a directive information entity (IAO:0000033 via proeth-core:Obligation), it is a generically dependent continuant, not a realizable entity."@en ;
    rdfs:comment "Umbrella for role-derived professional duties; parent of FaithfulAgentObligation and kin. As a directive information entity it is a generically dependent continuant, not a realizable entity."@en ;
    skos:changeNote "v2.x: Removed rdfs:subClassOf bfo:BFO_0000017 (realizable entity/SDC). Obligations are directive information entities (GDC), and SDC+GDC dual-inheritance is inconsistent in BFO."@en .

# Obligation Categories from Chapter 2 Literature
# Based on Dennis et al. (2016), Anderson & Anderson, NSPE Code

proeth:DisclosureObligation a owl:Class ;
    rdfs:subClassOf proeth-core:Obligation ;
    rdfs:label "Disclosure Obligation"@en ;
    iao:0000115 "Requirement to inform stakeholders about conflicts, limitations, or risks (NSPE II.3.a)"@en ;
    rdfs:comment "Requirement to inform stakeholders about conflicts, limitations, or risks (NSPE II.3.a)"@en .

proeth:SafetyObligation a owl:Class ;
    rdfs:subClassOf proeth-core:Obligation ;
    rdfs:label "Safety Obligation"@en ;
    iao:0000115 "Duty to hold paramount the safety, health, and welfare of the public (NSPE I.1)"@en ;
    rdfs:comment "Duty to hold paramount the safety, health, and welfare of the public (NSPE I.1)"@en .

proeth:CompetenceObligation a owl:Class ;
    rdfs:subClassOf proeth-core:Obligation ;
    rdfs:label "Competence Obligation"@en ;
    iao:0000115 "Requirement to perform services only in areas of competence (NSPE II.2)"@en ;
    rdfs:comment "Requirement to perform services only in areas of competence (NSPE II.2)"@en .

proeth:ConfidentialityObligation a owl:Class ;
    rdfs:subClassOf proeth-core:Obligation ;
    rdfs:label "Confidentiality Obligation"@en ;
    iao:0000115 "Duty to protect confidential information of clients or employers (NSPE III.4)"@en ;
    rdfs:comment "Duty to protect confidential information of clients or employers (NSPE III.4)"@en .

proeth:ReportingObligation a owl:Class ;
    rdfs:subClassOf proeth-core:Obligation ;
    rdfs:label "Reporting Obligation"@en ;
    iao:0000115 "Duty to report violations or unsafe conditions to appropriate authorities"@en ;
    rdfs:comment "Duty to report violations or unsafe conditions to appropriate authorities"@en .

# The modality obligation subclasses (Mandatory/Defeasible/Conditional/PrimaFacie) were retired 2026-06-28
# (ratified O spec): prima-facie status is the defeasibility edge family (competesWith/prevailsOver/
# defeasibleUnder), hard absolutes are Constraints; the enforcement_level commit axis is removed with them.

proeth:LegalObligation a owl:Class ;
    rdfs:subClassOf proeth-core:Obligation ;
    rdfs:label "Legal Obligation"@en ;
    iao:0000115 "An obligation individuated by its SOURCE of bindingness: it binds because a law or regulation requires it. Contrast EthicalObligation (bindingness from the ethical code or an ethical principle). The source axis is orthogonal to the topic axis of the sibling classes (safety, disclosure, confidentiality, ...): an obligation may bear one type from each axis."@en ;
    rdfs:comment "Source-axis obligation kind: bound by law or regulation."@en ;
    skos:changeNote "2026-07-04: definition rewritten to state the source-vs-topic axis explicitly (pre-batch audit)."@en .

proeth:EthicalObligation a owl:Class ;
    rdfs:subClassOf proeth-core:Obligation ;
    rdfs:label "Ethical Obligation"@en ;
    iao:0000115 "An obligation individuated by its SOURCE of bindingness: it binds because the profession's ethical code or an ethical principle requires it, independently of legal enactment. Contrast LegalObligation (bindingness from law or regulation). The source axis is orthogonal to the topic axis of the sibling classes (safety, disclosure, confidentiality, ...): an obligation may bear one type from each axis."@en ;
    rdfs:comment "Source-axis obligation kind: bound by the ethical code or an ethical principle rather than by legal enactment (e.g. a duty to honor the spirit of the code)."@en ;
    skos:changeNote "2026-07-04: definition rewritten to state the source-vs-topic axis explicitly (pre-batch audit: the two classification axes among Obligation subclasses were undocumented)."@en .

proeth:CollegialObligation a owl:Class ;
    rdfs:subClassOf proeth-core:Obligation ;
    rdfs:label "Collegial Obligation"@en ;
    iao:0000115 "Duties toward professional peers including respect, fairness, and credit for work"@en ;
    rdfs:comment "Duties toward professional peers including respect, fairness, and credit for work"@en .

proeth:AttributionObligation a owl:Class ;
    rdfs:subClassOf proeth-core:Obligation ;
    rdfs:label "Attribution Obligation"@en ;
    iao:0000115 "Duty to give credit for engineering work to those to whom credit is due and to recognize the proprietary interests of others, including appropriate citation of documents of technical authority and credit for tool-assisted or AI-assisted content (NSPE III.9)"@en ;
    rdfs:comment "Duty to give credit for engineering work to those to whom credit is due and to recognize the proprietary interests of others, including appropriate citation of documents of technical authority and credit for tool-assisted or AI-assisted content (NSPE III.9)"@en ;
    skos:altLabel "attribution and credit obligation"@en, "credit obligation"@en ;
    proeth:nspeReference "Professional Obligation III.9" ;
    skos:changeNote "Added 2026-07-02 (definition-prompt audit Stage 2): canonical home for the NSPE III.9 credit duty, which previously forked between DisclosureObligation and an LLM-minted extended-store near-duplicate because the obligationType enum lacked 'attribution'. Supersedes the extended-store discovery of the same IRI; the obligationType routing value 'attribution' commits here."@en .

# NSPE Code-specific obligation subclasses used by NSPE BER case ontologies
# (e.g. Case 72, Public Welfare, Knowledge of Information Damaging to Client's Interest).

proeth:FaithfulAgentObligation a owl:Class ;
    rdfs:subClassOf proeth:ProfessionalObligation ;
    skos:changeNote "2026-07-04: re-parented from ConfidentialityObligation to ProfessionalObligation (pre-batch core audit). Faithful agency (NSPE I.4 / II.4) is an agency-and-loyalty duty, not a confidentiality duty (II.1.c); the old placement entailed that every faithful-agent duty is a confidentiality duty."@en ;
    rdfs:label "Faithful Agent Obligation"@en ;
    iao:0000115 "Duty of an engineer to act as a faithful agent or trustee of an employer or client (NSPE Code of Ethics, Section 1 / §II.4). Defeasible under states that confirm public-safety risk."@en ;
    rdfs:comment "Duty of an engineer to act as a faithful agent or trustee of an employer or client (NSPE Code of Ethics, Section 1 / §II.4). Defeasible under states that confirm public-safety risk."@en .

# Obligation properties for temporal and contextual aspects
proeth:hasEnforcementLevel a owl:DatatypeProperty ;  # was owl:ObjectProperty, corrected: range is xsd:string
    rdfs:range xsd:string ;
    rdfs:label "has enforcement level"@en ;
    rdfs:comment "Specifies whether obligation is mandatory, strongly recommended, or recommended"@en ;
    skos:changeNote "v2.x: Changed from owl:ObjectProperty to owl:DatatypeProperty. Properties with rdfs:range xsd:string must be DatatypeProperties."@en .

# Provenance datatype properties used by the extraction client when it
# materializes typed individuals from case narratives. These record the
# narrative source text for a typed individual and the agent to whom an
# obligation is attributed. They are emitted by the LLM extraction client
# described in Section 4 of the KI2026 paper.

proeth:sourcetext a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "source text"@en ;
    rdfs:comment "The narrative sentence or clause from a case text that grounds a typed individual. Preserved as a string alongside each extracted State, Action, Event, or Obligation to support provenance and qualitative inspection."@en .

proeth:obligatedparty a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "obligated party"@en ;
    rdfs:comment "The agent label to which an obligation is attributed in a case (e.g. 'Engineer Doe'). This is a string rather than an Agent individual so that case text phrasing is preserved verbatim."@en .



# Engineering-specific role types
:EngineerRole rdf:type owl:Class ;
    rdfs:label "Engineer Role"@en ;
    iao:0000115 "A professional role involving engineering practice and responsibilities. Occupational archetype head for all engineer specializations and extracted engineer-role leaves."@en ;
    rdfs:comment "A professional role involving engineering practice and responsibilities. Occupational archetype head for all engineer specializations and extracted engineer-role leaves."@en ;
    skos:closeMatch ifcrole:Engineer ;
    :archetypeAxis :OccupationalArchetype ;
    skos:altLabel "engineer"@en, "engineering"@en ;
    rdfs:subClassOf :ProfessionalRole .

# Role specializations for classification of roles mentioned in guidelines and cases
:ProfessionalRole rdf:type owl:Class ;
    rdfs:subClassOf proeth-core:Role ;
    rdfs:label "Professional Role"@en ;
    iao:0000115 "A role borne by an agent who practices a profession. A professional role carries obligations that derive from the recognized ends of the profession (in engineering, safeguarding public safety, health, and welfare and delivering competent technical work) and that are codified in an ethical code such as the NSPE Code of Ethics. The code binds whoever claims the professional standing; licensure is a fact about the individual bearer, not part of the role type (Davis 1991). Examples include Engineer, Project Manager, Architect, and Consultant."@en ;
        rdfs:comment "A role borne by an agent who practices a profession. A professional role carries obligations that derive from the recognized ends of the profession (in engineering, safeguarding public safety, health, and welfare and delivering competent technical work) and that are codified in an ethical code such as the NSPE Code of Ethics. The code binds whoever claims the professional standing; licensure is a fact about the individual bearer, not part of the role type (Davis 1991). Examples include Engineer, Project Manager, Architect, and Consultant."@en ;
        iao:0000116 "Operationalizes the professional side of the universal core:Role. The obligation-generation differentia that the core Role definition attributes to professional roles is axiomatized on this class by its two restrictions, rdfs:subClassOf (proeth-core:hasObligation some proeth-core:Obligation) and rdfs:subClassOf (:governedByCode some :EthicalCode). Obligation generation from the ends of the profession follows the teleological account of Oakley and Cocking (2001); code-binding on whoever claims the professional standing, independent of licensure, follows Davis (1991). Extraction framing: classify an actor professional-side when the case shows professional practice under code-governed duties, not from the presence of a license or title."@en ;
        iao:0000119 "Oakley and Cocking (2001). Virtue Ethics and Professional Roles. Cambridge University Press." ,
                    "Davis (1991). Thinking Like an Engineer: The Place of a Code of Ethics in the Practice of a Profession. Philosophy & Public Affairs 20(2): 150-167." ;
        skos:scopeNote "This class carries the professional-side commitments only, the obligation-existence and code-governance restrictions and the professional-side property domains (governedByCode, pursuesEnd, owesDutyToward). Universal role semantics (principle and obligation filtering, individuation, the archetype axes) stay on core:Role; which profession a role belongs to goes on the occupational subclasses (EngineerRole, ArchitectRole, ConsultantRole, ProjectManagerRole, RegulatoryAuthorityRole). Per-occupant facts (license, specialty, employer, experience) attach to the role individual per ProfessionalRolePropertyShape, not to this class; nearly 90 percent of US engineers practice unlicensed under the manufacturer's exemption yet remain code-bound (Davis 1991, p. 157 n. 7)."@en ;
        skos:changeNote "2026-07-06: definition rewritten from the 2025-09-12 text, which foregrounded licensure (often associated with licensure or formal accountability) against Davis 1991 and the core Role v2.10.4 scope note, and listed Public Official, an example with no dissertation basis and no declared class. The differentia is restated as code-codified obligation generation from the recognized ends of the profession; examples align to the declared occupational heads; the iao:0000116, iao:0000119, and skos:scopeNote apparatus added."@en ;
        # Professional roles characteristically bear obligations and are governed by codes
        # v2.4.2: Fixed namespace references -- :Obligation and :hasObligation resolved to
        # intermediate namespace where they were never defined. Corrected to proeth-core:.
        rdfs:subClassOf [ a owl:Restriction ;
                                         owl:onProperty proeth-core:hasObligation ;
                                         owl:someValuesFrom proeth-core:Obligation
                                     ] ;
        rdfs:subClassOf [ a owl:Restriction ;
                                         owl:onProperty :governedByCode ;
                                         owl:someValuesFrom :EthicalCode
                                     ] .

:ParticipantRole rdf:type owl:Class ;
    rdfs:subClassOf proeth-core:Role ;
    rdfs:label "Participant Role"@en ;
    skos:altLabel "Stakeholder"@en, "Stakeholder Role"@en ;
    iao:0000115 "A role borne by a party with standing in a case (a client, owner, employer, contractor, or affected member of the public) whose role type does not itself generate profession-based obligations and is not governed by a professional ethical code. Duties a participant holds from contract or law are case facts on the individual, not commitments of the role type. Examples include Client, Owner, Contractor, and Public."@en ;
    rdfs:comment "A role borne by a party with standing in a case (a client, owner, employer, contractor, or affected member of the public) whose role type does not itself generate profession-based obligations and is not governed by a professional ethical code. Duties a participant holds from contract or law are case facts on the individual, not commitments of the role type. Examples include Client, Owner, Contractor, and Public."@en ;
    skos:scopeNote "The disjointness with ProfessionalRole holds between role classes, not persons; the same person may bear a professional role in one engagement and a participant role in another (cf. the spheres-of-morality reading on core:Role). The class carries no obligation-existence commitment; the universal definitional schema is RoleDefinitionShape."@en ;
    skos:changeNote "2026-07-06: definition given a positive genus (standing in the case) and aligned to the declared participant heads; Community Member dropped (no declared class); the code-governance exclusion stated to match the narrowed governedByCode domain."@en .

# Keep ProfessionalRole and ParticipantRole disjoint to avoid mixing semantics
:ProfessionalRole owl:disjointWith :ParticipantRole .

# Relational axis head. The duty-relationship archetypes below classify the
# relationship a role establishes (provider-client, professional-peer, employer),
# orthogonal to the occupational axis (ProfessionalRole/ParticipantRole). A
# relational archetype spans both occupational sides (a provider-client relation
# has a professional provider and a participant client), so it sits under
# RelationalRole, NOT under either side of the occupational disjointness;
# otherwise composing it with a Participant-side occupational archetype (e.g.
# ClientRole) would be unsatisfiable.
:RelationalRole rdf:type owl:Class ;
    rdfs:subClassOf proeth-core:Role ;
    rdfs:label "Relational Role"@en ;
    iao:0000115 "Head of the relational archetype axis, the duty-relationship a role establishes. Orthogonal to the occupational axis, so a relational archetype composes with any occupational archetype without crossing the ProfessionalRole/ParticipantRole disjointness. Exception: :PublicResponsibilityRole, whose defining :owesDutyToward edge has rdfs:domain :ProfessionalRole, is professional-side by entailment and (since 2026-07-02) by an explicit rdfs:subClassOf :ProfessionalRole, so it composes only with professional-side occupational archetypes. Does not self-tag :archetypeAxis; as the structural head of the axis it needs no marker, and the annotation marks only leaves whose archetype diverges from their structural parent (e.g. a relational Mentor/Forensic engagement under the occupational EngineerRole)."@en ;
    rdfs:comment "Head of the relational archetype axis, the duty-relationship a role establishes. Orthogonal to the occupational axis, so a relational archetype composes with any occupational archetype without crossing the ProfessionalRole/ParticipantRole disjointness. Exception: :PublicResponsibilityRole, whose defining :owesDutyToward edge has rdfs:domain :ProfessionalRole, is professional-side by entailment and (since 2026-07-02) by an explicit rdfs:subClassOf :ProfessionalRole, so it composes only with professional-side occupational archetypes. Does not self-tag :archetypeAxis; as the structural head of the axis it needs no marker, and the annotation marks only leaves whose archetype diverges from their structural parent (e.g. a relational Mentor/Forensic engagement under the occupational EngineerRole)."@en .

#################################################################
# Professional Role Categories from Chapter 2.2.1 Literature
#################################################################

# Based on Kong et al. (2020) empirical analysis and Dennis et al. (2016) role-based filtering

# Four relational archetypes derived from the Kong et al. (2020) audience-category inventory (Provider
# to client, Professional peer, Employer, Public) are DEFINED classes (owl:equivalentClass): the reasoner
# classifies a role into its relational archetype from the role-to-role relationship edge it bears
# (provider/peer/employer/public-duty), rather than from a hand-maintained annotation. The remaining
# Kong categories are deliberately not operationalized as role-to-role edges: General is the Kong
# residual no-audience code (an edge would be incoherent); Profession and Association are duties to a
# collectivity, carried by governedByCode and the obligation layer; Colleague (2% in engineering,
# undefined against Professional peer) folds into professionalPeerOf; the Witness/Court/Tax-authorities
# categories are law/accountancy-specific (expert-witness engagements are occupational leaves under
# ProviderClientRole). The defining
# filler is proeth-core:Role (NOT Agent: Role owl:disjointWith Agent, so an Agent filler would make the
# class vacuous). The rdfs:subClassOf :RelationalRole is asserted, not entailed (RelationalRole is a
# primitive head). Occupational counterparties stay primitive (the client is :ClientRole, etc.).
# Occupational-axis explicitness: only :PublicResponsibilityRole carries an occupational parent
# (rdfs:subClassOf :ProfessionalRole, 2026-07-02) because only its defining property has a domain
# on the occupational axis; hasClient/professionalPeerOf/employedBy carry rdfs:domain
# proeth-core:Role (hardened from schema:domainIncludes in core v2.10.3), and proeth-core:Role sits
# ABOVE both axes, so the other three archetypes remain provably axis-neutral and stay unparented
# by design (only a ProfessionalRole-level domain would break neutrality).

:ProviderClientRole rdf:type owl:Class ;
    owl:equivalentClass [ rdf:type owl:Class ; owl:intersectionOf (
        proeth-core:Role
        [ rdf:type owl:Restriction ; owl:onProperty proeth-core:hasClient ; owl:someValuesFrom proeth-core:Role ] ) ] ;
    rdfs:subClassOf :RelationalRole ;
    rdfs:label "Provider-Client Role" ;
    iao:0000115 "Professional role defining relationships between service providers and their clients, creating duties of confidentiality, conflict-of-interest avoidance, and protection of client interests per the Kong et al. (2020) identity-role analysis; competent service delivery attaches through the obligation layer (Kong codes competence under the General category, not provider-to-client)."@en ;
    skos:definition "Professional role defining relationships between service providers and their clients, creating duties of confidentiality, conflict-of-interest avoidance, and protection of client interests per the Kong et al. (2020) identity-role analysis; competent service delivery attaches through the obligation layer (Kong codes competence under the General category, not provider-to-client)." ;
    rdfs:comment "Service delivery relationship with duties of competence and care. Defined class: a Role that hasClient some Role (the provider side)." ;
    skos:scopeNote "Provider side: a Role bearing proeth-core:hasClient toward another Role. The client counterparty is the occupational :ClientRole (a :ParticipantRole). Asymmetric by design."@en ;
    dcterms:references <https://doi.org/10.1558/jalpp.39771> . # Kong et al. 2020

:ProfessionalPeerRole rdf:type owl:Class ;
    owl:equivalentClass [ rdf:type owl:Class ; owl:intersectionOf (
        proeth-core:Role
        [ rdf:type owl:Restriction ; owl:onProperty proeth-core:professionalPeerOf ; owl:someValuesFrom proeth-core:Role ] ) ] ;
    rdfs:subClassOf :RelationalRole ;
    rdfs:label "Professional Peer Role" ;
    iao:0000115 "Professional role defining relationships between practitioners within the same professional domain. Kong et al. (2020) identify the professional peer as a core audience category, marked by collegiality, cooperation, referral, and peer-to-peer communication; this ontology additionally covers mentoring engagements under the relation."@en ;
    skos:definition "Professional role defining relationships between practitioners within the same professional domain. Kong et al. (2020) identify the professional peer as a core audience category, marked by collegiality, cooperation, referral, and peer-to-peer communication; this ontology additionally covers mentoring engagements under the relation." ;
    rdfs:comment "Collegial relationship including mentoring. Defined class: a Role that professionalPeerOf some Role (symmetric; both peers classify)." ;
    skos:scopeNote "A Role bearing proeth-core:professionalPeerOf (symmetric) toward another Role; covers collegial engagements including mentoring. The directed reviewsWorkOf relation is deliberately independent (not a subproperty); reviewers need not be peers, so a review edge alone does not classify a role here."@en ;
    dcterms:references <https://doi.org/10.1558/jalpp.39771> . # Kong et al. 2020

:EmployerRelationshipRole rdf:type owl:Class ;
    owl:equivalentClass [ rdf:type owl:Class ; owl:intersectionOf (
        proeth-core:Role
        [ rdf:type owl:Restriction ; owl:onProperty proeth-core:employedBy ; owl:someValuesFrom proeth-core:Role ] ) ] ;
    rdfs:subClassOf :RelationalRole ;
    rdfs:label "Employer Relationship Role" ;
    iao:0000115 "Professional role defining relationships between professionals and their employing organizations, creating duties of loyalty, competent performance, and honest reporting while maintaining professional independence per Wendel (2024) moral complexity framework."@en ;
    skos:definition "Professional role defining relationships between professionals and their employing organizations, creating duties of loyalty, competent performance, and honest reporting while maintaining professional independence per Wendel (2024) moral complexity framework." ;
    rdfs:comment "Organizational relationship balancing loyalty and independence. Defined class: a Role that employedBy some Role (the employee/professional side)." ;
    skos:scopeNote "Employee/professional side: a Role bearing proeth-core:employedBy toward another Role. The employer counterparty is the occupational :EmployerRole (a :ParticipantRole)."@en ;
    dcterms:references <https://doi.org/10.1093/oso/9780197673423.003.0006> , # Wendel 2024 (duty content: loyalty, independence)
        <https://doi.org/10.1558/jalpp.39771> . # Kong et al. 2020 (Employer audience category)

:PublicResponsibilityRole rdf:type owl:Class ;
    owl:equivalentClass [ rdf:type owl:Class ; owl:intersectionOf (
        proeth-core:Role
        [ rdf:type owl:Restriction ; owl:onProperty :owesDutyToward ; owl:someValuesFrom :PublicInterest ] ) ] ;
    rdfs:subClassOf :RelationalRole ;
    rdfs:subClassOf :ProfessionalRole ;
    rdfs:subClassOf [ rdf:type owl:Restriction ; owl:onProperty proeth-core:adheresToPrinciple ; owl:someValuesFrom :PublicWelfarePrinciple ] ;
    rdfs:label "Public Responsibility Role" ;
    iao:0000115 "Professional role defining obligations to the broader public and society, creating duties of public welfare protection that can override client or employer interests, grounded in NSPE Fundamental Canon 1 (hold paramount the public safety, health, and welfare) and framed by Thornton et al. (2017) collective morality."@en ;
    skos:definition "Professional role defining obligations to the broader public and society, creating duties of public welfare protection that can override client or employer interests, grounded in NSPE Fundamental Canon 1 (hold paramount the public safety, health, and welfare) and framed by Thornton et al. (2017) collective morality." ;
    rdfs:comment "Societal obligation that can override other professional duties. Defined class (monadic): a Role that owesDutyToward some PublicInterest. Adheres to :PublicWelfarePrinciple, the principle carrying the NSPE Canon 1 grounding." ;
    skos:scopeNote "A Role bearing :owesDutyToward toward the general public (:PublicInterest). Monadic: the counterparty is a party class, not a role-to-role pairing."@en ;
    dcterms:source "NSPE Code of Ethics Fundamental Canon 1" ;
    proeth:nspeReference "Fundamental Canon 1" ;
    skos:changeNote "2026-07-02: added the explicit rdfs:subClassOf :ProfessionalRole (the case-4 run-20 lesson). The class was already professional-only by ENTAILMENT -- the owl:equivalentClass restriction on :owesDutyToward plus that property's rdfs:domain :ProfessionalRole entail ProfessionalRole for every instance -- but not by an asserted rdfs:subClassOf edge, so chain-based commit guards (which walk asserted subClassOf only) could not see its professional side. A case-4 role individual was committed typed both :PublicRole (a :ParticipantRole descendant) and :PublicResponsibilityRole, which Pellet rejects under the ProfessionalRole/ParticipantRole disjointness. The assertion adds no new entailment; it is semantically honest (this is the engineer-side duty-toward-the-public role, not the public's own role, which is :PublicRole) and makes the professional side visible to subclass-closure guards."@en ;
    dcterms:references <https://doi.org/10.1109/TITS.2016.2609339> . # Thornton et al. 2017 (collective-morality framing)

# Public-duty primitives for the PublicResponsibilityRole defined class. PublicInterest is the general
# public as a collective party (subClassOf proeth-core:Agent, matching the actor-edge convention:
# obligatedParty/constrainedEntity/affects all range Agent). owesDutyToward is the defining edge.
:PublicInterest rdf:type owl:Class ;
    rdfs:subClassOf proeth-core:Agent ;
    rdfs:label "Public Interest (General Public)"@en ;
    iao:0000115 "The general public as the collective party toward which public-protection duties are owed (the defining counterparty of :PublicResponsibilityRole). The occupational role borne by this party is :PublicRole."@en ;
    skos:altLabel "general public"@en, "the public"@en ;
    rdfs:comment "The general public as the collective party toward which public-protection duties are owed (the defining counterparty of :PublicResponsibilityRole). The occupational role borne by this party is :PublicRole."@en .

:owesDutyToward rdf:type owl:ObjectProperty ;
    rdfs:domain :ProfessionalRole ;
    rdfs:range :PublicInterest ;
    rdfs:label "owes duty toward"@en ;
    rdfs:comment "A professional role owes a protective duty toward the general public. Defining edge of :PublicResponsibilityRole; operationalizes NSPE Fundamental Canon 1 (hold paramount the public safety, health, and welfare). Domain is :ProfessionalRole rather than the universal core:Role, because the paramount public duty is a professional-code obligation borne by professional roles, not by every role."@en .

# Ends / Goals of roles
:End rdf:type owl:Class ;
    rdfs:subClassOf bfo:BFO_0000031 ; # generically dependent continuant
    rdfs:label "End/Goal"@en ;
    iao:0000115 "A characteristic end of professional practice toward which a role is directed and by whose service the role is evaluated, qualifying by the key human good it serves (in engineering: protecting public safety, serving the public welfare, providing competent service)."@en ;
    rdfs:comment "A characteristic end of professional practice toward which a role is directed and by whose service the role is evaluated, qualifying by the key human good it serves (in engineering: protecting public safety, serving the public welfare, providing competent service)."@en ;
    iao:0000119 "Oakley and Cocking (2001). Virtue Ethics and Professional Roles. Cambridge University Press." .

# Resource kinds: the closed FIVE source kinds (ratified Rs spec; ProfessionalCode merged into
# EthicalCode 2026-07-01). EthicalCode is the formal ethical-code document (rdfs:subClassOf
# proeth-core:Guideline, itself rdfs:subClassOf proeth-core:Resource since v2.7.3); the other
# four (TechnicalStandard, CasePrecedent, LegalResource, ReferenceMaterial) are declared in the
# Professional Resource Types block below, each rdfs:subClassOf proeth-core:Resource. :Standard
# retired 2026-06-28: a generic standard folds into :TechnicalStandard; the disposable corpus
# re-mints any survivor at re-extraction.
:EthicalCode rdf:type owl:Class ;
    rdfs:subClassOf proeth-core:Guideline ;
    rdfs:label "Ethical Code"@en ;
    iao:0000115 "A formal document that codifies ethical principles and professional conduct requirements for a profession (e.g. the NSPE, IEEE, or ACM code of ethics). As a document (IAO:0000310 via Guideline) it contains principles, obligations, and constraints, and is itself a professional-knowledge Resource; it is not itself a principle. As an ethics knowledge resource it is grounded in Frankel (1989), who frames a code as an enabling document distilling collective professional experience, and Davis (1991), who frames it as a convention among professionals."@en ;
    rdfs:comment "A formal document that codifies ethical principles and professional conduct requirements for a profession (e.g. the NSPE, IEEE, or ACM code of ethics). As a document (IAO:0000310 via Guideline) it contains principles, obligations, and constraints, and is itself a professional-knowledge Resource; it is not itself a principle. As an ethics knowledge resource it is grounded in Frankel (1989), who frames a code as an enabling document distilling collective professional experience, and Davis (1991), who frames it as a convention among professionals."@en ;
    skos:scopeNote "Attribution: Frankel (1989) 'Professional Codes: Why, How, and with What Impact?' and Davis (1991) 'Thinking Like an Engineer'. McLaren (2003) USES codes as extensional inputs but does not originate this resource type."@en ;
    skos:changeNote "v2.4.2: Changed rdfs:subClassOf from proeth-core:Principle to proeth-core:Guideline. An ethical code is a document that contains principles, obligations, and constraints. Classifying it as a Principle conflated the container with its contents. 2026-07-01: absorbed :ProfessionalCode (now owl:equivalentClass, deprecated); the two denoted the same code-of-ethics document; the Frankel/Davis grounding moved here."@en .

# :TechnicalCapability retired 2026-06-28: superseded by the canonical Capability kinds
# (ratified Ca spec); a technical competence is one of the named competence kinds below.

# :Measurement retired 2026-06-28: not one of the closed six Resource kinds (ratified Rs spec);
# a measurement or assessment artifact is captured by the State layer, not a Resource subclass.

#################################################################
#    Normative refinements (subclasses, non-breaking)            
#################################################################

# Compliance tracking

# :Justification retired 2026-06-28: not one of the closed six Resource kinds (ratified Rs spec);
# a rationale or argument is captured by the normative components and their PROV-O derivations.

#################################################################
#    Annotation properties                                        
#################################################################

:hasValueLabel rdf:type owl:AnnotationProperty ;
    rdfs:label "has value label"@en ;
    rdfs:comment "Annotation for recording the value-oriented reading of a principle (e.g., 'Integrity', 'Justice')."@en ;
    rdfs:domain proeth-core:Principle ;
    rdfs:range xsd:string .

#################################################################
#    Object Properties                                           
#################################################################

:hasResource rdf:type owl:ObjectProperty ;
    rdfs:domain bfo:BFO_0000015 ; # process
    rdfs:range proeth-core:Resource ;
    rdfs:label "has resource"@en ;
    rdfs:comment "Relates a process to a resource it uses"@en ;
    skos:changeNote "v2.4.2: Fixed range from :Resource (undefined in intermediate namespace) to proeth-core:Resource."@en .

# v2.8.0: the deprecated intermediate :fulfillsObligation equivalentProperty bridge
# was deleted. proeth-core:fulfillsObligation is the single canonical property; no
# intermediate alias remains.

:hasAgentRole rdf:type owl:ObjectProperty ;
    rdfs:domain proeth-core:Action ;
    rdfs:range proeth-core:Role ;
    rdfs:label "has agent role"@en ;
    rdfs:comment "Relates an action to the role of the agent performing it."@en .

:pursuesEnd rdf:type owl:ObjectProperty ;
    rdfs:domain :ProfessionalRole ;
    rdfs:range :End ;
    rdfs:label "pursues end"@en ;
    rdfs:comment "Relates a professional role to a characteristic end of professional practice that the role serves. Operationalizes the teleological account of Oakley and Cocking (2001), under which professional roles are governed teleologically by the proper ends of the profession and role demands are determined by reference to those ends. Domain is :ProfessionalRole rather than the universal core:Role, because characteristic ends are the teleological differentia of professional roles; the goals of a participant are case facts, not role-defining ends."@en .

:governedByCode rdf:type owl:ObjectProperty ;
    rdfs:domain :ProfessionalRole ;
    rdfs:range :EthicalCode ;
    rdfs:label "governed by code"@en ;
    rdfs:comment "Relates a professional role to an ethical code that states the obligations and norms of the role in codified form. The code is a convention among professionals that binds whoever claims the professional standing, independent of licensure (Davis 1991); it does not exhaust role morality, since the norms of the profession remain answerable to the proper ends of the profession (Oakley and Cocking 2001, p. 75). Domain is :ProfessionalRole rather than the universal core:Role, because code-governance is a professional-side relation; the ProfessionalRole restriction (governedByCode some EthicalCode) carries the existence commitment."@en .


#################################################################
#    Provision-Concept Relationships
#################################################################

# These properties link ethical code provisions to the concepts they establish
# Used to trace how specific code sections ground principles, obligations, and constraints

:establishes rdf:type owl:ObjectProperty ;
    rdfs:domain [ rdf:type owl:Class ;
                  owl:unionOf ( proeth-core:Resource proeth-core:CodeProvision ) ] ;
    skos:changeNote "2026-07-04: domain widened to include CodeProvision (an information content entity, not a Resource); the property comment always described provisions as subjects, so the old Resource-only domain would have retyped provision subjects into Resource against the ICE placement."@en ;
    rdfs:range [ rdf:type owl:Class ;
                 owl:unionOf ( proeth-core:Principle proeth-core:Obligation proeth-core:Constraint ) ] ;
    rdfs:label "establishes"@en ;
    rdfs:comment "Relates a code provision to the ethical concepts (Principles, Obligations, Constraints) it establishes or reinforces. For example, NSPE Canon I.1 establishes the Public Safety Principle."@en ;
    dcterms:source <https://doi.org/10.1016/S0004-3702(03)00135-8> . # McLaren 2003 - extensional grounding

:establishedBy rdf:type owl:ObjectProperty ;
    owl:inverseOf :establishes ;
    rdfs:domain [ rdf:type owl:Class ;
                  owl:unionOf ( proeth-core:Principle proeth-core:Obligation proeth-core:Constraint ) ] ;
    rdfs:range proeth-core:Resource ;
    rdfs:label "established by"@en ;
    rdfs:comment "Inverse of establishes. Relates an ethical concept to the code provision(s) that establish it. For example, Public Safety Principle is established by NSPE Canon I.1."@en .

#################################################################
#    State Classes - Based on Chapter 2.2.4 Literature Review
#################################################################

# =================================================================
# STATE ARCHETYPES (content axis, revised 2026-06-28, spec B1)
# =================================================================
# A state's KIND is a CONTENT classification: what condition holds in the
# situation, not the deontic relation the edge layer encodes. The earlier
# "deontic-function archetype" framing is retired because it invited the
# reading that a state's kind is the activatesObligation relation it bears.
# It is not. A RiskState is a condition of hazard exposure in the world; it is
# not recoverable from activatesObligation and is not a static shadow of any
# edge. The kind is grounded by content. The deontic relevance of that content
# (a risk condition bears on safety obligations; an epistemic condition bears
# on disclosure duties) is the reason the axis is kept, but the archetype is
# defined by what the state IS, while the edge layer (activatesObligation,
# activatesConstraint, defeasibleUnder, activatedByEvent / terminatedByEvent,
# initiates / terminates, affects) separately records what the state DOES.
#
# Closed set of nine content archetypes, each rdfs:subClassOf proeth-core:State:
# EpistemicState, RiskState, CompetenceState, EmergencyState,
# ConflictOfInterestState, RegulatoryState, TemporalState, ResourceState,
# DisclosureState. EpistemicState is the typed home for the responsibility
# epistemic condition, the agent's knowledge state, which is the Aristotelian
# and Sarmiento knowledge condition for responsibility; it is retained as a
# typed kind once agent_knowledge is dropped at the Action pass.
#
# Compound discovered-class leaves chain through their archetype
# (ToolRelianceState subClassOf RiskState; CompetenceGapState subClassOf
# CompetenceState), so every State individual reaches proeth-core:State through
# exactly one archetype. The reuse-first machinery controls proliferation of
# the leaf layer; the closed nine are fixed here.
#
# persistenceType is a class-level datatype on each archetype recording the
# Berreby et al. (2017) Event-Calculus fluent character (inertial fluents
# persist until terminated; non_inertial fluents hold momentarily). urgencyLevel
# stays individual-level (Jones 1991 salience is a per-occurrence attribute, not
# a subkind). The archetypes are intentionally non-disjoint: one condition can
# fall under several content kinds at once (a risk that also creates a conflict
# of interest).
#
# Grounding: Berreby et al. (2017) Event-Calculus fluents; Almpani et al. (2023)
# context-based dynamic obligation priorities; Sarmiento et al. (2023) causal
# chains initiating states; Stenseke (2024) obligation-presupposes-capacity;
# Govindarajulu & Bringsjord (2017) obligation's dependence on the knowledge
# state.
# =================================================================

:EpistemicState a owl:Class ;
    rdfs:subClassOf proeth-core:State ;
    rdfs:label "Epistemic State"@en ;
    iao:0000115 "A condition of what an agent knows, believes, or is uncertain of with respect to facts material to a decision. As a content kind it captures the agent's knowledge state, the Aristotelian and Sarmiento epistemic condition for responsibility: an agent is answerable for conduct in proportion to what the agent knew or should have known. Its deontic relevance is that knowledge conditions the obligations governing informed decision and decision-under-uncertainty."@en ;
    skos:definition "A condition of what an agent knows, believes, or is uncertain of with respect to facts material to a decision. As a content kind it captures the agent's knowledge state, the Aristotelian and Sarmiento epistemic condition for responsibility: an agent is answerable for conduct in proportion to what the agent knew or should have known. Its deontic relevance is that knowledge conditions the obligations governing informed decision and decision-under-uncertainty."@en ;
    rdfs:comment "Knowledge-and-belief condition of an agent; the typed home of the responsibility epistemic condition."@en ;
    proeth:persistenceType "inertial" ;
    dcterms:references <https://doi.org/10.24963/ijcai.2017/658> . # Govindarajulu & Bringsjord 2017

:RiskState a owl:Class ;
    rdfs:subClassOf proeth-core:State ;
    rdfs:label "Risk State"@en ;
    iao:0000115 "A condition of hazard exposure: potential harm to public welfare, safety, or a protected interest. As a content kind it is the situation of exposure itself, independent of which obligation it activates. Its deontic relevance is that a hazard condition bears on the protective obligations a role exists to discharge and can license defeat of competing duties such as confidentiality when the harm is grave (Berreby et al. 2017; Almpani et al. 2023)."@en ;
    skos:definition "A condition of hazard exposure: potential harm to public welfare, safety, or a protected interest. As a content kind it is the situation of exposure itself, independent of which obligation it activates. Its deontic relevance is that a hazard condition bears on the protective obligations a role exists to discharge and can license defeat of competing duties such as confidentiality when the harm is grave (Berreby et al. 2017; Almpani et al. 2023)."@en ;
    rdfs:comment "Condition of hazard exposure or potential harm to a protected interest."@en ;
    proeth:persistenceType "inertial" ;
    dcterms:references <https://doi.org/10.65109/hhri9090> , # Berreby et al. 2017
                       <https://doi.org/10.2478/sh-2022-0015> . # Almpani et al. 2023

:CompetenceState a owl:Class ;
    rdfs:subClassOf proeth-core:State ;
    rdfs:label "Competence State"@en ;
    iao:0000115 "A condition bearing on whether a role-bearer has the capacity, expertise, qualification, or means to carry out a duty. As a content kind it describes the standing of the agent's competence for the work at hand. Its deontic relevance is that obligation presupposes capacity, so a competence shortfall renders an attached duty defeasible or shifts it, for example to refer or disclose (Stenseke 2024)."@en ;
    skos:definition "A condition bearing on whether a role-bearer has the capacity, expertise, qualification, or means to carry out a duty. As a content kind it describes the standing of the agent's competence for the work at hand. Its deontic relevance is that obligation presupposes capacity, so a competence shortfall renders an attached duty defeasible or shifts it, for example to refer or disclose (Stenseke 2024)."@en ;
    rdfs:comment "Condition of an agent's competence or capacity for the work at hand."@en ;
    proeth:persistenceType "inertial" ;
    dcterms:references <https://doi.org/10.1007/s10462-024-10732-3> . # Stenseke 2024

:EmergencyState a owl:Class ;
    rdfs:subClassOf proeth-core:State ;
    rdfs:label "Emergency State"@en ;
    iao:0000115 "An acute, time-critical condition demanding immediate response. As a content kind it is distinguished from RiskState by acuteness. Its deontic relevance is that it can activate emergency-response obligations and license suspension of constraints that normally bound action (Almpani et al. 2023)."@en ;
    skos:definition "An acute, time-critical condition demanding immediate response. As a content kind it is distinguished from RiskState by acuteness. Its deontic relevance is that it can activate emergency-response obligations and license suspension of constraints that normally bound action (Almpani et al. 2023)."@en ;
    rdfs:comment "Acute, time-critical condition demanding immediate response."@en ;
    proeth:persistenceType "non_inertial" ;
    dcterms:references <https://doi.org/10.2478/sh-2022-0015> . # Almpani et al. 2023

:ConflictOfInterestState a owl:Class ;
    rdfs:subClassOf proeth-core:State ;
    rdfs:label "Conflict Of Interest State"@en ;
    iao:0000115 "A condition in which an agent holds competing interests, loyalties, or role-derived duties that cannot all be fully served and that bias or constrain the exercise of professional judgment. As a content kind it is the standing tension among interests, covering both conflict of interest and competing duties. Its deontic relevance is that it renders the affected obligations defeasible against one another and grounds the competesWith, prevailsOver, and defeasibleUnder edge family."@en ;
    skos:definition "A condition in which an agent holds competing interests, loyalties, or role-derived duties that cannot all be fully served and that bias or constrain the exercise of professional judgment. As a content kind it is the standing tension among interests, covering both conflict of interest and competing duties. Its deontic relevance is that it renders the affected obligations defeasible against one another and grounds the competesWith, prevailsOver, and defeasibleUnder edge family."@en ;
    rdfs:comment "Condition of competing interests, loyalties, or duties biasing professional judgment."@en ;
    proeth:persistenceType "inertial" .

:RegulatoryState a owl:Class ;
    rdfs:subClassOf proeth-core:State ;
    rdfs:label "Regulatory State"@en ;
    iao:0000115 "A condition in which a code provision, standard, statute, permit, or contractual requirement is in force for the situation, including states of compliance and of violation. As a content kind it is the regulatory standing of the situation. Its deontic relevance is that it activates a constraint or compliance obligation on the available actions."@en ;
    skos:altLabel "evolving standards state"@en ;
    skos:definition "A condition in which a code provision, standard, statute, permit, or contractual requirement is in force for the situation, including states of compliance and of violation. As a content kind it is the regulatory standing of the situation. Its deontic relevance is that it activates a constraint or compliance obligation on the available actions."@en ;
    rdfs:comment "Condition defined by an in-force regulatory, statutory, or contractual requirement."@en ;
    proeth:persistenceType "inertial" .

:TemporalState a owl:Class ;
    rdfs:subClassOf proeth-core:State ;
    rdfs:label "Temporal State"@en ;
    iao:0000115 "A condition defined by phase or timing: a pre- or post-termination phase, a before- or after-notification window, a deadline window. As a content kind it is the temporal standing of the situation. Its deontic relevance is that it bounds when a time-relative obligation holds, as the Event-Calculus fluent whose initiation and termination start and end the duty (Berreby et al. 2017)."@en ;
    skos:definition "A condition defined by phase or timing: a pre- or post-termination phase, a before- or after-notification window, a deadline window. As a content kind it is the temporal standing of the situation. Its deontic relevance is that it bounds when a time-relative obligation holds, as the Event-Calculus fluent whose initiation and termination start and end the duty (Berreby et al. 2017)."@en ;
    rdfs:comment "Condition defined by phase or timing (a deadline window, a post-termination phase)."@en ;
    proeth:persistenceType "inertial" ;
    dcterms:references <https://doi.org/10.65109/hhri9090> . # Berreby et al. 2017

:ResourceState a owl:Class ;
    rdfs:subClassOf proeth-core:State ;
    rdfs:label "Resource State"@en ;
    iao:0000115 "A condition of availability or scarcity of the means to act: time, budget, personnel, safeguards, or access to information. As a content kind it is the standing of the means available, distinct from the Resource (Rs) component, which is a knowledge artifact. Its deontic relevance is that it conditions the feasibility of obligations and sets dynamic priorities among them when means are constrained (Almpani et al. 2023)."@en ;
    skos:definition "A condition of availability or scarcity of the means to act: time, budget, personnel, safeguards, or access to information. As a content kind it is the standing of the means available, distinct from the Resource (Rs) component, which is a knowledge artifact. Its deontic relevance is that it conditions the feasibility of obligations and sets dynamic priorities among them when means are constrained (Almpani et al. 2023)."@en ;
    rdfs:comment "Condition of availability or scarcity of the means to act."@en ;
    proeth:persistenceType "inertial" ;
    dcterms:references <https://doi.org/10.2478/sh-2022-0015> . # Almpani et al. 2023

:DisclosureState a owl:Class ;
    rdfs:subClassOf proeth-core:State ;
    rdfs:label "Disclosure State"@en ;
    iao:0000115 "A condition of what information has been disclosed, withheld, concealed, or selectively presented among the parties, including states of confidentiality and of omission. As a content kind it is the standing of information flow between agents, distinct from EpistemicState, which is what a single agent knows. Its deontic relevance is that it activates disclosure, notification, and confidentiality obligations."@en ;
    skos:definition "A condition of what information has been disclosed, withheld, concealed, or selectively presented among the parties, including states of confidentiality and of omission. As a content kind it is the standing of information flow between agents, distinct from EpistemicState, which is what a single agent knows. Its deontic relevance is that it activates disclosure, notification, and confidentiality obligations."@en ;
    rdfs:comment "Condition of information disclosed, withheld, or concealed among parties."@en ;
    proeth:persistenceType "inertial" .

# Action-scoped competence-gap leaf. Minted only at the commit edge-materialization
# stage (decision D2'), not by a pipeline pass. Chained through CompetenceState so it
# reaches proeth-core:State through its archetype.
:CompetenceGapState a owl:Class ;
    rdfs:subClassOf :CompetenceState ;
    rdfs:label "Competence Gap State"@en ;
    iao:0000115 "A condition in which an agent lacks, has insufficient, or has not exercised the competence required for the work at hand, undercutting the obligations that attach to it. Agent-level and action-scoped gap individuals are minted at the commit edge-materialization stage (decision D2'); an action-scoped gap is linked to the specific Action and licenses defeasibleUnder on the undercut obligation."@en ;
    skos:definition "A condition in which an agent lacks, has insufficient, or has not exercised the competence required for the work at hand, undercutting the obligations that attach to it. Agent-level and action-scoped gap individuals are minted at the commit edge-materialization stage (decision D2'); an action-scoped gap is linked to the specific Action and licenses defeasibleUnder on the undercut obligation."@en ;
    rdfs:comment "Action-scoped competence-gap leaf minted at commit (D2'); subClassOf CompetenceState."@en ;
    proeth:persistenceType "inertial" .

#################################################################
#    Professional Resource Types (Chapter 2.2.3 - McLaren 2003)
#################################################################

# Professional resources provide extensional grounding for ethical decision-making
# Based on McLaren (2003) extensional principles approach

# Resource-type attributions corrected 2026-05-30 (verified against the reference
# corpus): McLaren grounds the precedent type; professional codes are
# Frankel/Davis; the remaining house extensions are practical, not attributable
# to a cited ethics-reasoning source. See each class's skos:scopeNote.
#
# Closed-kind reconciliation 2026-06-28 (ratified Rs spec), reduced to FIVE source kinds on
# 2026-07-01 (ProfessionalCode merged into EthicalCode) -- EthicalCode, TechnicalStandard,
# CasePrecedent, LegalResource, ReferenceMaterial. :ExpertInterpretation and :DecisionTool are retired below
# (an expert or board interpretation is captured by the normative components and their PROV-O
# derivations; a decision tool folds to :ReferenceMaterial). The topical field is the
# first-class proeth:topic datatype property (decision B2), not the otherAttribute overflow.

:CasePrecedent rdf:type owl:Class ;
    rdfs:subClassOf proeth-core:Resource ;
    rdfs:label "Case Precedent" ;
    iao:0000115 "Documented cases from ethics review boards providing precedential knowledge and analogical reasoning patterns for similar situations, grounding abstract principles in professional reality per McLaren (2003): citing past cases provides the extensional definition of the principles."@en ;
    skos:definition "Documented cases from ethics review boards providing precedential knowledge and analogical reasoning patterns for similar situations, grounding abstract principles in professional reality per McLaren (2003): citing past cases provides the extensional definition of the principles." ;
    rdfs:comment "Concrete instances that exemplify principle application" ;
    skos:scopeNote "Attribution: McLaren (Ashley & McLaren 1995; McLaren 2003, SIROCCO). This is McLaren's core contribution to the Resource component." ;
    dcterms:references <https://doi.org/10.1016/S0004-3702(03)00135-8> .

# :ExpertInterpretation retired 2026-06-28: not one of the closed six Resource kinds; an
# expert or board interpretation is recorded by the normative components and their PROV-O
# derivations, not as a Resource subclass.

:TechnicalStandard rdf:type owl:Class ;
    rdfs:subClassOf proeth-core:Resource ;
    rdfs:label "Technical Standard" ;
    iao:0000115 "Industry standards and specifications defining acceptable practice (e.g., ISO, IEEE, ASME standards) that embody collective professional agreement on technical acceptability and minimum competence benchmarks."@en ;
    skos:definition "Industry standards and specifications defining acceptable practice (e.g., ISO, IEEE, ASME standards) that embody collective professional agreement on technical acceptability and minimum competence benchmarks." ;
    rdfs:comment "Collective professional agreement on technical acceptability" ;
    skos:scopeNote "House extension (engineering domain): technical standards treated as an ethics knowledge resource. Not directly attributable to a cited ethics-reasoning source (the prior McLaren citation was removed)." .

:LegalResource rdf:type owl:Class ;
    rdfs:subClassOf proeth-core:Resource ;
    rdfs:label "Legal Resource" ;
    iao:0000115 "Laws, regulations, and statutes governing professional practice that establish legal boundaries and compliance requirements for professional activities."@en ;
    skos:definition "Laws, regulations, and statutes governing professional practice that establish legal boundaries and compliance requirements for professional activities." ;
    rdfs:comment "Legal framework constraining professional practice" ;
    skos:scopeNote "House extension with roots in legal case-based reasoning (Bench-Capon & Sartor 2003); treating legal materials as an ethics resource reflects the society-profession nexus (Frankel 1989)." .

# :DecisionTool retired 2026-06-28: not one of the closed six Resource kinds; a decision-support
# or ethics-workup schema folds to :ReferenceMaterial.

:ReferenceMaterial rdf:type owl:Class ;
    rdfs:subClassOf proeth-core:Resource ;
    rdfs:label "Reference Material" ;
    iao:0000115 "Handbooks, manuals, guides, and other documentation supporting professional practice with technical and procedural knowledge."@en ;
    skos:definition "Handbooks, manuals, guides, and other documentation supporting professional practice with technical and procedural knowledge." ;
    rdfs:comment "Supporting documentation for professional practice" ;
    skos:scopeNote "House extension grounded structurally in the Information Artifact Ontology: documents and manuals as Information Content Entities (iao:0000030, the parent of proeth-core:Resource). Not from a cited ethics source." .

# Specific instances of professional codes (examples)
:NSPECodeOfEthics rdf:type owl:NamedIndividual ;
    rdf:type :EthicalCode ;  # retyped 2026-06-28 (ratified Rs spec): the NSPE Code is a formal ethical-code document
    rdfs:label "NSPE Code of Ethics" ;
    skos:definition "The National Society of Professional Engineers' Code of Ethics establishing fundamental canons, rules of practice, and professional obligations for engineers." ;
    rdfs:comment "Primary ethical framework for professional engineers in the United States" .

#################################################################
# Constraint Categories from Chapter 2.2.9 Literature
# Based on Ganascia (2007), Dennis et al. (2016), Taddeo et al. (2024)
#################################################################

# Boundary Type Constraints
proeth:LegalConstraint a owl:Class ;
    rdfs:subClassOf proeth-core:Constraint ;
    rdfs:label "Legal Constraint"@en ;
    iao:0000115 "Constraints arising from legal requirements and statutes that establish inviolable boundaries (Kroll 2020, Stenseke 2024)"@en ;
    rdfs:comment "Constraints arising from legal requirements and statutes that establish inviolable boundaries (Kroll 2020, Stenseke 2024)"@en ;
    dcterms:references <https://doi.org/10.1093/oxfordhb/9780190067397.013.10> . # Kroll 2020

proeth:RegulatoryConstraint a owl:Class ;
    rdfs:subClassOf proeth-core:Constraint ;
    rdfs:label "Regulatory Constraint"@en ;
    iao:0000115 "Constraints from regulatory bodies and professional standards organizations (Taddeo et al. 2024)"@en ;
    rdfs:comment "Constraints from regulatory bodies and professional standards organizations (Taddeo et al. 2024)"@en ;
    dcterms:references <https://doi.org/10.1007/s13347-024-00710-6> . # Taddeo et al. 2024

proeth:ResourceConstraint a owl:Class ;
    rdfs:subClassOf proeth-core:Constraint ;
    rdfs:label "Resource Constraint"@en ;
    iao:0000115 "A boundary statement limiting the permissible action space by reference to available time, budget, materials, or personnel: it states what may not be undertaken given the resource situation, rather than describing the resources themselves (Ganascia 2007)."@en ;
    rdfs:comment "A boundary statement limiting permissible action by reference to available time, budget, materials, or personnel (Ganascia 2007). States the limit, not the resources."@en ;
    dcterms:references <https://doi.org/10.1007/s10676-006-9134-y> . # Ganascia 2007

proeth:CompetenceConstraint a owl:Class ;
    rdfs:subClassOf proeth-core:Constraint ;
    rdfs:label "Competence Constraint"@en ;
    iao:0000115 "A boundary statement limiting the permissible action space by reference to the agent's competence or technical limitations: it states what may not be undertaken beyond demonstrated capability, rather than describing the capability itself (Hallamaa & Kalliokoski 2022)."@en ;
    rdfs:comment "A boundary statement limiting permissible action by reference to competence or technical limits (Hallamaa & Kalliokoski 2022). States the limit, not the capability."@en ;
    dcterms:references <https://doi.org/10.3389/fcomp.2022.776837> . # Hallamaa & Kalliokoski 2022

proeth:JurisdictionalConstraint a owl:Class ;
    rdfs:subClassOf proeth-core:Constraint ;
    rdfs:label "Jurisdictional Constraint"@en ;
    iao:0000115 "Boundaries of authority and geographical or organizational scope (Dennis et al. 2016)"@en ;
    rdfs:comment "Boundaries of authority and geographical or organizational scope (Dennis et al. 2016)"@en ;
    dcterms:references <https://doi.org/10.1016/j.robot.2015.11.012> . # Dennis et al. 2016

proeth:ProceduralConstraint a owl:Class ;
    rdfs:subClassOf proeth-core:Constraint ;
    rdfs:label "Procedural Constraint"@en ;
    iao:0000115 "Forbids carrying out professional work outside a mandated process or protocol; an act that skips or bypasses a required procedural step (a review, approval, or notification) falls outside the permissible action space (Furbach et al. 2014)."@en ;
    rdfs:comment "Forbids carrying out professional work outside a mandated process or protocol; an act that skips or bypasses a required procedural step (a review, approval, or notification) falls outside the permissible action space (Furbach et al. 2014)."@en ;
    dcterms:references <https://doi.org/10.1007/978-3-319-13365-2_6> . # Furbach et al. 2014

# proeth:DefeasibleConstraint and proeth:InviolableConstraint retired 2026-06-28 (ratified Cs
# spec): defeasibility versus inviolability is carried by the obligation-layer defeasibility edge
# family (competesWith / prevailsOver / defeasibleUnder), so these two were a dead shadow. The
# Constraint component is the closed ELEVEN boundary types: Legal, Regulatory, Resource,
# Competence, Jurisdictional, Procedural, Ethical, Safety, Confidentiality, Temporal, Priority.

# Ethical Boundary Type Constraints
proeth:EthicalConstraint a owl:Class ;
    rdfs:subClassOf proeth-core:Constraint ;
    rdfs:label "Ethical Constraint"@en ;
    iao:0000115 "Professional ethical boundaries beyond legal requirements (Benzmüller et al. 2020)"@en ;
    rdfs:comment "Professional ethical boundaries beyond legal requirements (Benzmüller et al. 2020)"@en ;
    dcterms:references <https://doi.org/10.1016/j.artint.2020.103348> . # Benzmüller et al. 2020

proeth:SafetyConstraint a owl:Class ;
    rdfs:subClassOf proeth-core:Constraint ;
    rdfs:label "Safety Constraint"@en ;
    iao:0000115 "Forbids actions that would breach applicable safety requirements, bounding the permissible action space to conduct that keeps those requirements satisfied (Arkin 2008)."@en ;
    rdfs:comment "Forbids actions that would breach applicable safety requirements, bounding the permissible action space to conduct that keeps those requirements satisfied (Arkin 2008)."@en ;
    dcterms:references <https://doi.org/10.1145/1349822.1349839> . # Arkin 2008

proeth:ConfidentialityConstraint a owl:Class ;
    rdfs:subClassOf proeth-core:Constraint ;
    rdfs:label "Confidentiality Constraint"@en ;
    iao:0000115 "Boundaries on information disclosure and privacy (Dennis et al. 2016)"@en ;
    rdfs:comment "Boundaries on information disclosure and privacy (Dennis et al. 2016)"@en ;
    dcterms:references <https://doi.org/10.1016/j.robot.2015.11.012> . # Dennis et al. 2016

# Temporal and Priority Type Constraints
proeth:TemporalConstraint a owl:Class ;
    rdfs:subClassOf proeth-core:Constraint ;
    rdfs:label "Temporal Constraint"@en ;
    iao:0000115 "Time-based limitations and deadlines (Govindarajulu & Bringsjord 2017)"@en ;
    rdfs:comment "Time-based limitations and deadlines (Govindarajulu & Bringsjord 2017)"@en ;
    dcterms:references <https://doi.org/10.24963/ijcai.2017/658> . # Govindarajulu & Bringsjord 2017

proeth:constrainsAction a owl:ObjectProperty ;
    rdfs:domain proeth-core:Constraint ;
    rdfs:range proeth-core:Action ;
    rdfs:label "constrains action"@en ;
    rdfs:comment "Links constraint to actions it limits or prohibits"@en .

proeth:conflictsWithObligation a owl:ObjectProperty ;
    rdfs:domain proeth-core:Constraint ;
    rdfs:range proeth-core:Obligation ;
    rdfs:label "conflicts with obligation"@en ;
    rdfs:comment "Indicates when a constraint creates tension with an obligation"@en .

#################################################################
# Capability kinds (ratified Ca spec): the canonical reusable competence kinds
# promoted from the capability reference sheet. Each is a tool- and actor-neutral
# COMPETENCE KIND, rdfs:subClassOf proeth-core:Capability, carrying skos:altLabel folds
# for the compound case labels it absorbs and a class-level proeth:tolmeijerRequirement
# naming the primary ethical-competence requirement it realizes (decision E5, descriptive
# only). The subject a competence operates on, who possesses it, and whether it is realized
# are individual-level context (possessedBy / realizesCapability edges), not class identity;
# a lacked or unexercised competence is a CompetenceGapState, not a Capability.
#
# The four proeth:tolmeijerRequirement values follow the Chapter 2.2.8 analysis of the
# Tolmeijer et al. (2021) survey of machine-ethics implementations: norm competence,
# situational awareness, learning and adaptation, and explanation and justification.
#################################################################

proeth:tolmeijerRequirement a owl:AnnotationProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Tolmeijer requirement"@en ;
    rdfs:comment "Class-level descriptive annotation naming which of the four ethical-competence requirements a Capability kind primarily realizes (norm competence, situational awareness, learning and adaptation, explanation and justification), after the Chapter 2.2.8 analysis of the Tolmeijer et al. (2021) survey of machine-ethics implementations. Descriptive only (decision E5): it adds no typing axiom and no per-individual field."@en ;
    dcterms:references <https://doi.org/10.1145/3419633> . # Tolmeijer et al. 2021, Implementations in Machine Ethics: A Survey

proeth:roleKind a owl:AnnotationProperty ;
    rdfs:range xsd:string ;
    rdfs:label "role kind"@en ;
    rdfs:comment "Occupational backstop for role typing: an enum {professional, participant} that drives the ProfessionalRole vs ParticipantRole classification when the occupational resolver matches no head. A routing input to extraction, not a stored case literal; declared so the RoleDefinitionShape sh:path resolves to a browseable term."@en .

proeth:RiskAssessmentCapability a owl:Class ;
    rdfs:subClassOf proeth-core:Capability ;
    rdfs:label "Risk Assessment Capability"@en ;
    iao:0000115 "The competence to identify, characterize, and weigh risks bearing on a professional decision."@en ;
    skos:definition "The competence to identify, characterize, and weigh risks bearing on a professional decision."@en ;
    skos:altLabel "Environmental Risk Assessment Capability"@en, "Schedule Pressure Resistance Capability"@en ;
    proeth:tolmeijerRequirement "situational awareness" .

proeth:AdequacyAssessmentCapability a owl:Class ;
    rdfs:subClassOf proeth-core:Capability ;
    rdfs:label "Adequacy Assessment Capability"@en ;
    iao:0000115 "The competence to judge whether a document, analysis, review, or process meets the standard required."@en ;
    skos:definition "The competence to judge whether a document, analysis, review, or process meets the standard required."@en ;
    skos:altLabel "Bid Document Adequacy Assessment Capability"@en, "Constructability Assessment Capability"@en, "Federal Review Adequacy Capability"@en, "Analytical Framework Completeness Capability"@en, "Partial Analysis Avoidance Capability"@en, "Options Completeness Disclosure Capability"@en, "Client Consent Waiver Assessment Capability"@en ;
    proeth:tolmeijerRequirement "norm competence" .

proeth:NormativeFrameworkAssessmentCapability a owl:Class ;
    rdfs:subClassOf proeth-core:Capability ;
    rdfs:label "Normative Framework Assessment Capability"@en ;
    iao:0000115 "The competence to identify and apply the governing canon, code, standard, or precedent to a situation."@en ;
    skos:definition "The competence to identify and apply the governing canon, code, standard, or precedent to a situation."@en ;
    skos:altLabel "Applicable Canon Identification Capability"@en, "Regulatory Compliance Verification Capability"@en, "Regulatory Standards Awareness Capability"@en, "Technology Neutral Standards Application Capability"@en, "Peer Review Norm Recognition Capability"@en, "Antitrust and Procurement Law Contextual Awareness Capability"@en ;
    proeth:tolmeijerRequirement "norm competence" .

proeth:PrecedentReasoningCapability a owl:Class ;
    rdfs:subClassOf proeth-core:Capability ;
    rdfs:label "Precedent Reasoning Capability"@en ;
    iao:0000115 "The competence to retrieve, distinguish, and reason analogically from prior cases and precedents."@en ;
    skos:definition "The competence to retrieve, distinguish, and reason analogically from prior cases and precedents."@en ;
    skos:altLabel "Precedent-Based Ethical Reasoning Capability"@en, "Precedent Distinction Capability"@en, "Precedent Analogical Distinction Capability"@en, "Ethics Code Evolution Capability"@en ;
    proeth:tolmeijerRequirement "learning and adaptation" .

proeth:SituationRecognitionCapability a owl:Class ;
    rdfs:subClassOf proeth-core:Capability ;
    rdfs:label "Situation Recognition Capability"@en ;
    iao:0000115 "The competence to perceive that an ethically salient condition such as a conflict, violation, harm, override, or boundary is present in a situation."@en ;
    skos:definition "The competence to perceive that an ethically salient condition such as a conflict, violation, harm, override, or boundary is present in a situation."@en ;
    skos:altLabel "Client Disservice Recognition Capability"@en, "Client Override Recognition Capability"@en, "Dual Role Conflict Recognition Capability"@en, "Single Client Dual Capacity Recognition Capability"@en, "Environmental Violation Recognition Capability"@en, "Referral Alternative Recognition Capability"@en, "Whistleblower Right Recognition Capability"@en ;
    proeth:tolmeijerRequirement "situational awareness" .

proeth:ScopeBoundaryRecognitionCapability a owl:Class ;
    rdfs:subClassOf proeth-core:Capability ;
    rdfs:label "Scope Boundary Recognition Capability"@en ;
    iao:0000115 "The competence to recognize the limits of one's role, discipline, scope of practice, or authority."@en ;
    skos:definition "The competence to recognize the limits of one's role, discipline, scope of practice, or authority."@en ;
    skos:altLabel "Discipline Boundary Recognition Capability"@en, "Non-Engineering Scope Maintenance Capability"@en, "Scope Limitation Consistency Capability"@en, "Technology Role Boundary Capability"@en, "Credential Title Scope Awareness Capability"@en, "Faithful Agent Boundary Capability"@en ;
    proeth:tolmeijerRequirement "situational awareness" .

proeth:DisclosureCapability a owl:Class ;
    rdfs:subClassOf proeth-core:Capability ;
    rdfs:label "Disclosure Capability"@en ;
    iao:0000115 "The competence to communicate material facts, risks, limitations, or affiliations to the parties entitled to them. The subject of the disclosure is context, not a distinct capability."@en ;
    skos:definition "The competence to communicate material facts, risks, limitations, or affiliations to the parties entitled to them. The subject of the disclosure is context, not a distinct capability."@en ;
    skos:altLabel "AI Tool Disclosure Capability"@en, "Expertise Calibrated Disclosure Capability"@en, "Incomplete Submission Disclosure Capability"@en, "Informed Bid Disclosure Capability"@en, "Pre-Engagement Scope Disclosure Capability"@en, "Equipment Failure Disclosure Capability"@en, "Proactive Risk Disclosure Capability"@en, "Peer Review Notification Capability"@en, "Regulatory Authority Reporting Capability"@en, "Funding Constraint Communication Capability"@en ;
    proeth:tolmeijerRequirement "explanation and justification" .

proeth:ObjectivityMaintenanceCapability a owl:Class ;
    rdfs:subClassOf proeth-core:Capability ;
    rdfs:label "Objectivity Maintenance Capability"@en ;
    iao:0000115 "The competence to maintain independent, unbiased professional judgment under pressure, advocacy, solicitation, or cost-rationalization influence."@en ;
    skos:definition "The competence to maintain independent, unbiased professional judgment under pressure, advocacy, solicitation, or cost-rationalization influence."@en ;
    skos:altLabel "Advisory Independence Maintenance Capability"@en, "Adversarial Objectivity Maintenance Capability"@en, "Advocacy Bias Resistance Capability"@en, "Cost Rationalization Bias Avoidance Capability"@en, "Free Services Solicitation Resistance Capability"@en, "Commercial Solicitation Critical Evaluation Capability"@en, "Heightened Self-Review Diligence Capability"@en ;
    proeth:tolmeijerRequirement "norm competence" .

proeth:JudgmentNonSubstitutionCapability a owl:Class ;
    rdfs:subClassOf proeth-core:Capability ;
    rdfs:label "Judgment Non-Substitution Capability"@en ;
    iao:0000115 "The competence to retain personal professional judgment rather than substituting a tool's, delegate's, or third party's output for it."@en ;
    skos:definition "The competence to retain personal professional judgment rather than substituting a tool's, delegate's, or third party's output for it."@en ;
    skos:altLabel "AI Substitution Avoidance Capability"@en, "AI Output Critical Review Capability"@en, "Delegated Work Review Capability"@en ;
    proeth:tolmeijerRequirement "norm competence" .

proeth:CompetenceSelfAssessmentCapability a owl:Class ;
    rdfs:subClassOf proeth-core:Capability ;
    rdfs:label "Competence Self-Assessment Capability"@en ;
    iao:0000115 "The competence to honestly appraise and verify one's own qualifications before undertaking work."@en ;
    skos:definition "The competence to honestly appraise and verify one's own qualifications before undertaking work."@en ;
    skos:altLabel "Self-Competence Honest Assessment Capability"@en, "Independent Competence Verification Capability"@en, "Competence Self-Certification Resistance Capability"@en, "Technology Proficiency Assessment Capability"@en, "AI Tool Proficiency Assessment Capability"@en ;
    proeth:tolmeijerRequirement "situational awareness" .

proeth:ConfidentialityJudgmentCapability a owl:Class ;
    rdfs:subClassOf proeth-core:Capability ;
    rdfs:label "Confidentiality Judgment Capability"@en ;
    iao:0000115 "The competence to determine the boundaries of confidentiality and when an overriding duty such as public safety licenses disclosure."@en ;
    skos:definition "The competence to determine the boundaries of confidentiality and when an overriding duty such as public safety licenses disclosure."@en ;
    skos:altLabel "Confidentiality Override Judgment Capability"@en, "Confidentiality Structure Assessment Capability"@en, "Client Data Confidentiality Boundary Capability"@en, "Confidential Data Upload Consent Capability"@en, "Covert Instruction Refusal Capability"@en ;
    proeth:tolmeijerRequirement "norm competence" .

proeth:RepresentationAccuracyCapability a owl:Class ;
    rdfs:subClassOf proeth-core:Capability ;
    rdfs:label "Representation Accuracy Capability"@en ;
    iao:0000115 "The competence to represent one's credentials, licensure, and qualifications accurately and without deception."@en ;
    skos:definition "The competence to represent one's credentials, licensure, and qualifications accurately and without deception."@en ;
    skos:altLabel "Credential Representation Accuracy Capability"@en, "Jurisdictional Licensure Verification Capability"@en, "Deceptive Justification Avoidance Capability"@en, "Omission Rationale Articulation Capability"@en, "Report Language Precision Capability"@en ;
    proeth:tolmeijerRequirement "explanation and justification" .

proeth:ProfessionalAccountabilityCapability a owl:Class ;
    rdfs:subClassOf proeth-core:Capability ;
    rdfs:label "Professional Accountability Capability"@en ;
    iao:0000115 "The competence to accept responsibility for one's work and cooperate in error correction, peer review, and oversight."@en ;
    skos:definition "The competence to accept responsibility for one's work and cooperate in error correction, peer review, and oversight."@en ;
    skos:altLabel "Professional Accountability Acceptance Capability"@en, "Error Accountability Cooperation Capability"@en, "Peer Review Cooperation Capability"@en, "Public Safety Cooperation Motivation Capability"@en, "Corrective Action Monitoring Capability"@en, "Post-Engagement Observation Duty Capability"@en, "Remediation Advisory Capability"@en, "Peer Competence Reporting Capability"@en ;
    proeth:tolmeijerRequirement "explanation and justification" .

proeth:SupervisoryControlCapability a owl:Class ;
    rdfs:subClassOf proeth-core:Capability ;
    rdfs:label "Supervisory Control Capability"@en ;
    iao:0000115 "The competence to exercise responsible-charge control, direct supervision, and sealing authority over work product."@en ;
    skos:definition "The competence to exercise responsible-charge control, direct supervision, and sealing authority over work product."@en ;
    skos:altLabel "Supervisory Control Verification Capability"@en, "Document Sealing Competence Capability"@en, "Geotechnical Test Supervision Capability"@en ;
    proeth:tolmeijerRequirement "norm competence" .

proeth:FactGatheringDiligenceCapability a owl:Class ;
    rdfs:subClassOf proeth-core:Capability ;
    rdfs:label "Fact Gathering Diligence Capability"@en ;
    iao:0000115 "The competence to gather, consult, and weigh the witnesses, records, and evidence needed to reach a sound professional conclusion."@en ;
    skos:definition "The competence to gather, consult, and weigh the witnesses, records, and evidence needed to reach a sound professional conclusion."@en ;
    skos:altLabel "Witness and Record Consultation Capability"@en ;
    proeth:tolmeijerRequirement "situational awareness" .

proeth:WorkRefusalJudgmentCapability a owl:Class ;
    rdfs:subClassOf proeth-core:Capability ;
    rdfs:label "Work Refusal Judgment Capability"@en ;
    iao:0000115 "The competence to determine when professional duty requires declining or ceasing a task."@en ;
    skos:definition "The competence to determine when professional duty requires declining or ceasing a task."@en ;
    skos:altLabel "Client Confrontation Capability"@en ;
    proeth:tolmeijerRequirement "norm competence" .

proeth:ToolAttributionCapability a owl:Class ;
    rdfs:subClassOf proeth-core:Capability ;
    rdfs:label "Tool Attribution Capability"@en ;
    iao:0000115 "The competence to attribute the contribution of a professional tool or software to a work product and give due credit for its role (e.g. CAD, analysis, or simulation software). The genus of tool-attribution competencies; AI attribution is a distinguished kind because generative AI can author substantive content."@en ;
    skos:definition "The competence to attribute the contribution of a professional tool or software to a work product and give due credit for its role (e.g. CAD, analysis, or simulation software). The genus of tool-attribution competencies; AI attribution is a distinguished kind because generative AI can author substantive content."@en ;
    skos:altLabel "Software Attribution Capability"@en, "Tool Contribution Attribution Capability"@en, "CAD Attribution Capability"@en ;
    proeth:tolmeijerRequirement "explanation and justification" .

proeth:AIAttributionCapability a owl:Class ;
    rdfs:subClassOf proeth:ToolAttributionCapability ;
    rdfs:label "AI Attribution Capability"@en ;
    iao:0000115 "The competence to attribute AI-tool contribution in a work product and its representations. A distinct kind of tool attribution because generative AI can author substantive content, so its unattributed use misrepresents professional authorship and provenance in ways a conventional tool such as CAD does not."@en ;
    skos:definition "The competence to attribute AI-tool contribution in a work product and its representations. A distinct kind of tool attribution because generative AI can author substantive content, so its unattributed use misrepresents professional authorship and provenance in ways a conventional tool such as CAD does not."@en ;
    skos:altLabel "AI Contribution Attribution Capability"@en, "AI Tool Attribution Capability"@en ;
    proeth:tolmeijerRequirement "explanation and justification" .

proeth:ThresholdDistinctionCapability a owl:Class ;
    rdfs:subClassOf proeth-core:Capability ;
    rdfs:label "Threshold Distinction Capability"@en ;
    iao:0000115 "The competence to discriminate the threshold at which a concern, consent, or scope condition changes the required professional response."@en ;
    skos:definition "The competence to discriminate the threshold at which a concern, consent, or scope condition changes the required professional response."@en ;
    skos:altLabel "Retainer Scope Delineation Capability"@en ;
    proeth:tolmeijerRequirement "situational awareness" .


# Capability properties for relationships
proeth:hasCapabilityLevel a owl:DatatypeProperty ;  # was owl:ObjectProperty, corrected: range is xsd:string
    rdfs:range xsd:string ;
    rdfs:label "has capability level"@en ;
    rdfs:comment "Indicates the level or degree of a capability"@en ;
    skos:changeNote "v2.x: Changed from owl:ObjectProperty to owl:DatatypeProperty. A property relating to a string literal must be a DatatypeProperty."@en .

proeth:enablesAction a owl:ObjectProperty ;
    rdfs:domain proeth-core:Capability ;
    rdfs:range proeth-core:Action ;
    rdfs:label "enables action"@en ;
    rdfs:comment "Relates a capability to the actions it enables"@en .

#################################################################
#    SPARQL Query Support
#################################################################

# This comment documents the SPARQL query to retrieve all GuidelineConceptTypes:
# SELECT ?type ?label ?comment WHERE {
#   ?type rdf:type :GuidelineConceptType .
#   ?type rdfs:label ?label .
#   OPTIONAL { ?type rdfs:comment ?comment }
# }
# This will return: Role, Principle, Obligation, State, Resource, Action, Event, Capability

#################################################################
# Occupational role archetypes (2026-05-29)
#################################################################
# The OCCUPATIONAL axis of the role hierarchy. It says what kind of agent the role is.
# This is distinct from the RELATIONAL axis above (ProviderClientRole, ProfessionalPeerRole,
# and the rest), which says what duty-relationship the role creates. Extracted role leaves get
# a primary occupational parent here. Where applicable they also get a cross-cutting relational
# parent. The heads are seeded from IfcRoleEnum (ISO 16739) via SKOS crosswalk to the held
# ifc-roles stub. They are NOT subclassed under IFC. IFC roles are enumeration values, not classes.
# Engineer specializations and the obligation-bearing heads go under ProfessionalRole.
# Non-obligation-bearing participant heads (Client, Owner, Public, and the rest) go under
# ParticipantRole. That way they do not inherit the ProfessionalRole hasObligation restriction.
# Spec: proethica/docs-internal/reextraction/role-archetype-spec.md.

# archetypeAxis tags a role archetype's axis ("occupational" = what kind of agent;
# "relational" = what duty-relationship). The extractor's occupational resolver loads the
# classes tagged "occupational" and matches a role label against their rdfs:label +
# skos:altLabel synonyms (longest match wins). The placement rules therefore live in the
# ontology, per domain, not in code: a new domain ships its own archetype ontology with its
# own altLabels and needs no resolver change.
#################################################################
# Controlled vocabularies for the role-archetype axes (SKOS).
# The genuine axis MARKERS (occupational/relational; discipline/function) have no OWL class -- they
# are orthogonal cross-cuts that cannot sit on the single-inheritance disjoint backbone -- so they are
# modelled as SKOS concept schemes (a proper controlled vocabulary: URIs, definitions, citations,
# crosswalkable) rather than ad-hoc strings. The annotation VALUE is the concept's skos:notation, so
# consumers that read the string keep working. Mirrors the ifc-roles.ttl pattern. (The principle-kind /
# roleCategory / conceptCategory "axes" are deliberately NOT here: they shadow existing OWL classes and
# are read from those, not from a SKOS scheme.)
#################################################################

proeth:RoleArchetypeAxisScheme a skos:ConceptScheme ;
    rdfs:label "Role archetype axis"@en ;
    skos:definition "The archetype axis a role classification sits on: occupational (what KIND of agent the bearer is) vs relational (the duty-RELATIONSHIP the role establishes). The two are orthogonal -- a role can be both -- so neither is an OWL class on the ProfessionalRole/ParticipantRole disjoint backbone; this scheme is their controlled vocabulary. proeth:archetypeAxis takes a concept (URI) of this scheme as its value; skos:notation carries the short code."@en ;
    dcterms:source "Kong et al. (2020), audience-oriented identity roles; Oakley & Cocking (2001), Virtue Ethics and Professional Roles." .

proeth:OccupationalArchetype a owl:NamedIndividual, skos:Concept ;
    skos:inScheme proeth:RoleArchetypeAxisScheme ;
    skos:notation "occupational" ; skos:prefLabel "occupational"@en ;
    rdfs:label "Occupational archetype"@en ;
    skos:definition "Classifies the bearer by their occupational/positional KIND (engineer, architect, client, owner, the public). Spans both ProfessionalRole and ParticipantRole, so it is the primitive single-inheritance backbone, not a disjoint subtype."@en ;
    dcterms:source "Kong et al. (2020); Oakley & Cocking (2001)." .

proeth:RelationalArchetype a owl:NamedIndividual, skos:Concept ;
    skos:inScheme proeth:RoleArchetypeAxisScheme ;
    skos:notation "relational" ; skos:prefLabel "relational"@en ;
    rdfs:label "Relational archetype"@en ;
    skos:definition "Classifies the bearer by the duty-RELATIONSHIP the role establishes (provider-client, professional-peer, employer, public-responsibility)."@en ;
    skos:scopeNote "No longer used as a proeth:archetypeAxis annotation value: the relational archetype is now a reasoner-inferred owl:equivalentClass defined class (ProviderClientRole etc.) derived from the role-to-role relationship edge. Retained to document the axis."@en ;
    dcterms:source "Kong et al. (2020)." .

proeth:RoleSpecializationScheme a skos:ConceptScheme ;
    rdfs:label "Role specialization axis"@en ;
    skos:definition "How an occupational role leaf specializes its archetype head: discipline (a branch of the profession, e.g. Civil/Electrical) vs function (a cross-discipline job function, e.g. design/quality/safety). Finer than the archetype axis; an orthogonal cross-cut with no OWL class. proeth:specializationAxis (on a ROLE) takes a concept (URI) of this scheme as its value; skos:notation carries the short code."@en ;
    dcterms:source "ProEthica engineering role taxonomy; IFC discipline crosswalk (ifc-roles.ttl)." .

proeth:DisciplineSpecialization a owl:NamedIndividual, skos:Concept ;
    skos:inScheme proeth:RoleSpecializationScheme ;
    skos:notation "discipline" ; skos:prefLabel "discipline"@en ;
    rdfs:label "Discipline specialization"@en ;
    skos:definition "A branch of the profession -- a recognised engineering discipline (Civil, Electrical, Mechanical, Structural, Environmental, Geotechnical). Crosswalked to IFC actor roles via skos:exactMatch on the role class."@en .

proeth:FunctionSpecialization a owl:NamedIndividual, skos:Concept ;
    skos:inScheme proeth:RoleSpecializationScheme ;
    skos:notation "function" ; skos:prefLabel "function"@en ;
    rdfs:label "Function specialization"@en ;
    skos:definition "A cross-discipline job function a role performs (design, quality, safety, standards), independent of engineering discipline."@en .

:archetypeAxis rdf:type owl:AnnotationProperty ;
    rdfs:label "archetype axis"@en ;
    rdfs:seeAlso proeth:RoleArchetypeAxisScheme ;
    rdfs:comment "Role-archetype axis marker. The value is a concept (URI) in proeth:RoleArchetypeAxisScheme (currently :OccupationalArchetype; the relational pole is now a reasoner-inferred defined class, not an annotation). skos:notation carries the short code. NOTE (presence-flag semantics, post relational retirement): the axis is now single-valued, so the VALUE :OccupationalArchetype no longer discriminates -- it is the PRESENCE vs absence of the marker that is load-bearing. Presence is the selector the occupational resolver queries, g.subjects(:archetypeAxis, :OccupationalArchetype), to enrol a class (by its rdfs:label + skos:altLabel) in data-driven placement; a class without the marker (the ProfessionalRole/ParticipantRole backbone heads, the relational defined classes) is deliberately not a placement target. 'Occupational' means occupational/POSITIONAL kind (the who-the-bearer-is axis), which is why participant heads (Client/Owner/Public/...) carry it too: they are positional kinds, not occupations in the labor sense. Do NOT remove it from the participant heads to 'clean up' the label -- that un-indexes them from the resolver."@en .

# specializationAxis applies to occupational role leaves under an archetype head (e.g. EngineerRole):
# "discipline" = a branch of the profession (CivilEngineerRole, crosswalked to an IFC discipline role);
# "function" = a cross-discipline job function (QualityEngineerRole). Orthogonal to archetypeAxis.
:specializationAxis rdf:type owl:AnnotationProperty ;
    rdfs:label "specialization axis"@en ;
    rdfs:seeAlso proeth:RoleSpecializationScheme ;
    rdfs:comment "Role specialization axis. On an occupational ROLE leaf the value is a concept (URI) in proeth:RoleSpecializationScheme (:DisciplineSpecialization or :FunctionSpecialization; skos:notation carries the short code). The former principle-kind use (values fundamental/virtue/relational/domain) was a shadow of the principle-kind classes and was retired 2026-06-27 in favour of rdfs:subClassOf the kind class."@en .

# Engineer specializations (under :EngineerRole, itself under :ProfessionalRole)
:CivilEngineerRole rdf:type owl:Class ; rdfs:subClassOf :EngineerRole ;
    rdfs:label "Civil Engineer Role"@en ; skos:exactMatch ifcrole:CivilEngineer ;
    iao:0000115 "Engineer specializing in infrastructure and the built environment."@en ;
    :archetypeAxis :OccupationalArchetype ;
    :specializationAxis :DisciplineSpecialization ;
    rdfs:comment "Engineer specializing in infrastructure and the built environment."@en .
:StructuralEngineerRole rdf:type owl:Class ; rdfs:subClassOf :EngineerRole ;
    rdfs:label "Structural Engineer Role"@en ; skos:exactMatch ifcrole:StructuralEngineer ;
    iao:0000115 "Engineer specializing in load-bearing structure and structural integrity."@en ;
    :archetypeAxis :OccupationalArchetype ;
    :specializationAxis :DisciplineSpecialization ;
    rdfs:comment "Engineer specializing in load-bearing structure and structural integrity."@en .
:MechanicalEngineerRole rdf:type owl:Class ; rdfs:subClassOf :EngineerRole ;
    rdfs:label "Mechanical Engineer Role"@en ; skos:exactMatch ifcrole:MechanicalEngineer ;
    iao:0000115 "Engineer specializing in mechanical systems."@en ;
    :archetypeAxis :OccupationalArchetype ;
    :specializationAxis :DisciplineSpecialization ;
    rdfs:comment "Engineer specializing in mechanical systems."@en .
:ElectricalEngineerRole rdf:type owl:Class ; rdfs:subClassOf :EngineerRole ;
    rdfs:label "Electrical Engineer Role"@en ; skos:exactMatch ifcrole:ElectricalEngineer ;
    iao:0000115 "Engineer specializing in electrical systems and power."@en ;
    :archetypeAxis :OccupationalArchetype ;
    :specializationAxis :DisciplineSpecialization ;
    rdfs:comment "Engineer specializing in electrical systems and power."@en .

# Corpus-derived engineer + participant role specializations promoted from the NSPE case
# reference sheet 2026-06-26 (the labels the corpus actually uses). Six carry a discipline/function
# specializationAxis; ConsultantEngineerRole/MunicipalEngineerRole/NonEngineerExpertWitnessRole are
# relational/sector/participant and stay unaxed. alt_labels carried over as skos:altLabel.
:EnvironmentalEngineerRole rdf:type owl:Class ; rdfs:subClassOf :EngineerRole ;
    rdfs:label "Environmental Engineer Role"@en ;
    iao:0000115 "A licensed engineer whose practice area is environmental engineering (site assessment, contamination, wetlands, permitting)."@en ;
    :archetypeAxis :OccupationalArchetype ; :specializationAxis :DisciplineSpecialization ;
    skos:altLabel "environmental engineer"@en, "environmental site engineer"@en, "wetland delineation engineer"@en ;
    rdfs:comment "A licensed engineer whose practice area is environmental engineering (site assessment, contamination, wetlands, permitting)."@en .
:GeotechnicalEngineerRole rdf:type owl:Class ; rdfs:subClassOf :EngineerRole ;
    rdfs:label "Geotechnical Engineer Role"@en ;
    iao:0000115 "An engineer whose practice area is geotechnical engineering (soils, foundations, site observation)."@en ;
    :archetypeAxis :OccupationalArchetype ; :specializationAxis :DisciplineSpecialization ;
    skos:altLabel "geotechnical engineer"@en, "geotechnical observation consultant"@en ;
    rdfs:comment "An engineer whose practice area is geotechnical engineering (soils, foundations, site observation)."@en .
:DesignEngineerRole rdf:type owl:Class ; rdfs:subClassOf :EngineerRole ;
    rdfs:label "Design Engineer Role"@en ;
    iao:0000115 "An engineer responsible for producing a design (plans, calculations, specifications) for a project. Project and discipline are case context, not separate role kinds."@en ;
    :archetypeAxis :OccupationalArchetype ; :specializationAxis :FunctionSpecialization ;
    skos:altLabel "design engineer"@en, "cooperating design engineer"@en, "original design engineer"@en, "dam design engineer"@en, "dock foundation design engineer"@en, "stormwater design engineer"@en ;
    rdfs:comment "An engineer responsible for producing a design (plans, calculations, specifications) for a project. Project and discipline are case context, not separate role kinds."@en .
# The three formerly dual-archetype leaves keep their occupational primitive parent (:EngineerRole) and
# their occupational tag; their RELATIONAL archetype is now INFERRED by the reasoner from a property
# restriction (no longer a hand-maintained :archetypeAxis "relational" annotation). ResponsibleCharge is
# reclassified as purely occupational (responsible charge is a mode of practice, not a duty-relationship).
:ResponsibleChargeEngineerRole rdf:type owl:Class ; rdfs:subClassOf :EngineerRole ;
    rdfs:label "Responsible Charge Engineer Role"@en ;
    iao:0000115 "An engineer in responsible charge of work, exercising direct control and personal supervision over its production. An occupational mode of practice, not a duty-relationship archetype."@en ;
    :archetypeAxis :OccupationalArchetype ;
    skos:altLabel "responsible charge engineer"@en, "reviewing charge engineer"@en ;
    rdfs:comment "An engineer in responsible charge of work, exercising direct control and personal supervision over its production. An occupational mode of practice, not a duty-relationship archetype."@en .
:ForensicExpertWitnessEngineerRole rdf:type owl:Class ; rdfs:subClassOf :EngineerRole ;
    rdfs:subClassOf [ rdf:type owl:Restriction ; owl:onProperty proeth-core:hasClient ; owl:someValuesFrom proeth-core:Role ] ;
    rdfs:label "Forensic Expert Witness Engineer Role"@en ;
    iao:0000115 "An engineer retained to provide forensic analysis and expert testimony in a dispute or litigation. Inferred :ProviderClientRole via proeth-core:hasClient (the retained provider side)."@en ;
    :archetypeAxis :OccupationalArchetype ;
    skos:altLabel "forensic expert witness engineer"@en, "forensic engineer"@en ;
    rdfs:comment "An engineer retained to provide forensic analysis and expert testimony in a dispute or litigation. Inferred :ProviderClientRole via proeth-core:hasClient (the retained provider side)."@en .
:MentorEngineerRole rdf:type owl:Class ; rdfs:subClassOf :EngineerRole ;
    rdfs:subClassOf [ rdf:type owl:Restriction ; owl:onProperty proeth-core:professionalPeerOf ; owl:someValuesFrom proeth-core:Role ] ;
    rdfs:label "Mentor Engineer Role"@en ;
    iao:0000115 "An experienced engineer who mentors another. Inferred :ProfessionalPeerRole via proeth-core:professionalPeerOf. Availability such as retired status is a State, not a role kind."@en ;
    :archetypeAxis :OccupationalArchetype ;
    skos:altLabel "mentor engineer"@en, "retired mentor engineer"@en ;
    rdfs:comment "An experienced engineer who mentors another. Inferred :ProfessionalPeerRole via proeth-core:professionalPeerOf. Availability such as retired status is a State, not a role kind."@en .
:MunicipalEngineerRole rdf:type owl:Class ; rdfs:subClassOf :EngineerRole ;
    rdfs:label "Municipal Engineer Role"@en ;
    iao:0000115 "An engineer engaged by a municipality to advise on and approve public engineering works. An employer-sector idiom, not a discipline or function specialization."@en ;
    :archetypeAxis :OccupationalArchetype ;
    skos:altLabel "municipal engineer"@en ;
    rdfs:comment "An engineer engaged by a municipality to advise on and approve public engineering works. An employer-sector idiom, not a discipline or function specialization."@en .
:ConsultantEngineerRole rdf:type owl:Class ; rdfs:subClassOf :ConsultantRole ;
    rdfs:label "Consultant Engineer Role"@en ;
    iao:0000115 "An engineer engaged in a consulting or advisory capacity to a client. A relational specialization under ConsultantRole, not a discipline or function."@en ;
    :archetypeAxis :OccupationalArchetype ;
    skos:altLabel "consultant engineer"@en ;
    rdfs:comment "An engineer engaged in a consulting or advisory capacity to a client. A relational specialization under ConsultantRole, not a discipline or function."@en .
:NonEngineerExpertWitnessRole rdf:type owl:Class ; rdfs:subClassOf :ProviderClientRole ;
    rdfs:label "Non-Engineer Expert Witness Role"@en ;
    iao:0000115 "An expert witness who is not an engineer, kept distinct from ForensicExpertWitnessEngineerRole because the engineer-versus-non-engineer distinction carries different professional obligations."@en ;
    :archetypeAxis :OccupationalArchetype ;
    skos:altLabel "non-engineer expert witness"@en, "non-engineering expert witness"@en ;
    rdfs:comment "An expert witness who is not an engineer, kept distinct from ForensicExpertWitnessEngineerRole because the engineer-versus-non-engineer distinction carries different professional obligations."@en .

# Function-axis engineer roles consolidated here from the engineering-ethics ontology 2026-06-26
# (all engineer roles share one home: proethica-intermediate). hasResponsibilities links dropped
# (engineering-ethics-internal detail); appliesToDomain folded into the comment.
:QualityEngineerRole rdf:type owl:Class ; rdfs:subClassOf :EngineerRole ;
    rdfs:label "Quality Engineer Role"@en ;
    iao:0000115 "Engineer responsible for implementing quality management systems and ensuring compliance with quality standards. Applies across engineering disciplines."@en ;
    :archetypeAxis :OccupationalArchetype ; :specializationAxis :FunctionSpecialization ;
    skos:altLabel "quality engineer"@en ;
    rdfs:comment "Engineer responsible for implementing quality management systems and ensuring compliance with quality standards. Applies across engineering disciplines."@en .
:SafetyEngineerRole rdf:type owl:Class ; rdfs:subClassOf :EngineerRole ;
    rdfs:label "Safety Engineer Role"@en ;
    iao:0000115 "Engineer specializing in system safety analysis and compliance with safety-critical standards. Applies across engineering disciplines."@en ;
    :archetypeAxis :OccupationalArchetype ; :specializationAxis :FunctionSpecialization ;
    skos:altLabel "safety engineer"@en ;
    rdfs:comment "Engineer specializing in system safety analysis and compliance with safety-critical standards. Applies across engineering disciplines."@en .
:StandardsEngineerRole rdf:type owl:Class ; rdfs:subClassOf :EngineerRole ;
    rdfs:label "Standards Engineer Role"@en ;
    iao:0000115 "Engineer responsible for ensuring compliance with applicable technical standards and regulations. Applies across engineering disciplines."@en ;
    :archetypeAxis :OccupationalArchetype ; :specializationAxis :FunctionSpecialization ;
    skos:altLabel "standards engineer"@en ;
    rdfs:comment "Engineer responsible for ensuring compliance with applicable technical standards and regulations. Applies across engineering disciplines."@en .

# Obligation-bearing occupational heads (under :ProfessionalRole)
:ProjectManagerRole rdf:type owl:Class ; rdfs:subClassOf :ProfessionalRole ;
    rdfs:label "Project Manager Role"@en ; skos:exactMatch ifcrole:ProjectManager ;
    iao:0000115 "Party responsible for planning, coordinating, and delivering a project."@en ;
    :archetypeAxis :OccupationalArchetype ; skos:altLabel "project manager"@en, "construction manager"@en, "program manager"@en ;
    rdfs:comment "Party responsible for planning, coordinating, and delivering a project."@en .
:ArchitectRole rdf:type owl:Class ; rdfs:subClassOf :ProfessionalRole ;
    rdfs:label "Architect Role"@en ; skos:exactMatch ifcrole:Architect ;
    iao:0000115 "Professional responsible for building design and construction oversight."@en ;
    :archetypeAxis :OccupationalArchetype ;
    rdfs:comment "Professional responsible for building design and construction oversight."@en .
:ConsultantRole rdf:type owl:Class ; rdfs:subClassOf :ProfessionalRole ;
    rdfs:label "Consultant Role"@en ; skos:exactMatch ifcrole:Consultant ;
    iao:0000115 "Professional engaged for expert advice on a specific aspect of a project. Engineering consultants are classified under EngineerRole. This head covers non-engineering advisory roles."@en ;
    :archetypeAxis :OccupationalArchetype ;
    rdfs:comment "Professional engaged for expert advice on a specific aspect of a project. Engineering consultants are classified under EngineerRole. This head covers non-engineering advisory roles."@en .
:RegulatoryAuthorityRole rdf:type owl:Class ; rdfs:subClassOf :ProfessionalRole ;
    rdfs:label "Regulatory Authority Role"@en ;
    iao:0000115 "Code-enforcement officials, inspectors, boards, and government agencies acting in an oversight capacity. No IFC equivalent (IFC has no regulator role)."@en ;
    :archetypeAxis :OccupationalArchetype ; skos:altLabel "regulator"@en, "inspector"@en, "board of ethical"@en, "public official"@en, "public agency"@en ;
    rdfs:comment "Code-enforcement officials, inspectors, boards, and government agencies acting in an oversight capacity. No IFC equivalent (IFC has no regulator role)."@en .

# Non-obligation-bearing occupational heads (under :ParticipantRole, so no obligation restriction)
:ClientRole rdf:type owl:Class ; rdfs:subClassOf :ParticipantRole ;
    rdfs:label "Client Role"@en ; skos:exactMatch ifcrole:Client ;
    iao:0000115 "Party that commissions the project work. This is the occupational archetype. The duty relationship is carried separately by :ProviderClientRole."@en ;
    :archetypeAxis :OccupationalArchetype ;
    rdfs:comment "Party that commissions the project work. This is the occupational archetype. The duty relationship is carried separately by :ProviderClientRole."@en .
:OwnerRole rdf:type owl:Class ; rdfs:subClassOf :ParticipantRole ;
    rdfs:label "Owner Role"@en ; skos:exactMatch ifcrole:Owner ; skos:closeMatch ifcrole:BuildingOwner ;
    iao:0000115 "Party that owns the asset, project, or building."@en ;
    :archetypeAxis :OccupationalArchetype ;
    rdfs:comment "Party that owns the asset, project, or building."@en .
:PublicRole rdf:type owl:Class ; rdfs:subClassOf :ParticipantRole ;
    rdfs:label "Public Role"@en ;
    iao:0000115 "The public, community members, and affected stakeholders. No IFC equivalent, since IFC has no public or society role. The professional duty side is :PublicResponsibilityRole."@en ;
    :archetypeAxis :OccupationalArchetype ; skos:altLabel "public"@en, "community"@en, "citizen"@en, "resident"@en, "neighbor"@en, "society"@en, "affected party"@en ;
    rdfs:comment "The public, community members, and affected stakeholders. No IFC equivalent, since IFC has no public or society role. The professional duty side is :PublicResponsibilityRole."@en .
:ContractorRole rdf:type owl:Class ; rdfs:subClassOf :ParticipantRole ;
    rdfs:label "Contractor Role"@en ; skos:exactMatch ifcrole:Contractor ; skos:closeMatch ifcrole:Subcontractor ;
    iao:0000115 "Party contracted to carry out construction work."@en ;
    :archetypeAxis :OccupationalArchetype ; skos:altLabel "contractor"@en, "subcontractor"@en ;
    rdfs:comment "Party contracted to carry out construction work."@en .
:SupplierRole rdf:type owl:Class ; rdfs:subClassOf :ParticipantRole ;
    rdfs:label "Supplier Role"@en ; skos:exactMatch ifcrole:Supplier ; skos:closeMatch ifcrole:Manufacturer ;
    iao:0000115 "Party that supplies materials, products, or equipment."@en ;
    :archetypeAxis :OccupationalArchetype ; skos:altLabel "supplier"@en, "manufacturer"@en, "vendor"@en, "reseller"@en ;
    rdfs:comment "Party that supplies materials, products, or equipment."@en .
:EmployerRole rdf:type owl:Class ; rdfs:subClassOf :ParticipantRole ;
    rdfs:label "Employer Role"@en ;
    iao:0000115 "The employing organization as a participant. The duty relationship is carried separately by :EmployerRelationshipRole. No IFC equivalent."@en ;
    :archetypeAxis :OccupationalArchetype ;
    rdfs:comment "The employing organization as a participant. The duty relationship is carried separately by :EmployerRelationshipRole. No IFC equivalent."@en .


#################################################################
# Controlled extraction datatype vocabulary (added 2026-06-04)
# Declares the stable per-component literal fields the extraction pipeline
# emits, so the 'grounded in a controlled ontology vocabulary' claim covers
# datatype predicates, not only typed individuals + object-property edges.
# No rdfs:domain (intended component noted per property) to avoid weaponising
# the residual cross-category field leak into a disjointness clash.
#################################################################


# --- Shared (all nine components) ---
proeth:conceptCategory a owl:DatatypeProperty ;
    rdfs:label "concept category"@en ;
    rdfs:range xsd:string ;
    rdfs:comment "Base nine-component category tag (Role/Principle/...); display grouping, not reasoner-visible typing."@en .

proeth:confidence a owl:DatatypeProperty ;
    rdfs:label "confidence"@en ;
    rdfs:range xsd:string ;
    rdfs:comment "Extraction confidence for the individual, 0..1 as a string."@en .

proeth:textReferences a owl:DatatypeProperty ;
    rdfs:label "text references"@en ;
    rdfs:range xsd:string ;
    rdfs:comment "Verbatim source spans grounding the individual."@en .


# --- Role ---
proeth:actor a owl:DatatypeProperty ;
    rdfs:label "actor"@en ;
    rdfs:range xsd:string ;
    rdfs:comment "Intended on Role: the actor/agent name the role-bearer is (also drives the Agent layer)."@en .

proeth:roleCategory a owl:DatatypeProperty ;
    rdfs:label "role category"@en ;
    rdfs:range xsd:string ;
    rdfs:comment "Intended on Role: coarse role category (e.g. public_responsibility)."@en .

proeth:roleClass a owl:DatatypeProperty ;
    rdfs:label "role class"@en ;
    rdfs:range xsd:string ;
    rdfs:comment "Intended on Role: the LLM-suggested ontology role class label."@en .

proeth:caseInvolvement a owl:DatatypeProperty ;
    rdfs:label "case involvement"@en ;
    rdfs:range xsd:string ;
    rdfs:comment "Intended on Role: how the role-bearer is involved in this case."@en .


# --- Principle ---
proeth:interpretation a owl:DatatypeProperty ;
    rdfs:label "interpretation"@en ;
    rdfs:range xsd:string ;
    rdfs:comment "Intended on Principle: how the principle is read in this case."@en .

proeth:concreteExpression a owl:DatatypeProperty ;
    rdfs:label "concrete expression"@en ;
    rdfs:range xsd:string ;
    rdfs:comment "Intended on Principle: the case-specific concrete expression."@en .

proeth:appliedTo a owl:DatatypeProperty ;
    rdfs:label "applied to"@en ;
    rdfs:range xsd:string ;
    rdfs:comment "Intended on Principle: what the principle is applied to."@en .

proeth:balancingWith a owl:DatatypeProperty ;
    rdfs:label "balancing with"@en ;
    rdfs:range xsd:string ;
    rdfs:comment "Intended on Principle: the competing consideration it is balanced against."@en .

proeth:tensionResolution a owl:DatatypeProperty ;
    rdfs:label "tension resolution"@en ;
    rdfs:range xsd:string ;
    rdfs:comment "Intended on Principle: how a tension involving it is resolved."@en .

proeth:principleClass a owl:DatatypeProperty ;
    rdfs:label "principle class"@en ;
    rdfs:range xsd:string ;
    rdfs:comment "Intended on Principle: the LLM-suggested ontology principle class label."@en .


# --- Obligation ---
proeth:obligationStatement a owl:DatatypeProperty ;
    rdfs:label "obligation statement"@en ;
    rdfs:range xsd:string ;
    rdfs:comment "Intended on Obligation: the statement of the duty."@en .

proeth:complianceStatus a owl:DatatypeProperty ;
    rdfs:label "compliance status"@en ;
    rdfs:range xsd:string ;
    rdfs:comment "Intended on Obligation: met / unmet / partial / unclear judgment."@en .

proeth:temporalScope a owl:DatatypeProperty ;
    rdfs:label "temporal scope"@en ;
    rdfs:range xsd:string ;
    rdfs:comment "Intended on Obligation/Constraint: when the duty/limit applies."@en .

proeth:caseContext a owl:DatatypeProperty ;
    rdfs:label "case context"@en ;
    rdfs:range xsd:string ;
    rdfs:comment "Intended on Obligation/Capability/Constraint: case-specific grounding context."@en .

proeth:obligationClass a owl:DatatypeProperty ;
    rdfs:label "obligation class"@en ;
    rdfs:range xsd:string ;
    rdfs:comment "Intended on Obligation: the LLM-suggested ontology obligation class label."@en .


# --- State ---
proeth:subject a owl:DatatypeProperty ;
    rdfs:label "subject"@en ;
    rdfs:range xsd:string ;
    rdfs:comment "Intended on State: the entity the state holds of."@en .

proeth:affectedParties a owl:DatatypeProperty ;
    rdfs:label "affected parties"@en ;
    rdfs:range xsd:string ;
    rdfs:comment "Intended on State: parties the state bears on (also resolved to proeth-core:affects edges)."@en .

proeth:activePeriod a owl:DatatypeProperty ;
    rdfs:label "active period"@en ;
    rdfs:range xsd:string ;
    rdfs:comment "Intended on State: the period over which the state holds."@en .

proeth:triggeringEvent a owl:DatatypeProperty ;
    rdfs:label "triggering event"@en ;
    rdfs:range xsd:string ;
    rdfs:comment "Intended on State: the event bringing the state into being."@en .

proeth:terminatedBy a owl:DatatypeProperty ;
    rdfs:label "terminated by"@en ;
    rdfs:range xsd:string ;
    rdfs:comment "Intended on State: what removes the state."@en .

proeth:urgencyLevel a owl:DatatypeProperty ;
    rdfs:label "urgency level"@en ;
    rdfs:range xsd:string ;
    rdfs:comment "Intended individual-level on State/Event: per-occurrence urgency judgment (Jones 1991 salience), not a subkind."@en .

proeth:persistenceType a owl:DatatypeProperty ;
    rdfs:label "persistence type"@en ;
    rdfs:range xsd:string ;
    rdfs:comment "Intended class-level on a State archetype: the Berreby et al. (2017) Event-Calculus fluent character, inertial (persists until terminated) or non_inertial (holds momentarily)."@en .

proeth:principleTransformation a owl:DatatypeProperty ;
    rdfs:label "principle transformation"@en ;
    rdfs:range xsd:string ;
    rdfs:comment "Intended on State: state-edge annotation grounding an R->P->O derivation."@en .

proeth:stateClass a owl:DatatypeProperty ;
    rdfs:label "state class"@en ;
    rdfs:range xsd:string ;
    rdfs:comment "Intended on State: the LLM-suggested ontology state class label."@en .


# --- Resource ---
proeth:documentTitle a owl:DatatypeProperty ;
    rdfs:label "document title"@en ;
    rdfs:range xsd:string ;
    rdfs:comment "Intended on Resource: the resource/document title."@en .

proeth:topic a owl:DatatypeProperty ;
    rdfs:label "topic"@en ;
    rdfs:range xsd:string ;
    rdfs:comment "Intended on Resource: the subject the resource addresses. A first-class Resource field (decision B2), declared distinct from the otherAttribute overflow string because topic is a known, near-always-present field rather than the uncontrolled tail."@en .

proeth:usedInContext a owl:DatatypeProperty ;
    rdfs:label "used in context"@en ;
    rdfs:range xsd:string ;
    rdfs:comment "Intended on Resource: the context the resource is used in."@en .

proeth:usedBy a owl:DatatypeProperty ;
    rdfs:label "used by"@en ;
    rdfs:range xsd:string ;
    rdfs:comment "Intended on Resource: who uses it (also resolved to proeth-core:availableTo edges)."@en .

proeth:createdBy a owl:DatatypeProperty ;
    rdfs:label "created by"@en ;
    rdfs:range xsd:string ;
    rdfs:comment "Intended on Resource: who created it."@en .

proeth:version a owl:DatatypeProperty ;
    rdfs:label "version"@en ;
    rdfs:range xsd:string ;
    rdfs:comment "Intended on Resource: resource version/edition."@en .

proeth:resourceClass a owl:DatatypeProperty ;
    rdfs:label "resource class"@en ;
    rdfs:range xsd:string ;
    rdfs:comment "Intended on Resource: the LLM-suggested ontology resource class label."@en .


# --- Capability ---
proeth:capabilityStatement a owl:DatatypeProperty ;
    rdfs:label "capability statement"@en ;
    rdfs:range xsd:string ;
    rdfs:comment "Intended on Capability: the statement of the competence."@en .

proeth:demonstratedThrough a owl:DatatypeProperty ;
    rdfs:label "demonstrated through"@en ;
    rdfs:range xsd:string ;
    rdfs:comment "Intended on Capability: textual evidence the capability was exercised."@en .

proeth:proficiencyLevel a owl:DatatypeProperty ;
    rdfs:label "proficiency level"@en ;
    rdfs:range xsd:string ;
    rdfs:comment "Intended on Capability: proficiency rating (e.g. expert)."@en .

proeth:capabilityClass a owl:DatatypeProperty ;
    rdfs:label "capability class"@en ;
    rdfs:range xsd:string ;
    rdfs:comment "Intended on Capability: the LLM-suggested ontology capability class label."@en .


# --- Constraint ---
proeth:constraintStatement a owl:DatatypeProperty ;
    rdfs:label "constraint statement"@en ;
    rdfs:range xsd:string ;
    rdfs:comment "Intended on Constraint: the statement of the limit."@en .

proeth:severity a owl:DatatypeProperty ;
    rdfs:label "severity"@en ;
    rdfs:range xsd:string ;
    rdfs:comment "Intended on Constraint/Event: severity judgment."@en .

proeth:source a owl:DatatypeProperty ;
    rdfs:label "source"@en ;
    rdfs:range xsd:string ;
    rdfs:comment "Intended on Constraint: the source of the constraint."@en .

proeth:constraintClass a owl:DatatypeProperty ;
    rdfs:label "constraint class"@en ;
    rdfs:range xsd:string ;
    rdfs:comment "Intended on Constraint: the LLM-suggested ontology constraint class label."@en .


# --- Action / Event (temporal) ---
proeth:hasAgent a owl:DatatypeProperty ;
    rdfs:label "has agent"@en ;
    rdfs:range xsd:string ;
    rdfs:comment "Intended on Action: the acting agent name."@en .

proeth:agentRelation a owl:DatatypeProperty ;
    rdfs:label "agent relation"@en ;
    rdfs:range xsd:string ;
    rdfs:comment "Intended on Action: the joining keyword (and / or / with / in_conjunction_with) for a composite multi-actor agent (rdf_converter.decompose_agents)."@en .

proeth:eventRoleContext a owl:DatatypeProperty ;
    rdfs:label "event role context"@en ;
    rdfs:range xsd:string ;
    rdfs:comment "Intended on Action: the per-event role context of the agent."@en .

proeth:intendedOutcome a owl:DatatypeProperty ;
    rdfs:label "intended outcome"@en ;
    rdfs:range xsd:string ;
    rdfs:comment "Intended on Action: the intended outcome."@en .

proeth:hasMentalState a owl:DatatypeProperty ;
    rdfs:label "has mental state"@en ;
    rdfs:range xsd:string ;
    rdfs:comment "Intended on Action: the agent's mental state."@en .

proeth:foreseenUnintendedEffects a owl:DatatypeProperty ;
    rdfs:label "foreseen unintended effects"@en ;
    rdfs:range xsd:string ;
    rdfs:comment "Intended on Action: foreseen unintended effects."@en .

proeth:withinCompetence a owl:DatatypeProperty ;
    rdfs:label "within competence"@en ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Intended on Action: whether the action was within the agent's competence."@en .

proeth:temporalExtent a owl:DatatypeProperty ;
    rdfs:label "temporal extent"@en ;
    rdfs:range xsd:string ;
    rdfs:comment "Intended on Action/Event: instant or interval."@en .

proeth:eventType a owl:DatatypeProperty ;
    rdfs:label "event type"@en ;
    rdfs:range xsd:string ;
    rdfs:comment "Intended on Event: Event-Calculus occurrence type."@en .

proeth:causesStateChange a owl:DatatypeProperty ;
    rdfs:label "causes state change"@en ;
    rdfs:range xsd:string ;
    rdfs:comment "Intended on Event: prose summary of the state change."@en .


# --- Object-property literal shadows (datatype siblings of object properties) ---
proeth:fulfillsObligationText a owl:DatatypeProperty ;
    rdfs:label "fulfills obligation text"@en ;
    rdfs:range xsd:string ;
    rdfs:comment "Literal shadow of the fulfillsObligation edge (Action)."@en .

proeth:violatesObligationText a owl:DatatypeProperty ;
    rdfs:label "violates obligation text"@en ;
    rdfs:range xsd:string ;
    rdfs:comment "Literal shadow of the violatesObligation edge (Action)."@en .

proeth:guidedByPrincipleText a owl:DatatypeProperty ;
    rdfs:label "guided by principle text"@en ;
    rdfs:range xsd:string ;
    rdfs:comment "Literal shadow of the guidedByPrinciple edge (Action)."@en .

proeth:requiresCapabilityText a owl:DatatypeProperty ;
    rdfs:label "requires capability text"@en ;
    rdfs:range xsd:string ;
    rdfs:comment "Literal shadow of the requiresCapability relation (Action)."@en .

proeth:raisesObligationText a owl:DatatypeProperty ;
    rdfs:label "raises obligation text"@en ;
    rdfs:range xsd:string ;
    rdfs:comment "Literal shadow of the raisesObligation edge (Action)."@en .

proeth:initiatesText a owl:DatatypeProperty ;
    rdfs:label "initiates text"@en ;
    rdfs:range xsd:string ;
    rdfs:comment "Literal shadow of the initiates fluent edge (Action/Event)."@en .

proeth:terminatesText a owl:DatatypeProperty ;
    rdfs:label "terminates text"@en ;
    rdfs:range xsd:string ;
    rdfs:comment "Literal shadow of the terminates fluent edge (Action/Event)."@en .

# Participant 'who' literal shadows: the intermediate# literal, DISTINCT from the
# core# object-property edge the participant applier materialises (different IRIs,
# so no punning). The former proeth:invokedBy literal twin was deleted 2026-07-05:
# the commit never wrote it (the CMT-3 routing skip) and rpo_edges now reads the
# proeth-core:invokedBy edges directly, so the declaration described a triple that
# never existed.

proeth:obligatedParty a owl:DatatypeProperty ;
    rdfs:label "obligated party (literal)"@en ;
    rdfs:range xsd:string ;
    rdfs:comment "Intended on Obligation: literal naming who bears it; mirrored by the proeth-core:obligatedParty edge."@en .

proeth:possessedBy a owl:DatatypeProperty ;
    rdfs:label "possessed by (literal)"@en ;
    rdfs:range xsd:string ;
    rdfs:comment "Intended on Capability: literal naming who possesses it; mirrored by the proeth-core:possessedBy edge."@en .

proeth:constrainedEntity a owl:DatatypeProperty ;
    rdfs:label "constrained entity (literal)"@en ;
    rdfs:range xsd:string ;
    rdfs:comment "Intended on Constraint: literal naming who/what is constrained; mirrored by the proeth-core:constrainedEntity edge."@en .


# --- Controlled professional attributes (Role attributes dict, Part B) ---
# Spellings are canonical with the SHACL ProfessionalRolePropertyShape paths
# (core-shapes.ttl) and the named-field commit emission: license, specialty,
# employer. The former hasLicense/hasSpecialty/hasEmployer twins (the
# attribute-bag mapping targets) were consolidated onto these 2026-07-05:
# zero corpus references existed, and the split meant the same datum reached
# a different predicate depending on extraction placement (named field vs
# attributes bag; correspondence audit M4).
proeth:license a owl:DatatypeProperty ;
    rdfs:label "license"@en ;
    rdfs:range xsd:string ;
    rdfs:comment "Controlled Role attribute: professional license/licensure (maps license, licensure, licenseStatus)."@en .

proeth:specialty a owl:DatatypeProperty ;
    rdfs:label "specialty"@en ;
    rdfs:range xsd:string ;
    rdfs:comment "Controlled Role attribute: area of specialization (maps specialty, specialization)."@en .

proeth:experienceLevel a owl:DatatypeProperty ;
    rdfs:label "experience level"@en ;
    rdfs:range xsd:string ;
    rdfs:comment "Controlled Role attribute: professional experience (maps experience, yearsOfExperience)."@en .

proeth:employer a owl:DatatypeProperty ;
    rdfs:label "employer"@en ;
    rdfs:range xsd:string ;
    rdfs:comment "Controlled Role attribute: employer/affiliation (maps employer, employedBy)."@en .

proeth:hasJurisdiction a owl:DatatypeProperty ;
    rdfs:label "has jurisdiction"@en ;
    rdfs:range xsd:string ;
    rdfs:comment "Controlled Role attribute: licensing/practice jurisdiction (maps jurisdiction)."@en .

proeth:registrationStatus a owl:DatatypeProperty ;
    rdfs:label "registration status"@en ;
    rdfs:range xsd:string ;
    rdfs:comment "Controlled Role attribute: professional registration status (maps registration)."@en .

proeth:roleInOrganization a owl:DatatypeProperty ;
    rdfs:label "role in organization"@en ;
    rdfs:range xsd:string ;
    rdfs:comment "Controlled Role attribute: position within the organisation (maps position, roleInOrganization)."@en .

proeth:technicalBackground a owl:DatatypeProperty ;
    rdfs:label "technical background"@en ;
    rdfs:range xsd:string ;
    rdfs:comment "Controlled Role attribute: technical background (maps technicalBackground)."@en .

proeth:roleNature a owl:DatatypeProperty ;
    rdfs:label "role nature"@en ;
    rdfs:range xsd:string ;
    rdfs:comment "Controlled Role attribute: the kind/nature of the role-bearer, e.g. 'Affected public', 'Manufacturing corporation' (maps the recurring type, entityType attribute keys)."@en .

proeth:otherAttribute a owl:DatatypeProperty ;
    rdfs:label "other attribute"@en ;
    rdfs:range xsd:string ;
    rdfs:comment "Closed-vocabulary overflow for a genuinely case-specific role attribute not in the controlled set. Carries the original key and value as a 'key: value' literal, so the data is preserved while the datatype-predicate space stays finite and fully declared."@en .

# --- Schema routing inputs (declared 2026-07-05) ---
# The per-component SHACL definition shapes (core-shapes.ttl) reference these
# as sh:path, and the prompts request them, but they had no declarations, so
# their names could not resolve to entity pages (nine-component clickability
# sweep). Each is a ROUTING INPUT: consumed at commit to drive the
# subClassOf/rdf:type typing and deliberately NOT stored as a literal on
# fresh-architecture entities. Declared so the schema vocabulary is fully
# resolvable; string-ranged for the legacy rows that do carry values.

proeth:principleCategory a owl:DatatypeProperty ;
    rdfs:label "principle category"@en ;
    rdfs:range xsd:string ;
    rdfs:comment "Routing input: the controlled principle kind driving the four-kind subClassOf typing (FundamentalEthicalPrinciple, ProfessionalVirtuePrinciple, RelationalPrinciple, DomainSpecificPrinciple). Consumed at commit; not stored as a literal."@en .

proeth:obligationType a owl:DatatypeProperty ;
    rdfs:label "obligation type"@en ;
    rdfs:range xsd:string ;
    rdfs:comment "Routing input: the controlled NSPE obligation category driving the subClassOf core:Obligation typing (disclosure, safety, competence, confidentiality, reporting, collegial, ...). Consumed at commit; not stored as a literal."@en .

proeth:stateCategory a owl:DatatypeProperty ;
    rdfs:label "state category"@en ;
    rdfs:range xsd:string ;
    rdfs:comment "Routing input: the content archetype driving the archetype subClassOf typing (EpistemicState, RiskState, CompetenceState, EmergencyState, ConflictOfInterestState, RegulatoryApplicabilityState, ...). Consumed at commit; not stored as a literal."@en .

proeth:sourceKind a owl:DatatypeProperty ;
    rdfs:label "source kind"@en ;
    rdfs:range xsd:string ;
    rdfs:comment "Routing input: the controlled source kind driving the five-kind Resource typing (ethical_code, technical_standard, case_precedent, legal_resource, reference_material). Consumed at commit; not stored as a literal."@en .

proeth:capabilityKind a owl:DatatypeProperty ;
    rdfs:label "capability kind"@en ;
    rdfs:range xsd:string ;
    rdfs:comment "Routing input: the canonical, tool/actor-neutral competence kind driving the subClassOf typing to a named capability class. Consumed at commit; not stored as a literal."@en .

proeth:boundaryType a owl:DatatypeProperty ;
    rdfs:label "boundary type"@en ;
    rdfs:range xsd:string ;
    rdfs:comment "Routing input: the controlled constraint boundary type driving the subClassOf typing into the ten closed boundary-type classes (LegalConstraint, RegulatoryConstraint, ...). Consumed at commit; not stored as a literal."@en .

proeth:eventType a owl:DatatypeProperty ;
    rdfs:label "event type"@en ;
    rdfs:range xsd:string ;
    rdfs:comment "Routing input: the event origin kind driving the three-way subClassOf typing into the mutually disjoint origin subclasses (outcome to AgentCausedEvent, exogenous to ExogenousEvent, automatic to AutomaticEvent; Berreby/Sarmiento). Consumed at commit; not stored as a literal. Named eventType to match the extraction schema field and the SHACL path (the former eventOrigin spelling never appeared in data)."@en .

# --- Class-mint content fields referenced by the definition shapes ---

proeth:extensionalCases a owl:DatatypeProperty ;
    rdfs:label "extensional cases"@en ;
    rdfs:range xsd:string ;
    rdfs:comment "Class-level prior cases that instantiate a principle (McLaren extensional grounding); an optional class-mint field on principle classes."@en .

proeth:applicabilityCondition a owl:DatatypeProperty ;
    rdfs:label "applicability condition"@en ;
    rdfs:range xsd:string ;
    rdfs:comment "The temporal and contextual circumstances under which a constraint or prohibition applies in a case (the Dennis complete-specification condition). Borne by constraint individuals."@en .

###############################################################
# Analysis-layer datatype properties (declared 2026-07-04)
#
# The commit bridge has always written these intermediate-namespace literals
# on the Step-4 analysis individuals (typed proeth-cases:EthicalQuestion /
# EthicalConclusion / DecisionPoint), but they were never declared: the old
# proethica-cases 2.0.0 file declared same-named properties in the CASES
# namespace, which no data ever used. Declared here, domainless (the bearer
# classes live in the cases ontology, which imports this one), to keep the
# emitted datatype-predicate vocabulary closed and self-describing.
###############################################################

proeth:questionText a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "question text"@en ;
    rdfs:comment "The verbatim text of an ethical question. Borne by proeth-cases:EthicalQuestion individuals."@en .

proeth:questionType a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "question type"@en ;
    rdfs:comment "The kind of ethical question (board-explicit or derived). Borne by proeth-cases:EthicalQuestion individuals."@en .

proeth:questionNumber a owl:DatatypeProperty ;
    rdfs:range xsd:integer ;
    rdfs:label "question number"@en ;
    rdfs:comment "Sequential position of the question within the case. Borne by proeth-cases:EthicalQuestion individuals."@en .

proeth:emergence a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "emergence"@en ;
    rdfs:comment "Inline emergence rationale for a question; the full rationale is the linked proeth-cases:QuestionEmergence individual."@en .

proeth:conclusionText a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "conclusion text"@en ;
    rdfs:comment "The verbatim text of an ethical conclusion. Borne by proeth-cases:EthicalConclusion individuals."@en .

proeth:conclusionType a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "conclusion type"@en ;
    rdfs:comment "The kind of conclusion (board-explicit finding or interpretive refinement). Borne by proeth-cases:EthicalConclusion individuals."@en .

proeth:conclusionNumber a owl:DatatypeProperty ;
    rdfs:range xsd:integer ;
    rdfs:label "conclusion number"@en ;
    rdfs:comment "Sequential position of the conclusion within the case; values of 100 and above mark synthetic interpretive refinements. Borne by proeth-cases:EthicalConclusion individuals."@en .

proeth:extractionReasoning a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "extraction reasoning"@en ;
    rdfs:comment "The extractor's stated reasoning for a conclusion record. Borne by proeth-cases:EthicalConclusion individuals."@en .

proeth:decisionPointId a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "decision point id"@en ;
    rdfs:comment "Short identifier of a decision point (e.g. DP1). Borne by proeth-cases:DecisionPoint individuals."@en .

proeth:decisionQuestion a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "decision question"@en ;
    rdfs:comment "The choice the actor faces at the decision point, phrased as a question. Borne by proeth-cases:DecisionPoint individuals."@en .

proeth:focus a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "focus"@en ;
    rdfs:comment "The full description of what a decision point concerns. Borne by proeth-cases:DecisionPoint individuals."@en .

proeth:context a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "context"@en ;
    rdfs:comment "Narrative context in which a decision point arises. Borne by proeth-cases:DecisionPoint individuals."@en .

proeth:roleLabel a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "role label"@en ;
    rdfs:comment "Label of the role facing the decision point. Borne by proeth-cases:DecisionPoint individuals."@en .

proeth:option a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "option"@en ;
    rdfs:comment "One alternative available at a decision point, prefixed with its ordinal (e.g. '1. ...') so the sequence survives as a repeated single predicate. Borne by proeth-cases:DecisionPoint individuals. Replaces the unbounded option1/option2/... family (2026-07-04)."@en .

proeth:citedProvision a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "cited provision"@en ;
    rdfs:comment "A code provision designation cited by an analysis record. Repeated per provision. Replaces the unbounded citedProvision1/... family on conclusions (2026-07-04); the enrichment path already used the singular form."@en .

proeth:answersQuestion a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "answers question"@en ;
    rdfs:comment "The number of an ethical question a conclusion answers. Repeated per question. Replaces the unbounded answersQuestion1/... family (2026-07-04)."@en .

proeth:causalStep a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "causal step"@en ;
    rdfs:comment "One step of a causal chain, prefixed with its ordinal so the sequence survives as a repeated single predicate. Replaces the unbounded causalStep1/... family (2026-07-04)."@en .
