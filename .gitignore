# Python standard ignores
__pycache__/
*.py[cod]
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
*.log
*.pot
*.pyc
*.pyo
*.pyd
*.sqlite3
*.db

# Virtual Environment
venv/
venv-*/
.venv/
ENV/
env/

# Environment variables
*.env
!config/*.env
!config/*.env.template

# IDE
.vscode/
*.swp

# OS files
.DS_Store
Thumbs.db

# Claude internal files
.claude/
CLAUDE.md
docs-internal/

# Documentation directories (development/internal only)
*/docs/

# Scripts and development artifacts
scripts/
*/scripts/
scratch/
*/scratch/
pending_delete/
*/pending_delete/

# Cache
cache/
storage/cache/

# Storage runtime data
storage/metadata/
storage/versions/
/storage/ontologies/

# Production server local config
/web/config.py

# Backups
*.bak
*.tmp
*.local
*.backup
backups/

# Archive
archive/

# Temporary ontology extraction files (runtime data, not schemas)
ontologies/proethica-intermediate-extended.ttl
ontologies/proethica-case-*.ttl
ontologies/*_subclasses_to_add.ttl

# Test artifacts
.pytest_cache/
htmlcov/
.coverage
coverage.xml
*.cover
.hypothesis/
tests/test_log.txt
.tox/
.pids/

# Local tool configuration
pytest.ini
