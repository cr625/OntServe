# OntServe External API Keys
#
# Copy this file to api_keys.env and fill in your keys.
# api_keys.env is gitignored; this template is tracked.

# =============================================================================
# Wolfram
# =============================================================================
# AgentOne API (chat completions): https://www.wolfram.com/apis/documentation/cag/wolfram-agent-one-api/
# Key management: https://account.wolfram.com/developer-tools/api-keys
WOLFRAM_API_KEY=
WOLFRAM_TIMEOUT=120

# =============================================================================
# Zotero
# =============================================================================
# API key: https://www.zotero.org/settings/keys
# User ID: visible at https://www.zotero.org/settings/keys (numeric ID in the URL)
ZOTERO_API_KEY=
ZOTERO_USER_ID=
# Library type: "user" for personal library, "group" for a group library
ZOTERO_LIBRARY_TYPE=user
