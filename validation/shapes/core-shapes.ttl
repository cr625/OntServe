@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix core: <http://proethica.org/ontology/core#> .
@prefix proeth: <http://proethica.org/ontology/intermediate#> .
@prefix pcsh: <http://proethica.org/shapes/core#> .

# ProEthica core conformance shapes (domain-GENERAL; shared by every domain).
# Run with pyshacl inference='owlrl' so the OWL-RL closure (subClassOf* transitivity
# scm-sco + rdfs:domain inference prp-dom) is materialized BEFORE validation; then the
# disjoint-core-category check below catches the F2-class clash (an individual that
# reaches two of the nine mutually-disjoint core categories, e.g. via a type chain to
# Principle AND an Obligation-domain property) with an actionable per-node report --
# which the raw OWL-DL "inconsistent" verdict cannot give. Per-domain shapes layer on
# top of this file (see config/domains/<domain>.yaml shapes_files).

pcsh: a owl:Ontology ;
    rdfs:label "ProEthica core conformance shapes" ;
    sh:declare [ sh:prefix "core" ; sh:namespace "http://proethica.org/ontology/core#"^^xsd:anyURI ] ;
    sh:declare [ sh:prefix "owl"  ; sh:namespace "http://www.w3.org/2002/07/owl#"^^xsd:anyURI ] ;
    sh:declare [ sh:prefix "rdf"  ; sh:namespace "http://www.w3.org/1999/02/22-rdf-syntax-ns#"^^xsd:anyURI ] .

# RULE 1: no individual may resolve to two distinct disjoint core categories.
# This is the structural projection of the nine-way owl:AllDisjointClasses. After the
# OWL-RL closure, an offending individual carries rdf:type for two core classes directly.
pcsh:DisjointCoreCategoryShape
    a sh:NodeShape ;
    sh:targetClass owl:NamedIndividual ;
    rdfs:label "Single core category per individual" ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Individual reaches two disjoint core categories ({?c1} and {?c2}); violates the nine-way AllDisjointClasses. Re-type to one category or drop the conflicting property/type." ;
        sh:severity sh:Violation ;
        sh:prefixes pcsh: ;
        sh:select """
            SELECT $this ?c1 ?c2
            WHERE {
                $this rdf:type ?c1 .
                $this rdf:type ?c2 .
                FILTER(?c1 != ?c2)
                FILTER(?c1 IN (core:Role, core:Principle, core:Obligation, core:State,
                               core:Resource, core:Action, core:Event, core:Capability,
                               core:Constraint))
                FILTER(?c2 IN (core:Role, core:Principle, core:Obligation, core:State,
                               core:Resource, core:Action, core:Event, core:Capability,
                               core:Constraint))
                FILTER(STR(?c1) < STR(?c2))
            }
        """ ;
    ] .

# RULE 2: belt-and-suspenders -- no individual may be inferred as owl:Nothing (a hard
# clash some OWL-RL engines materialize directly).
pcsh:NoOwlNothingShape
    a sh:NodeShape ;
    sh:targetClass owl:NamedIndividual ;
    rdfs:label "No individual typed owl:Nothing" ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Individual is inferred to be owl:Nothing (an unsatisfiable / hard clash)." ;
        sh:severity sh:Violation ;
        sh:prefixes pcsh: ;
        sh:select """
            SELECT $this
            WHERE { $this rdf:type owl:Nothing . }
        """ ;
    ] .

# RoleDefinitionShape: the UNIVERSAL definitional schema of any role TYPE (the R component's
# class-level attributes that every role has, professional or not). Trimmed 2026-06-26: the
# professional-role-specific definitional attrs (scope, qualifications, virtues, generated obligations,
# adhered principles) moved to ProfessionalRoleDefinitionShape, and the bearer data moved to
# ProfessionalRolePropertyShape, because a participant/stakeholder role (e.g. an affected citizen) has
# none of those. Descriptive only (sh:path/sh:name/sh:description/sh:order); no validation. Values are
# carried by the role CLASS. The extraction schema for a role is the UNION of the shapes along its class
# chain (hybrid: ontology owns the definition).
pcsh:RoleDefinitionShape
    a sh:NodeShape ;
    sh:targetClass core:Role ;
    rdfs:label "Role definition schema (universal, type-level, descriptive)" ;
    rdfs:comment "What ANY role TYPE is individuated by, universal across professional and participant roles: its distinguishing features and its audience-relationship category. Professional-specific definitional attrs are on ProfessionalRoleDefinitionShape; bearer data on ProfessionalRolePropertyShape." ;
    sh:property [ sh:path core:distinguishingFeatures ; sh:name "distinguishing features" ; sh:description "What sets this role type apart from related roles (its distinctive ends/practices)." ; sh:order 1 ] ;
    sh:property [ sh:path proeth:roleCategory ;         sh:name "role category" ;           sh:description "The role's audience-relationship category (the four Kong 2020 categories plus participant/stakeholder): provider_client, professional_peer, employer_relationship, public_responsibility, participant, stakeholder." ; sh:order 2 ] .

# ProfessionalRoleDefinitionShape: the PROFESSIONAL-role-specific definitional attrs (type-level), on top
# of the universal RoleDefinitionShape. These individuate a professional role (Engineer, Architect, ...),
# not a participant/stakeholder role: professional scope, the qualifications the type requires, the virtues
# of the profession, and the R->P->O the type carries (the obligations it generates + the principles it
# adheres to). Targets proeth:ProfessionalRole so participant/stakeholder roles do not offer them.
pcsh:ProfessionalRoleDefinitionShape
    a sh:NodeShape ;
    sh:targetClass proeth:ProfessionalRole ;
    rdfs:label "Professional-role definition schema (type-level, descriptive)" ;
    rdfs:comment "Professional-role-specific definitional attributes, layered on the universal RoleDefinitionShape. A participant/stakeholder role (e.g. an affected citizen) carries none of these." ;
    sh:property [ sh:path core:professionalScope ;     sh:name "professional scope" ;      sh:description "Areas of responsibility and authority of the role type (Oakley & Cocking 2001)." ; sh:order 1 ] ;
    sh:property [ sh:path core:typicalQualifications ; sh:name "typical qualifications" ;  sh:description "Generic credentials the role TYPE requires (a descriptor of the type, not an individual's license)." ; sh:order 2 ] ;
    sh:property [ sh:path core:associatedVirtues ;     sh:name "associated virtues" ;      sh:description "Virtues/dispositions characteristic of the professional role type (Kong 2020 identity virtues; Oakley & Cocking 2001)." ; sh:order 3 ] ;
    sh:property [ sh:path core:hasObligation ;         sh:name "generated obligations" ;   sh:description "The obligations the role generates, via the R->P->O hasObligation edges (obligation-generation; Dennis 2016). Range: Obligation." ; sh:order 4 ] ;
    sh:property [ sh:path core:adheresToPrinciple ;    sh:name "adhered principles" ;      sh:description "The principles the role serves/adheres to, via the R->P->O adheresToPrinciple edges (the P side of the triple; sibling of generated obligations). Range: Principle." ; sh:order 5 ] .

# RolePropertyShape: the controlled property SCHEMA for professional roles -- a
# machine-visible declaration of which attributes a well-formed role-bearing individual
# MAY carry. PURELY DESCRIPTIVE: each sh:property carries only sh:path + sh:name +
# sh:description (no sh:minCount, no sh:datatype), so it produces NO validation result and
# cannot change conformance; it makes the "intended on Role" association -- previously only
# in an rdfs:comment on each datatype property -- machine-readable for tooling and UI.
#
# Why this is in SHACL and NOT as rdfs:domain on the properties: rdfs:domain is an OWL
# INFERENCE axiom (W3C OWL 2 Primer: a domain statement "is not a constraint... but allows
# a reasoner to infer further knowledge"), so "hasLicense rdfs:domain Role" would infer any
# value-holder INTO Role; under the nine-way owl:AllDisjointClasses (conformance runs at
# inference='owlrl', materialising prp-dom) a leaked attribute could then clash into an
# inconsistency. The role attributes are therefore deliberately domain-less ("leak-safe");
# this shape carries the class association safely. Turn any attribute into a real
# closed-world constraint later by adding sh:minCount / sh:datatype / sh:in here (the
# controlled-property-vocabulary work item) -- the values are still asserted on the individual.
pcsh:ProfessionalRolePropertyShape
    a sh:NodeShape ;
    sh:targetClass proeth:ProfessionalRole ;
    rdfs:label "Professional-role-bearer attributes (individual data, non-definitional)" ;
    rdfs:comment "Per-occupant data a PROFESSIONAL role-bearing INDIVIDUAL may have (license, specialty, employer, technical background). Descriptive only; these do NOT define the role type (cf. Davis 1991: license is not role-defining). Retargeted 2026-06-26 from core:Role to proeth:ProfessionalRole: a participant/stakeholder role (an affected citizen) has none of these; the universal role schema is RoleDefinitionShape. Values are asserted on the individual. Tightened 2026-06-25: dropped roleNature/roleClass (extraction provenance, not bearer data; reclassify to PROV-O) and jurisdiction/registrationStatus/roleInOrganization (weak controlled-vocab; captured via otherAttribute overflow when actually present)." ;
    sh:property [ sh:path proeth:hasLicense ;          sh:name "license" ;              sh:description "Professional license / licensure." ;                      sh:order 1 ] ;
    sh:property [ sh:path proeth:hasSpecialty ;        sh:name "specialty" ;            sh:description "Area of specialisation." ;                                sh:order 2 ] ;
    sh:property [ sh:path proeth:experienceLevel ;     sh:name "experience level" ;     sh:description "Professional experience." ;                               sh:order 3 ] ;
    sh:property [ sh:path proeth:hasEmployer ;         sh:name "employer" ;             sh:description "Employer / affiliation." ;                                sh:order 4 ] ;
    sh:property [ sh:path proeth:technicalBackground ; sh:name "technical background" ; sh:description "Technical background." ;                                  sh:order 5 ] ;
    sh:property [ sh:path proeth:otherAttribute ;      sh:name "other attribute" ;      sh:description "Overflow 'key: value' literal for a case-specific attribute outside the controlled set." ; sh:order 6 ] .
