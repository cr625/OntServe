@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix core: <http://proethica.org/ontology/core#> .
@prefix proeth: <http://proethica.org/ontology/intermediate#> .
@prefix pcsh: <http://proethica.org/shapes/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

# ProEthica core conformance shapes (domain-GENERAL; shared by every domain).
# Run with pyshacl inference='owlrl' so the OWL-RL closure (subClassOf* transitivity
# scm-sco + rdfs:domain inference prp-dom) is materialized BEFORE validation; then the
# disjoint-core-category check below catches the F2-class clash (an individual that
# reaches two of the nine mutually-disjoint core categories, e.g. via a type chain to
# Principle AND an Obligation-domain property) with an actionable per-node report --
# which the raw OWL-DL "inconsistent" verdict cannot give. Per-domain shapes layer on
# top of this file (see config/domains/<domain>.yaml shapes_files).

pcsh: a owl:Ontology ;
    rdfs:label "ProEthica core conformance shapes"@en ;
    dcterms:title "ProEthica SHACL Shapes"@en ;
    rdfs:comment "The descriptive SHACL schema contract for the nine ProEthica core components: per-component definition shapes (type-level fields such as principleCategory or extensionalCases) and per-case property shapes (individual bearer fields such as license, specialty, employer), plus the two validation rules the conformance tool enforces. The Property Structure sections of the component class pages, the schema blocks of the extraction prompts, and the conformance MCP tools all derive from these shapes. SHACL node shapes are individuals, so on the ontology page the shapes appear under Individuals, not Classes. Single source: validation/shapes/core-shapes.ttl, registered in OntServe as proethica-shapes via symlink."@en ;
    sh:declare [ sh:prefix "core" ; sh:namespace "http://proethica.org/ontology/core#"^^xsd:anyURI ] ;
    sh:declare [ sh:prefix "owl"  ; sh:namespace "http://www.w3.org/2002/07/owl#"^^xsd:anyURI ] ;
    sh:declare [ sh:prefix "rdf"  ; sh:namespace "http://www.w3.org/1999/02/22-rdf-syntax-ns#"^^xsd:anyURI ] .

# Generic informational-field marker for the {{ <comp>_schema }} prompt wire. A sh:property
# annotated pcsh:informationalOnly true is a field the COMMIT stage assigns (a TBox restriction
# or resolver-produced edge), not a field the extraction LLM fills: _component_schema_block
# (ProEthica prompt_variable_resolver) renders it with "(assigned at commit; do not output)"
# instead of as a fillable field. The sh:description stays neutral because it dual-renders on
# the OntServe entity page. Descriptive only; no validation effect.
pcsh:informationalOnly a owl:AnnotationProperty ;
    rdfs:label "informational only (assigned at commit)"@en ;
    rdfs:comment "Marks a descriptive SHACL property as informational in the extraction field contract: the value is assigned at commit (TBox restriction or resolver edge), so the prompt renders it as non-fillable context rather than a requested output field."@en .

# CaseAnnotationShape: the shared per-case annotation fields EVERY committed individual carries,
# regardless of component: extraction confidence, the verbatim supporting quotes, the source
# snippet, and the involvement/context gloss. Declared once here (rather than nine times) so the
# fields are schema-advertised instead of displayed-but-undeclared (correspondence audit T7).
# Descriptive only; no validation effect.
# Rendering intent (decided 2026-07-06): the shape is advertised in the entity-page TTL block
# (every shape targeting a chain ancestor is appended there) and is deliberately NOT rendered as
# a Property Structure section. The fields are commit-time bookkeeping on case individuals, not
# part of any type's extraction schema, so a schema section would misstate the field contract.
pcsh:CaseAnnotationShape
    a sh:NodeShape ;
    sh:targetClass core:Role, core:Principle, core:Obligation, core:State, core:Resource,
        core:Action, core:Event, core:Capability, core:Constraint ;
    rdfs:label "Shared per-case annotation schema (all nine components)"@en ;
    rdfs:comment "The cross-component annotation fields asserted on every committed case individual: proeth:confidence (extraction confidence, decimal), proeth:textReferences (verbatim supporting quotes), proeth-prov sourceText (the source snippet, on the provenance layer), and the involvement gloss (proeth:caseInvolvement on role individuals, proeth:caseContext on capability and constraint individuals). Values are per-individual; the fields do not individuate any type."@en ;
    sh:property [ sh:path proeth:confidence ; sh:name "confidence" ; sh:description "Extraction confidence for this individual (0 to 1)." ; sh:order 1 ] ;
    sh:property [ sh:path proeth:textReferences ; sh:name "text references" ; sh:description "Verbatim case quotes supporting this individual." ; sh:order 2 ] ;
    sh:property [ sh:path proeth:caseInvolvement ; sh:name "case involvement" ; sh:description "How this individual figures in the case narrative (role individuals; the same text is routed into rdfs:comment)." ; sh:order 3 ] ;
    sh:property [ sh:path proeth:caseContext ; sh:name "case context" ; sh:description "Grounding context in this case (capability and constraint individuals)." ; sh:order 4 ] .

# RULE 1: no individual may resolve to two distinct disjoint core categories.
# This is the structural projection of the nine-way owl:AllDisjointClasses. After the
# OWL-RL closure, an offending individual carries rdf:type for two core classes directly.
pcsh:DisjointCoreCategoryShape
    a sh:NodeShape ;
    sh:targetClass owl:NamedIndividual ;
    rdfs:label "Single core category per individual"@en ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Individual reaches two disjoint core categories ({?c1} and {?c2}); violates the nine-way AllDisjointClasses. Re-type to one category or drop the conflicting property/type." ;
        sh:severity sh:Violation ;
        sh:prefixes pcsh: ;
        sh:select """
            SELECT $this ?c1 ?c2
            WHERE {
                $this rdf:type ?c1 .
                $this rdf:type ?c2 .
                FILTER(?c1 != ?c2)
                FILTER(?c1 IN (core:Role, core:Principle, core:Obligation, core:State,
                               core:Resource, core:Action, core:Event, core:Capability,
                               core:Constraint))
                FILTER(?c2 IN (core:Role, core:Principle, core:Obligation, core:State,
                               core:Resource, core:Action, core:Event, core:Capability,
                               core:Constraint))
                FILTER(STR(?c1) < STR(?c2))
            }
        """ ;
    ] .

# RULE 2: belt-and-suspenders -- no individual may be inferred as owl:Nothing (a hard
# clash some OWL-RL engines materialize directly).
pcsh:NoOwlNothingShape
    a sh:NodeShape ;
    sh:targetClass owl:NamedIndividual ;
    rdfs:label "No individual typed owl:Nothing"@en ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Individual is inferred to be owl:Nothing (an unsatisfiable / hard clash)." ;
        sh:severity sh:Violation ;
        sh:prefixes pcsh: ;
        sh:select """
            SELECT $this
            WHERE { $this rdf:type owl:Nothing . }
        """ ;
    ] .

# RoleDefinitionShape: the UNIVERSAL definitional schema of any role TYPE (the R component's
# class-level attributes that every role has, professional or not). Trimmed 2026-06-26: the
# professional-role-specific definitional attrs (scope, qualifications, virtues) moved to
# ProfessionalRoleDefinitionShape, and the bearer data moved to ProfessionalRolePropertyShape, because a
# participant role (e.g. an affected citizen) has none of those. Retargeted 2026-06-28 (R-spec migration):
# the second universal field is role_kind (the occupational professional/participant backstop), not the
# retired proeth:roleCategory literal; the relational role_category vocabulary now rides its own dedicated
# prompt slot (the four Kong categories), and the relational archetype is materialized edge-primary at
# commit (decision R1), so neither role_category nor role_kind is stored as a literal. Descriptive only
# (sh:path/sh:name/sh:description/sh:order); no validation. The extraction schema for a role is the UNION of
# the shapes along its class chain (hybrid: ontology owns the definition).
pcsh:RoleDefinitionShape
    a sh:NodeShape ;
    sh:targetClass core:Role ;
    rdfs:label "Role definition schema (universal, type-level, descriptive)"@en ;
    rdfs:comment "What any role type is individuated by, universal across professional and participant roles. The universal fields are its distinguishing features and its occupational kind (the professional/participant backstop). The relational audience-relationship category (role_category) has a dedicated prompt slot and is materialized at commit as the relational archetype classes (ProviderClientRole, ProfessionalPeerRole, EmployerRelationshipRole, PublicResponsibilityRole); professional-specific definitional attributes are on ProfessionalRoleDefinitionShape; bearer data on ProfessionalRolePropertyShape."@en ;
    sh:property [ sh:path core:distinguishingFeatures ; sh:name "distinguishing features" ; sh:description "What sets this role type apart from related roles (the distinctive ends/practices that individuate the role)." ; sh:order 1 ] ;
    sh:property [ sh:path proeth:roleKind ;             sh:name "role kind" ;               sh:description "The occupational kind of the role, an enum {professional, participant}. Drives the ProfessionalRole/ParticipantRole typing when the occupational resolver matches no head (the occupational backstop). Omitted when the case text does not state the judgment; absence is the third state. A routing input, not stored as a literal; for a matched existing class the axis is carried by the class chain (a descendant of ProfessionalRole or ParticipantRole), so no per-individual literal is needed." ; sh:order 2 ] .

# ProfessionalRoleDefinitionShape: the PROFESSIONAL-role-specific definitional attrs (type-level), on top
# of the universal RoleDefinitionShape. These individuate a professional role (Engineer, Architect, ...),
# not a participant role: professional scope, the qualifications the type requires, and the virtues of the
# profession. Targets proeth:ProfessionalRole so participant roles do not offer them. Trimmed 2026-06-28
# (R-spec migration): the generated-obligations / adhered-principles fields were dropped from the extraction
# contract because the R->P->O hasObligation/adheresToPrinciple edges are produced by the dedicated R->P->O
# pass, not asked of the roles prompt (the cross-component lists are routing inputs, not stored on the role).
pcsh:ProfessionalRoleDefinitionShape
    a sh:NodeShape ;
    sh:targetClass proeth:ProfessionalRole ;
    rdfs:label "Professional-role definition schema (type-level, descriptive)"@en ;
    rdfs:comment "Professional-role-specific definitional attributes, layered on the universal RoleDefinitionShape. A participant role (e.g. an affected citizen) carries none of these. The R->P->O hasObligation/adheresToPrinciple edges are materialized by the dedicated R->P->O pass, not asked of the roles prompt. The per-individual ethical-tensions field of the dissertation schema is likewise not asked of the roles prompt; obligation tensions are materialized between the obligations themselves as the defeasibility edge family (competesWith, prevailsOver, defeasibleUnder) by the dedicated defeasibility pass."@en ;
    sh:property [ sh:path core:professionalScope ;     sh:name "professional scope" ;      sh:description "Areas of responsibility and authority of the role type (Oakley and Cocking 2001)." ; sh:order 1 ] ;
    sh:property [ sh:path core:typicalQualifications ; sh:name "typical qualifications" ;  sh:description "Generic credentials the role type requires (a descriptor of the type, not an individual's license)." ; sh:order 2 ] ;
    sh:property [ sh:path core:associatedVirtues ;     sh:name "associated virtues" ;      sh:description "Virtues and dispositions characteristic of the professional role type (Kong et al. 2020 identity virtues; Oakley and Cocking 2001)." ; sh:order 3 ] .

# RolePropertyShape: the controlled property SCHEMA for professional roles -- a
# machine-visible declaration of which attributes a well-formed role-bearing individual
# MAY carry. PURELY DESCRIPTIVE: each sh:property carries only sh:path + sh:name +
# sh:description (no sh:minCount, no sh:datatype), so it produces NO validation result and
# cannot change conformance; it makes the "intended on Role" association -- previously only
# in an rdfs:comment on each datatype property -- machine-readable for tooling and UI.
#
# Why this is in SHACL and NOT as rdfs:domain on the properties: rdfs:domain is an OWL
# INFERENCE axiom (W3C OWL 2 Primer: a domain statement "is not a constraint... but allows
# a reasoner to infer further knowledge"), so "hasLicense rdfs:domain Role" would infer any
# value-holder INTO Role; under the nine-way owl:AllDisjointClasses (conformance runs at
# inference='owlrl', materialising prp-dom) a leaked attribute could then clash into an
# inconsistency. The role attributes are therefore deliberately domain-less ("leak-safe");
# this shape carries the class association safely. Turn any attribute into a real
# closed-world constraint later by adding sh:minCount / sh:datatype / sh:in here (the
# controlled-property-vocabulary work item) -- the values are still asserted on the individual.
#
# Retargeted 2026-07-02 (shapes reconciliation): sh:path now names the predicates the ProEthica
# commit serializer actually emits for the named bearer fields (the generic camelCase proeth:*
# loop over RoleIndividual license/specialty/employer): proeth:license / proeth:specialty /
# proeth:employer, previously proeth:hasLicense / proeth:hasSpecialty / proeth:hasEmployer.
# Both fresh-slate case-7 reference runs carry only the camelCase field forms; the has* datatype
# properties remain declared in proethica-intermediate.ttl and reachable via the serializer's
# overflow-bag synonym map (_ATTRIBUTE_VOCAB), so legacy data (e.g. case-103 proeth:hasLicense)
# still parses. sh:name/sh:description/sh:order unchanged: the {{ role_schema }} prompt text and
# the entity-page grouping wording render from sh:name, not sh:path.
pcsh:ProfessionalRolePropertyShape
    a sh:NodeShape ;
    sh:targetClass proeth:ProfessionalRole ;
    rdfs:label "Professional-role-bearer attributes (individual data, non-definitional)"@en ;
    rdfs:comment "Per-occupant data a PROFESSIONAL role-bearing INDIVIDUAL may have (license, specialty, employer, technical background). Descriptive only; these do NOT define the role type (cf. Davis 1991: license is not role-defining). Retargeted 2026-06-26 from core:Role to proeth:ProfessionalRole: a participant/stakeholder role (an affected citizen) has none of these; the universal role schema is RoleDefinitionShape. Values are asserted on the individual. Tightened 2026-06-25: dropped roleNature/roleClass (extraction provenance, not bearer data; reclassify to PROV-O) and jurisdiction/registrationStatus/roleInOrganization (weak controlled-vocab; captured via otherAttribute overflow when actually present)."@en ;
    sh:property [ sh:path proeth:license ;             sh:name "license" ;              sh:description "Professional license or licensure status." ;              sh:order 1 ] ;
    sh:property [ sh:path proeth:specialty ;           sh:name "specialty" ;            sh:description "Area of specialization." ;                                sh:order 2 ] ;
    sh:property [ sh:path proeth:experienceLevel ;     sh:name "experience level" ;     sh:description "Level of professional experience (e.g., years in practice)." ; sh:order 3 ] ;
    sh:property [ sh:path proeth:employer ;            sh:name "employer" ;             sh:description "Employer or organizational affiliation." ;                sh:order 4 ] ;
    sh:property [ sh:path proeth:technicalBackground ; sh:name "technical background" ; sh:description "Technical training and domain background of the individual." ; sh:order 5 ] ;
    sh:property [ sh:path proeth:otherAttribute ;      sh:name "other attribute" ;      sh:description "Overflow 'key: value' literal for a case-specific attribute outside the controlled set." ; sh:order 6 ] .

# ObligationDefinitionShape / ObligationPropertyShape: the O-component field contract, read by the
# {{ obligation_schema }} prompt block and rendered on the Obligation entity page. Split on the Role/Principle
# template: DefinitionShape = what individuates the obligation TYPE (its NSPE category), PropertyShape = the
# per-case fields a given obligation individual carries. Descriptive only -- each sh:property carries sh:path +
# sh:name + sh:description (no sh:minCount/sh:datatype), so no validation result and no conformance change.
# obligation_type drives the subClassOf core:Obligation typing (a routing input, not stored as a literal;
# Donohue 2017 directive information entity); obligated_party and derived_from_principle resolve to edges; the
# rest are per-individual literals.
pcsh:ObligationDefinitionShape
    a sh:NodeShape ;
    sh:targetClass core:Obligation ;
    rdfs:label "Obligation definition schema (type-level, descriptive, field contract)"@en ;
    rdfs:comment "What individuates an obligation TYPE: its controlled NSPE category, which drives the subClassOf core:Obligation typing. The concrete duty statement, the derivedFromPrinciple/obligatedParty edges, and the temporal-scope/compliance-status literals are per-individual and now live on ObligationPropertyShape, mirroring the Role/Principle Definition/Property split. Descriptive only (no validation result); obligation_type is a routing input, not stored as a literal."@en ;
    sh:property [ sh:path proeth:obligationType ;      sh:name "obligation type" ;        sh:description "The controlled NSPE obligation category, which drives the subClassOf core:Obligation typing: disclosure, safety, competence, confidentiality, reporting, collegial, attribution, legal, ethical." ; sh:order 1 ] .

# ObligationPropertyShape: the per-case fields a given obligation INDIVIDUAL carries (the O-side analogue of
# ProfessionalRolePropertyShape / PrinciplePropertyShape). The concrete duty statement, temporal scope and
# compliance status are per-individual literals; derivedFromPrinciple (O->P) and obligatedParty (O->Agent)
# resolve to edges. Read by the {{ obligation_schema }} prompt as the per-case section and rendered as the
# Obligation entity page's Bearer Attributes. Descriptive only (no sh:minCount/sh:datatype).
pcsh:ObligationPropertyShape
    a sh:NodeShape ;
    sh:targetClass core:Obligation ;
    rdfs:label "Obligation per-case schema (individual data, non-definitional)"@en ;
    rdfs:comment "What a given obligation INDIVIDUAL is described by in a specific case: the concrete duty it states, the principle it derives from and the party who bears it (both edges), and its temporal scope and compliance status. These do NOT individuate the obligation TYPE (that is ObligationDefinitionShape); their values are per-case, asserted on the individual. Descriptive only."@en ;
    sh:property [ sh:path proeth:obligationStatement ; sh:name "obligation statement" ;   sh:description "The concrete duty the obligation states (the operative 'shall' clause)." ; sh:order 1 ] ;
    sh:property [ sh:path core:derivedFromPrinciple ;  sh:name "derived from principle" ; sh:description "The principle the obligation derives from, via the O->P derivedFromPrinciple edge (the P side of R->P->O). Range: Principle." ; sh:order 2 ] ;
    sh:property [ sh:path core:obligatedParty ;        sh:name "obligated party" ;        sh:description "The agent who bears the obligation, via the obligatedParty edge. Range: Agent." ; sh:order 3 ] ;
    sh:property [ sh:path proeth:temporalScope ;       sh:name "temporal scope" ;         sh:description "When the obligation is in force (the period or condition of applicability)." ; sh:order 4 ] ;
    sh:property [ sh:path proeth:complianceStatus ;    sh:name "compliance status" ;      sh:description "Whether the obligation was met in the case: met, unmet, partial, or unclear." ; sh:order 5 ] .


# PrincipleDefinitionShape: the definitional field contract of any principle TYPE/individual (the P
# component), read by the {{ principle_schema }} prompt block. Descriptive only -- each sh:property carries
# sh:path + sh:name + sh:description + sh:order (no sh:minCount/sh:datatype), so it produces no validation
# result and cannot change conformance. principle_category drives the subClassOf typing into the four kinds
# and the canonical leaf becomes the rdf:type; the five narrative fields are per-individual literals the
# defeasibility extractor consumes; invokedBy resolves to a P->Agent edge.
pcsh:PrincipleDefinitionShape
    a sh:NodeShape ;
    sh:targetClass core:Principle ;
    rdfs:label "Principle definition schema (type-level, descriptive, field contract)"@en ;
    rdfs:comment "What individuates a principle TYPE: its canonical kind (drives the four-kind subClassOf typing; the canonical leaf becomes the rdf:type) and the extensional cases that ground it (McLaren). The five per-case narrative literals and the invokedBy edge are per-individual and now live on PrinciplePropertyShape, mirroring the RoleDefinitionShape/ProfessionalRolePropertyShape split so the {{ principle_schema }} prompt separates the type judgment from what the case supplies. Descriptive only (no validation result); principle_category is a routing input, not stored as a literal."@en ;
    sh:property [ sh:path proeth:principleCategory ;  sh:name "principle kind" ;      sh:description "The controlled principle kind, which drives the four-kind subClassOf typing: FundamentalEthicalPrinciple, ProfessionalVirtuePrinciple, RelationalPrinciple, DomainSpecificPrinciple. The canonical leaf label becomes the rdf:type; the category is a routing input, not stored as a literal." ; sh:order 1 ] ;
    sh:property [ sh:path proeth:extensionalCases ;   sh:name "extensional cases" ;   sh:description "Class-level prior cases that instantiate the principle (McLaren extensional grounding); an optional class-mint field." ; sh:order 2 ] .

# PrinciplePropertyShape: the per-case fields a principle INDIVIDUAL carries in a given case -- the P-side
# analogue of ProfessionalRolePropertyShape. The five narrative literals are the defeasibility-pipeline source
# fields; invokedBy resolves to the P->Agent edge. Read by the {{ principle_schema }} prompt as the per-case
# section and rendered as the Principle entity page's Bearer Attributes. Descriptive only (no sh:minCount/
# sh:datatype), so it produces no validation result; values are asserted on the individual, not the class.
pcsh:PrinciplePropertyShape
    a sh:NodeShape ;
    sh:targetClass core:Principle ;
    rdfs:label "Principle per-case schema (individual data, non-definitional)"@en ;
    rdfs:comment "What a principle INDIVIDUAL is described by in a specific case: the five narrative literals the defeasibility pipeline consumes and the agent that invokes it. These do NOT individuate the principle TYPE (that is PrincipleDefinitionShape); their values are per-case, asserted on the individual. Descriptive only."@en ;
    sh:property [ sh:path proeth:interpretation ;     sh:name "interpretation" ;      sh:description "Per-case reading of what the principle requires in this situation (a defeasibility-pipeline source field)." ; sh:order 1 ] ;
    sh:property [ sh:path proeth:concreteExpression ; sh:name "concrete expression" ; sh:description "How the principle is concretely expressed in the case (a defeasibility-pipeline source field)." ; sh:order 2 ] ;
    sh:property [ sh:path proeth:appliedTo ;          sh:name "applied to" ;          sh:description "What the principle is applied to in the case (the situation or party it bears on)." ; sh:order 3 ] ;
    sh:property [ sh:path proeth:balancingWith ;      sh:name "balancing with" ;      sh:description "The competing principle or value this principle is balanced against in the case, recorded as a literal; extraction records the tension but asserts no defeat or precedence, and the defeasibility edges are materialized by a separate pass from this field." ; sh:order 4 ] ;
    sh:property [ sh:path proeth:tensionResolution ;  sh:name "tension resolution" ;  sh:description "How the case resolves the tension involving this principle (a defeasibility-pipeline source field)." ; sh:order 5 ] ;
    sh:property [ sh:path core:invokedBy ;            sh:name "invoked by" ;          sh:description "The agent who invokes the principle, via the P->Agent invokedBy edge (resolved to the case Agent or the shared NSPE Board/NSPE Agent). Range: Agent." ; sh:order 6 ] .

# StateDefinitionShape: the definitional field contract of any state TYPE/individual (the S component), read
# by the {{ state_schema }} prompt block. Descriptive only (no validation result). The archetype is one of
# the closed nine CONTENT archetypes; it is a classification of the state content, explicitly NOT the
# activatesObligation relation (a RiskState is a condition of hazard exposure in the world, not recoverable
# from any edge). The edge layer separately records which obligation the state activates or defeats.
pcsh:StateDefinitionShape
    a sh:NodeShape ;
    sh:targetClass core:State ;
    rdfs:label "State definition schema (type-level, descriptive, field contract)"@en ;
    rdfs:comment "What individuates a state TYPE: its content archetype (drives the archetype subClassOf typing) and its persistence type (inertial vs non-inertial fluent, a class-level datatype). Its per-case urgency and the activatesObligation edge are per-individual and live on StatePropertyShape, mirroring the Role/Principle/Obligation Definition/Property split and the state scopeNote (which names the condition and its persistence type as type-defining). Descriptive only (no validation result); state_category is a routing input, not stored as a literal."@en ;
    sh:property [ sh:path proeth:stateCategory ;     sh:name "state archetype" ;      sh:description "The content archetype, which drives the archetype subClassOf typing: EpistemicState, RiskState, CompetenceState, EmergencyState, ConflictOfInterestState, RegulatoryState, TemporalState, ResourceState, DisclosureState. A classification of the state content, explicitly NOT the activatesObligation relation. A routing input, not stored as a literal." ; sh:order 1 ] ;
    sh:property [ sh:path proeth:persistenceType ;   sh:name "persistence type" ;     sh:description "Whether the state is an inertial fluent (holds until an event terminates it) or a non-inertial fluent (true at a single time point), per Berreby's Event Calculus; a class-level datatype, a property of the fluent predicate itself." ; sh:order 2 ] .

# StatePropertyShape: the per-case fields a state INDIVIDUAL carries in a given case (the S-side analogue of
# ProfessionalRolePropertyShape / PrinciplePropertyShape / ObligationPropertyShape). urgencyLevel is a per-
# individual literal (Jones salience); activatesObligation resolves to the outgoing S->O edge. Targets
# core:State, NOT a narrower archetype: unlike Role (whose bearer data is professional-only), every state
# archetype carries urgency and can activate obligations. Read by the {{ state_schema }} prompt as the per-case
# section and rendered as the State entity page's Bearer Attributes. Descriptive only (no sh:minCount/sh:datatype).
pcsh:StatePropertyShape
    a sh:NodeShape ;
    sh:targetClass core:State ;
    rdfs:label "State per-case schema (individual data, non-definitional)"@en ;
    rdfs:comment "What a given state INDIVIDUAL is described by in a specific case: its urgency (per-case salience) and the obligation it activates (an edge). These do NOT individuate the state TYPE (that is StateDefinitionShape); their values are per-case, asserted on the individual. Descriptive only."@en ;
    sh:property [ sh:path proeth:urgencyLevel ;      sh:name "urgency level" ;        sh:description "The salience or acuteness of the state in this case (Jones moral-intensity salience: imminence, magnitude, proximity)." ; sh:order 1 ] ;
    sh:property [ sh:path core:activatesObligation ; sh:name "activates obligation" ; sh:description "The obligation the state makes applicable, via the outgoing S->O activatesObligation edge; the incoming counterpart is defeasibleUnder (O->S), recording the obligation the state defeats. Range: Obligation." ; sh:order 2 ] .

# ResourceDefinitionShape: the definitional field contract of any resource TYPE/individual (the Rs
# component), read by the {{ resource_schema }} prompt block. Descriptive only (no validation result).
# Canonical identity is the source kind; topic, who-used, and which-document are context, not class identity.
# topic is carried on a declared first-class datatype property, not on the otherAttribute overflow string.
pcsh:ResourceDefinitionShape
    a sh:NodeShape ;
    sh:targetClass core:Resource ;
    rdfs:label "Resource definition schema (type-level, descriptive, field contract)"@en ;
    rdfs:comment "What individuates a resource TYPE: its source kind (the category of professional knowledge, which drives the five-kind subClassOf typing) and the class-level governedByCode restriction for code resources. The specific document title, its topic, and the relying/citing agents are per-individual context and live on ResourcePropertyShape, mirroring the R/P/O/S Definition/Property split and the resource scopeNote (the TYPE is a bare category; a specific named or numbered document is an INDIVIDUAL, and 'topic, who-used, and which-document are context, not class identity'). Descriptive only (no validation result); source_kind is a routing input, not stored as a literal."@en ;
    sh:property [ sh:path proeth:sourceKind ;     sh:name "source kind" ;      sh:description "The controlled source kind, which drives the five-kind typing: ethical_code, technical_standard, case_precedent, legal_resource, reference_material (professional_code was merged into ethical_code 2026-07-01). EthicalCode is typed subClassOf Guideline subClassOf Resource; the other four subClassOf Resource. A routing input, not stored as a literal." ; sh:order 1 ] ;
    sh:property [ sh:path proeth:governedByCode ; sh:name "governed by code" ; sh:description "For a code resource, the incoming governedByCode relation from ProfessionalRole (a TBox restriction, range EthicalCode); relevant only to EthicalCode resources." ; pcsh:informationalOnly true ; sh:order 2 ] .

# ResourcePropertyShape: the per-case fields a given resource INDIVIDUAL carries (the Rs-side analogue of the
# other components' PropertyShapes). documentTitle names the specific document (which the scopeNote makes an
# INDIVIDUAL); topic, availableTo, and citedByAgent are the per-case context the DefinitionShape's own comment
# calls "context, not class identity". Targets core:Resource. Read by {{ resource_schema }} as the per-case
# section and rendered as the Resource entity page's Bearer Attributes. Descriptive only (no sh:minCount/sh:datatype).
pcsh:ResourcePropertyShape
    a sh:NodeShape ;
    sh:targetClass core:Resource ;
    rdfs:label "Resource per-case schema (individual data, non-definitional)"@en ;
    rdfs:comment "What a given resource INDIVIDUAL is described by in a specific case: the specific document it is (its title), the subject it addresses, and the agents who relied on or cited it. These do NOT individuate the resource TYPE (that is ResourceDefinitionShape, keyed on source kind); their values are per-case, asserted on the individual. Descriptive only."@en ;
    sh:property [ sh:path proeth:documentTitle ;  sh:name "document title" ;   sh:description "The title of the specific source document (the separately-citable INDIVIDUAL the scopeNote names)." ; sh:order 1 ] ;
    sh:property [ sh:path proeth:topic ;          sh:name "topic" ;            sh:description "The subject the resource addresses, carried on the first-class proeth:topic datatype property (decision B2), not the otherAttribute overflow; context, not class identity." ; sh:order 2 ] ;
    sh:property [ sh:path core:availableTo ;      sh:name "available to" ;     sh:description "The case actor who relied on the resource (the Facts-section signal), via the availableTo edge. Range: Agent." ; sh:order 3 ] ;
    sh:property [ sh:path core:citedByAgent ;     sh:name "cited by agent" ;   sh:description "The agent who cited the resource as authority (the Discussion-section signal), via the citedByAgent edge, resolved to the shared NSPE Board/NSPE Agent when the text names it. Range: Agent." ; sh:order 4 ] .

# CapabilityDefinitionShape: the definitional field contract of any capability TYPE/individual (the Ca
# component), read by the {{ capability_schema }} prompt block. Descriptive only (no validation result).
# Only a competence the agent POSSESSES or exercises is a Capability; a lacked or unexercised competence is
# dropped and routed to the temp_rdf carrier for the commit-stage CompetenceGapState, not typed here.
pcsh:CapabilityDefinitionShape
    a sh:NodeShape ;
    sh:targetClass core:Capability ;
    rdfs:label "Capability definition schema (type-level, descriptive, field contract)"@en ;
    rdfs:comment "What individuates a capability TYPE: its canonical competence kind (drives the subClassOf typing) and the Tolmeijer requirement the kind realizes (a class-level annotation). The possessor and the incoming requiresCapability edge are per-case and live on CapabilityPropertyShape, mirroring the R/P/O/S/Rs Definition/Property split and the capability scopeNote (the type is 'the competence it is'; the bearer and the requiredForObligation edges attach to the case individual). Descriptive only (no validation result); capability_kind is a routing input, not stored as a literal."@en ;
    sh:property [ sh:path proeth:capabilityKind ;       sh:name "capability kind" ;        sh:description "The canonical, tool/actor-neutral competence kind, which drives the subClassOf typing to one of the named capability classes (each subClassOf core:Capability with skos:altLabel synonyms). A routing input, not stored as a literal." ; sh:order 1 ] ;
    sh:property [ sh:path proeth:tolmeijerRequirement ; sh:name "Tolmeijer requirement" ;  sh:description "Class-level descriptive annotation naming which of the four Tolmeijer (2021) ethical-competence requirements the kind primarily realizes; descriptive only, with no per-individual field and no second typing axiom." ; sh:order 2 ] .

# CapabilityPropertyShape: the per-case fields a given capability INDIVIDUAL carries (the Ca-side analogue of
# the other components' PropertyShapes). possessedBy resolves to the bearer edge (the agent who possesses or
# exercises the competence in this case); requiresCapability is the incoming Obligation->Capability edge (each
# obligation that presupposes this capacity, per obligation-presupposes-capacity). The scopeNote assigns both
# the bearer and the requiredForObligation edges to the case individual, not the class. Targets core:Capability.
# Read by {{ capability_schema }} as the per-case section and rendered as the entity page's Bearer Attributes.
pcsh:CapabilityPropertyShape
    a sh:NodeShape ;
    sh:targetClass core:Capability ;
    rdfs:label "Capability per-case schema (individual data, non-definitional)"@en ;
    rdfs:comment "What a given capability INDIVIDUAL is described by in a specific case: the agent who possesses or exercises it, and the obligations that presuppose it. These do NOT individuate the capability TYPE (that is CapabilityDefinitionShape, keyed on capability kind); their values are per-case, asserted on the individual. Descriptive only."@en ;
    sh:property [ sh:path core:possessedBy ;            sh:name "possessed by" ;           sh:description "The agent who possesses or exercises the capability, via the possessedBy edge. Range: Agent." ; sh:order 1 ] ;
    sh:property [ sh:path core:requiresCapability ;     sh:name "required by obligation" ; sh:description "The incoming Obligation->Capability requiresCapability edge: each obligation that presupposes this capacity (re-domained to Obligation->Capability and promoted to core). Domain: Obligation." ; sh:order 2 ] .

# ConstraintDefinitionShape / ConstraintPropertyShape: the Cs-component field contract, read by the
# {{ constraint_schema }} prompt block and mirroring the R/P/O/S/Rs/Ca Definition/Property split. A
# constraint is a PROHIBITION or boundary, not a positive duty; a 'was required to' statement is an
# Obligation and is redirected to the O pass. DefinitionShape = what individuates the constraint TYPE (the
# boundary it states and its source provision, per the core scopeNote); PropertyShape = the per-case
# severity, applicability, and the constrained party/action a given constraint INDIVIDUAL carries.
pcsh:ConstraintDefinitionShape
    a sh:NodeShape ;
    sh:targetClass core:Constraint ;
    rdfs:label "Constraint definition schema (type-level, descriptive, field contract)"@en ;
    rdfs:comment "What individuates a constraint TYPE: the boundary it states (boundary_type, which drives the subClassOf typing into one of the eleven closed boundary-type classes) and the source provision that establishes it. The per-case severity and applicability, the agent it limits, and the action it bounds are per-individual and live on ConstraintPropertyShape, mirroring the R/P/O/S/Rs/Ca Definition/Property split and the constraint scopeNote (the TYPE is the prohibition plus its source provision; the constrained party, per-occasion applicability, and any exception attach to the case individual). Descriptive only (no validation result); boundary_type is a routing input, not stored as a literal."@en ;
    sh:property [ sh:path proeth:boundaryType ; sh:name "boundary type" ; sh:description "The controlled boundary type, which drives the subClassOf typing into one of the ten closed boundary-type classes: LegalConstraint, RegulatoryConstraint, ResourceConstraint, CompetenceConstraint, JurisdictionalConstraint, ProceduralConstraint, EthicalConstraint, SafetyConstraint, ConfidentialityConstraint, TemporalConstraint. The prohibition/boundary content that individuates the type. A routing input, not stored as a literal." ; sh:order 1 ] ;
    sh:property [ sh:path core:establishedBy ; sh:name "established by" ; sh:description "The source CodeProvision that establishes the constraint, via the establishedBy edge. The second type-individuating coordinate: per the scopeNote a constraint TYPE is the boundary it states plus its source provision. Range: CodeProvision." ; pcsh:informationalOnly true ; sh:order 2 ] .

# ConstraintPropertyShape: the per-case fields a given constraint INDIVIDUAL carries (the Cs-side analogue of
# the other components' PropertyShapes). severity is the per-occasion Dennis severity assessment;
# applicabilityCondition is the per-case temporal/contextual window under which the prohibition applies;
# constrainedEntity is the particular Agent bound. (A constrainedBy row promising the incoming
# Action->Constraint edge was removed 2026-07-05: no pass produces that edge, so the schema
# advertised a field that never appears; the core property remains declared vocabulary.) Targets
# core:Constraint. Read by {{ constraint_schema }} as the per-case section and rendered as Bearer Attributes.
pcsh:ConstraintPropertyShape
    a sh:NodeShape ;
    sh:targetClass core:Constraint ;
    rdfs:label "Constraint per-case schema (individual data, non-definitional)"@en ;
    rdfs:comment "What a given constraint INDIVIDUAL is described by in a specific case: its per-occasion severity and applicability window, the agent whose conduct it limits, and the action it bounds. These do NOT individuate the constraint TYPE (that is ConstraintDefinitionShape, keyed on the boundary it states and its source provision); their values are per-case, asserted on the individual. Descriptive only."@en ;
    sh:property [ sh:path proeth:severity ; sh:name "severity" ; sh:description "The severity of the constraint in this case (critical, high, medium, low); a per-occasion assessment (Dennis severity ordering) that can differ across cases sharing the same boundary." ; sh:order 1 ] ;
    sh:property [ sh:path proeth:applicabilityCondition ; sh:name "applicability condition" ; sh:description "The temporal and contextual circumstances under which the prohibition applies in this case (the Dennis complete-specification condition)." ; sh:order 2 ] ;
    sh:property [ sh:path core:constrainedEntity ; sh:name "constrained entity" ; sh:description "The agent whose conduct the constraint limits, via the outgoing constrainedEntity edge. Range: Agent." ; sh:order 3 ] .

# EventDefinitionShape: the LIGHT field contract of any event TYPE/individual (the E component). Descriptive
# only (no validation result). event_origin drives the three-way origin subClassOf typing into the mutually
# disjoint origin subclasses already in core; the fluent edges record the States the event transitions. Kept
# deliberately light per the specification.
pcsh:EventDefinitionShape
    a sh:NodeShape ;
    sh:targetClass core:Event ;
    rdfs:label "Event definition schema (light, descriptive, field contract)"@en ;
    rdfs:comment "The light field contract of an event: its origin, the state fluents it initiates or terminates, and its persistence. Descriptive only (no validation result); event_origin drives the three-way origin subClassOf typing and is not stored as a literal. Kept deliberately light per the specification."@en ;
    sh:property [ sh:path proeth:eventType ;     sh:name "event type" ;     sh:description "The origin of the event, which drives the three-way subClassOf typing into the mutually disjoint origin subclasses: outcome maps to AgentCausedEvent, exogenous to ExogenousEvent, automatic to AutomaticEvent (Berreby/Sarmiento origin distinction). A routing input, not stored as a literal." ; sh:order 1 ] ;
    sh:property [ sh:path core:initiates ;         sh:name "initiates" ;        sh:description "The State (fluent) the event initiates, via the initiates edge (Event->State). Range: State." ; sh:order 2 ] ;
    sh:property [ sh:path core:terminates ;        sh:name "terminates" ;       sh:description "The State (fluent) the event terminates, via the terminates edge (Event->State). Range: State." ; sh:order 3 ] ;
    sh:property [ sh:path proeth:temporalMarker ; sh:name "temporal marker" ; sh:description "The event's temporal positioning in the case (when it occurs relative to the other actions and events)." ; sh:order 4 ] .
