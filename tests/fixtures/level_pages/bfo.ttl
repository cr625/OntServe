@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Test fixture: a one-class stand-in for the BFO row, which has no TTL file in ontologies/.

<http://purl.obolibrary.org/obo/bfo.owl> a owl:Ontology ;
    rdfs:label "BFO fixture" .

<http://purl.obolibrary.org/obo/BFO_0000001> a owl:Class ;
    rdfs:label "entity" .
