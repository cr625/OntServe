<?xml version="1.0"?>
<Ontology xmlns="http://www.w3.org/2002/07/owl#"
     xml:base="http://example.org/arm"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     ontologyIRI="http://example.org/arm">
    <Prefix name="" IRI="http://example.org/arm#"/>
    <Prefix name="rdfs" IRI="http://www.w3.org/2000/01/rdf-schema#"/>
    <Declaration>
        <Class IRI="#Arm"/>
    </Declaration>
    <Declaration>
        <Class IRI="#Joint"/>
    </Declaration>
    <SubClassOf>
        <Class IRI="#Joint"/>
        <Class IRI="#Arm"/>
    </SubClassOf>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Arm</IRI>
        <Literal>Arm</Literal>
    </AnnotationAssertion>
</Ontology>
