<?xml version="1.0"?>
<rdf:RDF xmlns="http://example.org/sensor#"
     xml:base="http://example.org/sensor"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#">
    <owl:Ontology rdf:about="http://example.org/sensor"/>
    <owl:Class rdf:about="http://example.org/sensor#Sensor">
        <rdfs:label>Sensor</rdfs:label>
    </owl:Class>
</rdf:RDF>
